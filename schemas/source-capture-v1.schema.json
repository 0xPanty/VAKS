{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vaks:schema:source-capture:v1",
  "title": "VAKS Source Capture Envelope v1",
  "type": "object",
  "required": [
    "schema",
    "capture_id",
    "observed_at",
    "producer",
    "source",
    "observation",
    "snapshot",
    "change",
    "inspection_refs",
    "fidelity",
    "raw_handling"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "urn:vaks:schema:source-capture:v1"
    },
    "capture_id": {
      "$ref": "#/$defs/capture_id"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      }
    },
    "observation": {
      "type": "object",
      "required": [
        "state",
        "capture_method",
        "blob"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "captured",
            "partial",
            "failed"
          ]
        },
        "capture_method": {
          "enum": [
            "provider_archive",
            "git_clone",
            "api",
            "upload",
            "local_file",
            "archive_file"
          ]
        },
        "blob": {
          "$ref": "#/$defs/descriptor"
        },
        "content_type": {
          "$ref": "#/$defs/content_type"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "required": [
        "snapshot_id",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "snapshot_id": {
          "type": "string",
          "pattern": "^vsnap:1:(tree|blob):sha256:[0-9a-f]{64}$"
        },
        "kind": {
          "enum": [
            "tree",
            "blob"
          ]
        },
        "manifest": {
          "$ref": "#/$defs/descriptor"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "tree"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "manifest"
            ],
            "properties": {
              "snapshot_id": {
                "pattern": "^vsnap:1:tree:sha256:[0-9a-f]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "blob"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "required": [
                "manifest"
              ]
            },
            "properties": {
              "snapshot_id": {
                "pattern": "^vsnap:1:blob:sha256:[0-9a-f]{64}$"
              }
            }
          }
        }
      ]
    },
    "change": {
      "type": "object",
      "required": [
        "state",
        "compared_to_capture_id"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "first_seen",
            "same_snapshot",
            "new_snapshot",
            "unknown"
          ]
        },
        "compared_to_capture_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/capture_id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "first_seen"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "compared_to_capture_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "same_snapshot",
                  "new_snapshot"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "compared_to_capture_id": {
                "$ref": "#/$defs/capture_id"
              }
            }
          }
        }
      ]
    },
    "inspection_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/inspection_ref"
      }
    },
    "fidelity": {
      "type": "object",
      "required": [
        "state"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "matched",
            "mismatch",
            "partial",
            "not_checked"
          ]
        },
        "profile": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "compared_to": {
          "$ref": "#/$defs/comparison_subject"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "matched",
                  "mismatch",
                  "partial"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "profile",
              "compared_to"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "not_checked"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "profile"
                  ]
                },
                {
                  "required": [
                    "compared_to"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "raw_handling": {
      "type": "object",
      "required": [
        "disposition",
        "policy",
        "reason_codes"
      ],
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "enum": [
            "admitted",
            "quarantined",
            "rejected",
            "not_evaluated"
          ]
        },
        "policy": {
          "type": "object",
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "digest": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  },
  "$defs": {
    "capture_id": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "algorithm_digest": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]*:[0-9a-f]{40,128}$"
    },
    "descriptor": {
      "type": "object",
      "required": [
        "media_type",
        "size",
        "digest"
      ],
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "inspection_ref": {
      "type": "object",
      "required": [
        "media_type",
        "size",
        "digest",
        "predicate_type"
      ],
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "const": "application/vnd.in-toto+json"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "predicate_type": {
          "enum": [
            "urn:vaks:predicate:repo-snapshot-hygiene:v1",
            "urn:vaks:predicate:source-snapshot-hygiene:v1"
          ]
        }
      }
    },
    "selector": {
      "type": "object",
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "revision": {
      "type": "object",
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "git_commit",
            "git_tag",
            "git_ref",
            "version",
            "arxiv_version",
            "timestamp",
            "content_hash",
            "provider_revision",
            "doi_version",
            "web_capture_time"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "producer": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "implementation": {
          "$ref": "#/$defs/descriptor"
        }
      }
    },
    "content_type": {
      "type": "object",
      "required": [
        "profile",
        "detected_media_type",
        "detection_basis",
        "hint_match"
      ],
      "additionalProperties": false,
      "properties": {
        "profile": {
          "const": "vaks-media-type-detection/v1"
        },
        "detected_media_type": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "detection_basis": {
          "enum": [
            "container_parser",
            "magic_signature",
            "locator_hint",
            "fallback"
          ]
        },
        "locator_hint_media_type": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "hint_match": {
          "enum": [
            "matched",
            "mismatch",
            "no_hint",
            "not_comparable"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "source_id",
        "kind",
        "requested_locator"
      ],
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^vsrc:1:[A-Za-z0-9_.-]+:[^\\s\\x00-\\x1F\\x7F]+$"
        },
        "kind": {
          "enum": [
            "repo",
            "file",
            "archive",
            "pdf",
            "video",
            "web",
            "unknown"
          ]
        },
        "requested_locator": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1F\\x7F]+$"
        },
        "resolved_locator": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1F\\x7F]+$"
        }
      }
    },
    "comparison_subject": {
      "type": "object",
      "required": [
        "kind",
        "digest"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "digest": {
          "$ref": "#/$defs/algorithm_digest"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
