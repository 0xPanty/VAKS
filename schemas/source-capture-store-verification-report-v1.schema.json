{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vaks:schema:source-capture-store-verification-report:v1",
  "title": "VAKS Source Capture Store Verification Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "store",
    "assurance_scope",
    "summary",
    "captures",
    "findings"
  ],
  "properties": {
    "schema": {
      "const": "urn:vaks:schema:source-capture-store-verification-report:v1"
    },
    "profile": {
      "const": "source-capture-store-verification/v1"
    },
    "store": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layout",
        "layout_version",
        "instance_id"
      ],
      "properties": {
        "layout": {
          "const": "vaks-source-capture-store/v1"
        },
        "layout_version": {
          "const": "1"
        },
        "instance_id": {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      }
    },
    "assurance_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retention_and_fixity",
        "source_authenticity",
        "evidentiary_support",
        "review_status",
        "action_authorization",
        "repair_performed"
      ],
      "properties": {
        "retention_and_fixity": {
          "const": true
        },
        "source_authenticity": {
          "const": false
        },
        "evidentiary_support": {
          "const": false
        },
        "review_status": {
          "const": false
        },
        "action_authorization": {
          "const": false
        },
        "repair_performed": {
          "const": false
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "captures_total",
        "captures_verified",
        "warnings_count",
        "errors_count",
        "indeterminate_count"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "pass_with_warnings",
            "fail",
            "indeterminate"
          ]
        },
        "captures_total": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "captures_verified": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "warnings_count": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "errors_count": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "indeterminate_count": {
          "$ref": "#/$defs/nonnegativeInteger"
        }
      }
    },
    "captures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/captureResult"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonnegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))(?:[A-Za-z0-9._-]|%[0-9A-F]{2}|/)+$"
    },
    "captureResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "store_path",
        "status"
      ],
      "properties": {
        "capture_id": {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "store_path": {
          "$ref": "#/$defs/relativePath"
        },
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "bundle_digest": {
          "$ref": "#/$defs/sha256"
        },
        "raw_blob_retention_state": {
          "enum": [
            "retained",
            "not_retained"
          ]
        },
        "raw_blob_digest": {
          "$ref": "#/$defs/sha256"
        },
        "raw_blob_store_path": {
          "$ref": "#/$defs/relativePath"
        },
        "code": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "message"
      ],
      "properties": {
        "severity": {
          "enum": [
            "warning",
            "error",
            "indeterminate"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "details": {
          "type": "object"
        }
      }
    }
  }
}
