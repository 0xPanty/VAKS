filters:
  and:
    - file.inFolder("wiki/patterns")
    - file.ext == "md"
    - type == "pattern"
properties:
  file.name:
    displayName: Pattern
  status:
    displayName: Status
  adoption_status:
    displayName: Adoption status
  verification_status:
    displayName: Verification status
  evidence_level:
    displayName: Evidence level
  confidence:
    displayName: Confidence
  last_verified:
    displayName: Last verified
  next_review:
    displayName: Next review
  source_libraries:
    displayName: Source libraries
  evidence_count:
    displayName: Evidence count
  negative_evidence:
    displayName: Negative evidence
  replaces:
    displayName: Replaces
  superseded_by:
    displayName: Superseded by
  file.path:
    displayName: Path
views:
  - type: table
    name: All patterns
    order:
      - file.name
      - status
      - adoption_status
      - verification_status
      - evidence_level
      - confidence
      - last_verified
      - next_review
      - evidence_count
      - negative_evidence
      - source_libraries
      - file.path
    limit: 100
  - type: table
    name: Adoption focus
    filters:
      or:
        - adoption_status == "adopted"
        - adoption_status == "adopt"
    order:
      - file.name
      - status
      - adoption_status
      - confidence
      - verification_status
      - evidence_level
      - next_review
      - file.path
    limit: 100
  - type: table
    name: Candidate and draft
    filters:
      or:
        - status == "candidate"
        - status == "draft"
    order:
      - file.name
      - status
      - adoption_status
      - confidence
      - verification_status
      - evidence_level
      - next_review
      - source_libraries
      - file.path
    limit: 100
  - type: table
    name: Review due
    filters:
      and:
        - next_review <= today()
    order:
      - file.name
      - status
      - adoption_status
      - next_review
      - verification_status
      - evidence_level
      - confidence
      - file.path
    limit: 100
