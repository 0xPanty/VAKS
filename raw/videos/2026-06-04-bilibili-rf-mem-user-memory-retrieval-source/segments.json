[
  {
    "start": 0.0,
    "end": 2.4,
    "text": "今天接著聊長期記憶"
  },
  {
    "start": 2.4,
    "end": 4.8,
    "text": "上一次MAMGuess討論的是"
  },
  {
    "start": 4.8,
    "end": 7.96,
    "text": "記憶庫怎麼組織成多力度關聯圖"
  },
  {
    "start": 7.96,
    "end": 12.32,
    "text": "RFMAM問的是另一個更運行時的問題"
  },
  {
    "start": 12.32,
    "end": 13.8,
    "text": "每次用戶發問"
  },
  {
    "start": 13.8,
    "end": 15.96,
    "text": "Agent到底該秒查一下"
  },
  {
    "start": 15.96,
    "end": 17.28,
    "text": "還是應該多想幾輪"
  },
  {
    "start": 17.28,
    "end": 18.44,
    "text": "也就是說"
  },
  {
    "start": 18.44,
    "end": 20.28,
    "text": "它不是改記憶怎麼存"
  },
  {
    "start": 20.28,
    "end": 21.84,
    "text": "而是改記憶怎麼找"
  },
  {
    "start": 21.84,
    "end": 22.4,
    "text": "對"
  },
  {
    "start": 22.4,
    "end": 24.64,
    "text": "RFMAM的核心主張是"
  },
  {
    "start": 24.64,
    "end": 27.84,
    "text": "用戶記憶檢索不應該只有一次性TopK"
  },
  {
    "start": 27.92,
    "end": 29.84,
    "text": "熟悉的問題可以走快速"
  },
  {
    "start": 29.84,
    "end": 31.4,
    "text": "Familiarity 路徑"
  },
  {
    "start": 31.4,
    "end": 33.48,
    "text": "不熟悉或不確定的問題"
  },
  {
    "start": 33.48,
    "end": 34.84,
    "text": "才起動慢一點的"
  },
  {
    "start": 34.84,
    "end": 36.04,
    "text": "Recollection 路徑"
  },
  {
    "start": 36.04,
    "end": 38.32,
    "text": "在嵌入空間裡逐步重構證據"
  },
  {
    "start": 38.32,
    "end": 40.36,
    "text": "最變論文的正式信息是什麼"
  },
  {
    "start": 40.36,
    "end": 41.68,
    "text": "論文標題是"
  },
  {
    "start": 41.68,
    "end": 43.56,
    "text": "Evoking User Memory"
  },
  {
    "start": 43.56,
    "end": 44.8,
    "text": "Personalizing"
  },
  {
    "start": 44.8,
    "end": 46.0,
    "text": "LLM"
  },
  {
    "start": 46.0,
    "end": 49.88,
    "text": "VIA Recollection Familiarity Adaptive Retrieval"
  },
  {
    "start": 49.88,
    "end": 52.68,
    "text": "ICLR 2026 Poster"
  },
  {
    "start": 52.68,
    "end": 55.08,
    "text": "作者來自大連理工大學"
  },
  {
    "start": 55.08,
    "end": 56.56,
    "text": "香港城市大學"
  },
  {
    "start": 56.56,
    "end": 59.24,
    "text": "華為和中國科學技術大學"
  },
  {
    "start": 59.24,
    "end": 62.36,
    "text": "RFMAM在論文裡的全稱是"
  },
  {
    "start": 62.36,
    "end": 65.36,
    "text": "Recollection Familiarity Memory Retrieval"
  },
  {
    "start": 65.36,
    "end": 68.0,
    "text": "它為什麼要從認知科學界概念"
  },
  {
    "start": 68.0,
    "end": 69.2,
    "text": "論文界的是"
  },
  {
    "start": 69.2,
    "end": 72.48,
    "text": "Recollection Familiarity雙加工理論"
  },
  {
    "start": 72.48,
    "end": 75.08,
    "text": "Familiarity是快速的熟悉感"
  },
  {
    "start": 75.08,
    "end": 77.64,
    "text": "像你看到一張臉立刻覺得認識"
  },
  {
    "start": 77.64,
    "end": 80.2,
    "text": "Recollection是更慢的情境回憶"
  },
  {
    "start": 80.2,
    "end": 82.96,
    "text": "會把時間 地點 來源和相關片段"
  },
  {
    "start": 82.96,
    "end": 84.4,
    "text": "重新拼起來"
  },
  {
    "start": 84.4,
    "end": 86.16,
    "text": "RFMAM把這兩種模式"
  },
  {
    "start": 86.16,
    "end": 87.4,
    "text": "映射到解鎖器裡"
  },
  {
    "start": 87.4,
    "end": 89.44,
    "text": "傳統相量解鎖對應哪一種"
  },
  {
    "start": 89.44,
    "end": 91.2,
    "text": "傳統一次性相似度"
  },
  {
    "start": 91.2,
    "end": 93.96,
    "text": "Top-K基本對應Familiarity"
  },
  {
    "start": 93.96,
    "end": 97.28,
    "text": "快 便宜 但容易只抓表層相似"
  },
  {
    "start": 97.28,
    "end": 99.2,
    "text": "比如問題裡有醫療決策"
  },
  {
    "start": 99.2,
    "end": 101.0,
    "text": "解鎖可能命中幾條"
  },
  {
    "start": 101.0,
    "end": 103.08,
    "text": "看起來健康相關的碎片"
  },
  {
    "start": 103.08,
    "end": 105.16,
    "text": "卻漏掉用戶長期強調的"
  },
  {
    "start": 105.16,
    "end": 107.88,
    "text": "偏好詢證 常規醫學和安全性"
  },
  {
    "start": 107.88,
    "end": 109.32,
    "text": "這些更完整的背景"
  },
  {
    "start": 109.32,
    "end": 110.72,
    "text": "那它的第一步是什麼"
  },
  {
    "start": 110.72,
    "end": 112.92,
    "text": "第一步叫Prob Retrieval"
  },
  {
    "start": 112.92,
    "end": 114.56,
    "text": "也就是探針解鎖"
  },
  {
    "start": 114.56,
    "end": 116.04,
    "text": "系統先用原始問題"
  },
  {
    "start": 116.04,
    "end": 117.52,
    "text": "做一次快速解鎖"
  },
  {
    "start": 117.52,
    "end": 119.96,
    "text": "拿到候選記憶和相似度分數"
  },
  {
    "start": 119.96,
    "end": 121.48,
    "text": "然後計算兩個信號"
  },
  {
    "start": 121.48,
    "end": 124.12,
    "text": "平均相似度表示整體有多項"
  },
  {
    "start": 124.12,
    "end": 126.68,
    "text": "分布商表示候選結果是否集中"
  },
  {
    "start": 126.68,
    "end": 129.28,
    "text": "平均相似度和商怎麼決定路線"
  },
  {
    "start": 129.28,
    "end": 131.36,
    "text": "如果平均相似度高"
  },
  {
    "start": 131.36,
    "end": 133.52,
    "text": "說明問題和記憶很熟"
  },
  {
    "start": 133.52,
    "end": 135.64,
    "text": "直接走Familiarity"
  },
  {
    "start": 135.64,
    "end": 137.48,
    "text": "如果平均相似度低"
  },
  {
    "start": 137.48,
    "end": 139.36,
    "text": "說明沒找到明確方向"
  },
  {
    "start": 139.36,
    "end": 142.08,
    "text": "就走Recollection中間區域看商"
  },
  {
    "start": 142.08,
    "end": 145.0,
    "text": "商低說明候選集中仍可快取"
  },
  {
    "start": 145.08,
    "end": 146.96,
    "text": "商高說明候選分散"
  },
  {
    "start": 146.96,
    "end": 147.88,
    "text": "需要慢回憶"
  },
  {
    "start": 147.88,
    "end": 149.48,
    "text": "給個產品直捲"
  },
  {
    "start": 149.48,
    "end": 151.16,
    "text": "什麼問題會走快路徑"
  },
  {
    "start": 151.16,
    "end": 152.6,
    "text": "比如用戶問"
  },
  {
    "start": 152.6,
    "end": 155.92,
    "text": "我之前說過自己常用哪種筆記工具"
  },
  {
    "start": 155.92,
    "end": 158.36,
    "text": "如果歷史裡有非常明確的匹配"
  },
  {
    "start": 158.36,
    "end": 159.88,
    "text": "Top K就夠了"
  },
  {
    "start": 159.88,
    "end": 162.04,
    "text": "快路徑的價值是低延遲"
  },
  {
    "start": 162.04,
    "end": 162.8,
    "text": "低成本"
  },
  {
    "start": 162.8,
    "end": 165.0,
    "text": "不為了複雜性而複雜化"
  },
  {
    "start": 165.0,
    "end": 166.2,
    "text": "論文實驗裡"
  },
  {
    "start": 166.2,
    "end": 169.52,
    "text": "它也把Dance Retrieval看作Familiarity極限"
  },
  {
    "start": 169.52,
    "end": 171.24,
    "text": "什麼問題需要慢回憶"
  },
  {
    "start": 171.24,
    "end": 173.48,
    "text": "比如幫我總結上個月"
  },
  {
    "start": 173.48,
    "end": 174.8,
    "text": "討論過的技術方案"
  },
  {
    "start": 174.84,
    "end": 175.88,
    "text": "優缺點"
  },
  {
    "start": 175.88,
    "end": 178.56,
    "text": "線索可能分散在多段歷史裡"
  },
  {
    "start": 178.56,
    "end": 180.68,
    "text": "表層相似不一定最強"
  },
  {
    "start": 180.68,
    "end": 184.52,
    "text": "Recollection路徑會圍繞初步候選繼續擴展"
  },
  {
    "start": 184.52,
    "end": 187.4,
    "text": "把可能相關的證據鏈一步步找出來"
  },
  {
    "start": 187.4,
    "end": 188.4,
    "text": "慢"
  },
  {
    "start": 188.4,
    "end": 189.84,
    "text": "路徑具體怎麼做"
  },
  {
    "start": 189.84,
    "end": 192.04,
    "text": "不是讓大模型慢慢想吧"
  },
  {
    "start": 192.04,
    "end": 193.08,
    "text": "不是"
  },
  {
    "start": 193.08,
    "end": 196.08,
    "text": "它主要在embedding空間裡做"
  },
  {
    "start": 196.08,
    "end": 198.96,
    "text": "每一輪先檢索Top N候選"
  },
  {
    "start": 198.96,
    "end": 202.84,
    "text": "再用K Means把候選機聚成幾個粗"
  },
  {
    "start": 202.88,
    "end": 206.52,
    "text": "每個粗的Centrite代表一個語意方向"
  },
  {
    "start": 206.52,
    "end": 212.04,
    "text": "然後把當前queryCentrite和原始query參差信息混合"
  },
  {
    "start": 212.04,
    "end": 214.24,
    "text": "生成新的Recollect Query"
  },
  {
    "start": 214.24,
    "end": 216.52,
    "text": "這裡的Alpha Mix其什麼作用"
  },
  {
    "start": 216.52,
    "end": 219.24,
    "text": "Alpha Mix控制查詢"
  },
  {
    "start": 219.24,
    "end": 221.52,
    "text": "穩定性和探索性的平衡"
  },
  {
    "start": 221.52,
    "end": 224.76,
    "text": "太靠近原始query就擴不出去"
  },
  {
    "start": 224.76,
    "end": 228.52,
    "text": "太靠近Centrite又可能飄到無關方向"
  },
  {
    "start": 228.52,
    "end": 231.12,
    "text": "論文附路的敏感性分析顯示"
  },
  {
    "start": 231.16,
    "end": 233.16,
    "text": "中等Alpha往往更穩"
  },
  {
    "start": 233.16,
    "end": 235.04,
    "text": "因為它既保留問題意圖"
  },
  {
    "start": 235.04,
    "end": 237.28,
    "text": "又允許延相關記憶處擴展"
  },
  {
    "start": 237.28,
    "end": 239.6,
    "text": "那回憶會不會失控越找越多"
  },
  {
    "start": 239.6,
    "end": 241.88,
    "text": "它被明確限制住了"
  },
  {
    "start": 241.88,
    "end": 245.04,
    "text": "Beam Waste控制每輪保留多少分枝"
  },
  {
    "start": 245.04,
    "end": 248.16,
    "text": "Fanout控制每個分枝擴多少候選"
  },
  {
    "start": 248.16,
    "end": 251.44,
    "text": "Maximum Rounds控制最多走幾輪"
  },
  {
    "start": 251.44,
    "end": 253.12,
    "text": "論文的實現細節裡"
  },
  {
    "start": 253.12,
    "end": 257.44,
    "text": "Persona Man主實驗用B等於3F等於2"
  },
  {
    "start": 257.44,
    "end": 259.84,
    "text": "並設置上下預值來控制切換"
  },
  {
    "start": 259.84,
    "end": 262.4,
    "text": "所以RF MAM的關鍵不是慢"
  },
  {
    "start": 262.4,
    "end": 263.36,
    "text": "而是按虛慢"
  },
  {
    "start": 263.36,
    "end": 265.8,
    "text": "正是Recollection only"
  },
  {
    "start": 265.8,
    "end": 268.56,
    "text": "會把所有問題都當複雜問題處理"
  },
  {
    "start": 268.56,
    "end": 270.12,
    "text": "延遲更高"
  },
  {
    "start": 270.12,
    "end": 272.2,
    "text": "Dance retrieval會把所有問題"
  },
  {
    "start": 272.2,
    "end": 273.92,
    "text": "都當簡單問題處理"
  },
  {
    "start": 273.92,
    "end": 275.64,
    "text": "召回可能不足"
  },
  {
    "start": 275.64,
    "end": 278.48,
    "text": "RF MAM的價值是把不確定性"
  },
  {
    "start": 278.48,
    "end": 280.16,
    "text": "變成路由信號"
  },
  {
    "start": 280.16,
    "end": 282.16,
    "text": "只在值得的時候多花計算"
  },
  {
    "start": 282.16,
    "end": 283.92,
    "text": "實驗是怎麼驗證的"
  },
  {
    "start": 283.92,
    "end": 286.76,
    "text": "它用了三個數據級"
  },
  {
    "start": 286.76,
    "end": 289.8,
    "text": "Persona MAM測個性化生成準確率"
  },
  {
    "start": 289.96,
    "end": 295.0,
    "text": "包含32K、128K和EM三種記憶規模"
  },
  {
    "start": 295.0,
    "end": 297.38,
    "text": "Persona Bench和Long MAM eval"
  },
  {
    "start": 297.38,
    "end": 299.72,
    "text": "測個人記憶檢索的Recall"
  },
  {
    "start": 299.72,
    "end": 301.8,
    "text": "期限包括Zero Memory"
  },
  {
    "start": 301.8,
    "end": 302.92,
    "text": "Full Contacts"
  },
  {
    "start": 302.92,
    "end": 304.32,
    "text": "Dance Retrieval"
  },
  {
    "start": 304.32,
    "end": 306.8,
    "text": "也包括直走Recollection的版本"
  },
  {
    "start": 306.8,
    "end": 308.84,
    "text": "先說Persona MAM的結果"
  },
  {
    "start": 308.84,
    "end": 310.52,
    "text": "Persona MAM上"
  },
  {
    "start": 310.52,
    "end": 315.0,
    "text": "RF MAM在三個規模都拿到最高Overall Accuracy"
  },
  {
    "start": 315.0,
    "end": 317.8,
    "text": "32K下是0.6350"
  },
  {
    "start": 317.8,
    "end": 320.52,
    "text": "高於Full Contacts的0.6129"
  },
  {
    "start": 320.52,
    "end": 323.16,
    "text": "和Dance Retrieval的0.5908"
  },
  {
    "start": 323.16,
    "end": 325.84,
    "text": "128K下是0.5394"
  },
  {
    "start": 325.84,
    "end": 328.16,
    "text": "EM下是0.4589"
  },
  {
    "start": 328.16,
    "end": 330.92,
    "text": "而Full Contacts已經超出上下文窗口"
  },
  {
    "start": 330.92,
    "end": 333.0,
    "text": "它的延遲真的可控嗎"
  },
  {
    "start": 333.0,
    "end": 336.16,
    "text": "論文報告的趨勢是可控的"
  },
  {
    "start": 336.16,
    "end": 338.32,
    "text": "Persona MAM32K下"
  },
  {
    "start": 338.32,
    "end": 342.12,
    "text": "RF MAM檢索時間是5.09毫秒"
  },
  {
    "start": 342.12,
    "end": 345.32,
    "text": "Recollection only是7.09毫秒"
  },
  {
    "start": 345.32,
    "end": 346.56,
    "text": "128K下"
  },
  {
    "start": 346.72,
    "end": 349.28,
    "text": "RF MAM是4.27毫秒"
  },
  {
    "start": 349.28,
    "end": 352.0,
    "text": "Recollection only是7.86毫秒"
  },
  {
    "start": 352.0,
    "end": 353.92,
    "text": "它比始終漫回憶更省"
  },
  {
    "start": 353.92,
    "end": 355.4,
    "text": "檢索任務上呢"
  },
  {
    "start": 355.4,
    "end": 356.96,
    "text": "Persona Bench上"
  },
  {
    "start": 356.96,
    "end": 358.6,
    "text": "用mini-LM時"
  },
  {
    "start": 358.6,
    "end": 361.44,
    "text": "RF MAM的Overall Recall at 10"
  },
  {
    "start": 361.44,
    "end": 363.36,
    "text": "是0.6071"
  },
  {
    "start": 363.36,
    "end": 366.48,
    "text": "略高於Familiarity的0.5964"
  },
  {
    "start": 366.48,
    "end": 369.48,
    "text": "和Recollection的0.6062"
  },
  {
    "start": 369.48,
    "end": 370.92,
    "text": "Long MAM eval上"
  },
  {
    "start": 370.92,
    "end": 372.28,
    "text": "用BGE時"
  },
  {
    "start": 372.28,
    "end": 374.68,
    "text": "RF MAM在小規模設置的"
  },
  {
    "start": 374.72,
    "end": 377.48,
    "text": "Recoll at 5是0.8186"
  },
  {
    "start": 377.48,
    "end": 380.4,
    "text": "高於Familiarity的0.7924"
  },
  {
    "start": 380.4,
    "end": 382.72,
    "text": "這個提升聽起來不總是很大"
  },
  {
    "start": 382.72,
    "end": 383.64,
    "text": "應該怎麼理解"
  },
  {
    "start": 383.64,
    "end": 385.56,
    "text": "這是個好問題"
  },
  {
    "start": 385.56,
    "end": 388.64,
    "text": "RF MAM不是那種用巨大額外成本"
  },
  {
    "start": 388.64,
    "end": 390.56,
    "text": "換大幅分數的系統"
  },
  {
    "start": 390.56,
    "end": 391.88,
    "text": "而是做取捨"
  },
  {
    "start": 391.88,
    "end": 393.08,
    "text": "在多數情況下"
  },
  {
    "start": 393.08,
    "end": 395.48,
    "text": "保持接近One Shot的延遲"
  },
  {
    "start": 395.48,
    "end": 398.4,
    "text": "同時在複雜查詢上補足召回"
  },
  {
    "start": 398.4,
    "end": 401.28,
    "text": "它的賣點是穩定輕量可插拔"
  },
  {
    "start": 401.28,
    "end": 403.56,
    "text": "而不是單表裡碾壓所有指標"
  },
  {
    "start": 403.56,
    "end": 405.32,
    "text": "可插拔體現在哪裡"
  },
  {
    "start": 405.32,
    "end": 408.88,
    "text": "論文做了三類Adaptive實驗"
  },
  {
    "start": 408.88,
    "end": 410.8,
    "text": "它可以疊加在Memory Bank"
  },
  {
    "start": 410.8,
    "end": 413.4,
    "text": "這類離線Summary Index上"
  },
  {
    "start": 413.4,
    "end": 416.96,
    "text": "也可以接在High DE查詢擴展後面"
  },
  {
    "start": 416.96,
    "end": 419.0,
    "text": "還可以作為Search OE"
  },
  {
    "start": 419.0,
    "end": 421.64,
    "text": "疊帶解鎖中的Retrieval Layer"
  },
  {
    "start": 421.64,
    "end": 423.68,
    "text": "也就是說RF MAM"
  },
  {
    "start": 423.68,
    "end": 425.64,
    "text": "不是替代所有記憶系統"
  },
  {
    "start": 425.64,
    "end": 428.6,
    "text": "而是給解鎖層加一個雙路徑控制器"
  },
  {
    "start": 428.6,
    "end": 430.68,
    "text": "那和Memgas到底怎麼互補"
  },
  {
    "start": 430.68,
    "end": 434.76,
    "text": "Memgas更像在問記憶庫內部怎麼組織"
  },
  {
    "start": 434.76,
    "end": 437.72,
    "text": "多力度、關聯圖、圖傳播"
  },
  {
    "start": 437.72,
    "end": 442.44,
    "text": "RF MAM更像在問面對這個查詢怎麼解鎖"
  },
  {
    "start": 442.44,
    "end": 445.2,
    "text": "直接快取還是啟動慢回憶"
  },
  {
    "start": 445.2,
    "end": 446.96,
    "text": "工程上可以想像"
  },
  {
    "start": 446.96,
    "end": 449.56,
    "text": "Memgas提供更好的記憶結構"
  },
  {
    "start": 449.56,
    "end": 452.44,
    "text": "RF MAM在上面做按需解鎖調度"
  },
  {
    "start": 452.44,
    "end": 455.68,
    "text": "這篇論文最值得借鑒的工程點是什麼"
  },
  {
    "start": 455.68,
    "end": 459.76,
    "text": "我認為是把不確定性前置到解鎖控制裡"
  },
  {
    "start": 459.76,
    "end": 462.92,
    "text": "很多系統只關心拿回多少條結果"
  },
  {
    "start": 462.92,
    "end": 465.16,
    "text": "但RF MAM會先問"
  },
  {
    "start": 465.16,
    "end": 468.36,
    "text": "這些結果是不是足夠集中、足夠可信"
  },
  {
    "start": 468.36,
    "end": 470.88,
    "text": "如果不是再花更多預算"
  },
  {
    "start": 470.88,
    "end": 473.72,
    "text": "這比固定TopK或固定多輪解鎖"
  },
  {
    "start": 473.72,
    "end": 475.76,
    "text": "都更符合真實產品約束"
  },
  {
    "start": 475.76,
    "end": 476.92,
    "text": "它有什麼邊界"
  },
  {
    "start": 476.92,
    "end": 478.12,
    "text": "有幾個"
  },
  {
    "start": 478.12,
    "end": 481.2,
    "text": "第一List entropy只是輕量代理"
  },
  {
    "start": 481.2,
    "end": 484.32,
    "text": "不能完全理解任務難度和用戶意圖"
  },
  {
    "start": 484.32,
    "end": 487.44,
    "text": "第二路由依賴embatting空間較準"
  },
  {
    "start": 487.44,
    "end": 489.48,
    "text": "解鎖器質量會影響判斷"
  },
  {
    "start": 489.48,
    "end": 492.36,
    "text": "第三當前主要驗證文本對話記憶"
  },
  {
    "start": 492.36,
    "end": 494.56,
    "text": "還沒有完整覆蓋多模態歷史"
  },
  {
    "start": 494.56,
    "end": 496.32,
    "text": "時間更新和記憶衝突"
  },
  {
    "start": 496.32,
    "end": 498.8,
    "text": "各型化記憶還會帶以思風險吧"
  },
  {
    "start": 498.8,
    "end": 501.96,
    "text": "對論文倫理部分也提醒"
  },
  {
    "start": 501.96,
    "end": 506.04,
    "text": "RF MAM更擅長重新換起長期用戶歷史"
  },
  {
    "start": 506.04,
    "end": 508.84,
    "text": "這意味著真實部署要防止敏感信息"
  },
  {
    "start": 508.84,
    "end": 510.68,
    "text": "被意外帶回上下文"
  },
  {
    "start": 510.68,
    "end": 513.68,
    "text": "也要避免系統過度放大用戶特徵"
  },
  {
    "start": 513.68,
    "end": 515.48,
    "text": "或形成不當畫像"
  },
  {
    "start": 515.48,
    "end": 516.76,
    "text": "解鎖更強"
  },
  {
    "start": 516.76,
    "end": 518.68,
    "text": "不等於可以無約數的記住"
  },
  {
    "start": 519.64,
    "end": 521.44,
    "text": "最後用一句話收束"
  },
  {
    "start": 521.44,
    "end": 522.44,
    "text": "它推進了什麼"
  },
  {
    "start": 522.44,
    "end": 527.0,
    "text": "RF MAM推進的是一種檢索控制範式"
  },
  {
    "start": 527.0,
    "end": 530.28,
    "text": "讓個性化agent先判斷自己熟不熟"
  },
  {
    "start": 530.28,
    "end": 531.88,
    "text": "熟悉就快檢索"
  },
  {
    "start": 531.88,
    "end": 533.76,
    "text": "不熟悉再慢回憶"
  },
  {
    "start": 533.76,
    "end": 537.16,
    "text": "長期記憶系統的關鍵不只是記得多"
  },
  {
    "start": 537.16,
    "end": 538.8,
    "text": "而是在合適問題上"
  },
  {
    "start": 538.8,
    "end": 541.28,
    "text": "用合適深度把記憶換起來"
  }
]