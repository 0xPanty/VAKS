[
  {
    "start": 0.0,
    "end": 2.52,
    "text": "很多人用Obsidian知識庫第一步就錯了"
  },
  {
    "start": 2.52,
    "end": 3.92,
    "text": "不是你的插件裝的不夠多"
  },
  {
    "start": 3.92,
    "end": 5.36,
    "text": "也不是分類規則不夠細"
  },
  {
    "start": 5.36,
    "end": 7.68,
    "text": "真正的問題是你還沒有跑通一個最小閉環"
  },
  {
    "start": 7.68,
    "end": 9.2,
    "text": "就想直接做全自動的系統"
  },
  {
    "start": 9.2,
    "end": 10.8,
    "text": "最近社群裡有個小夥伴跟我吐槽"
  },
  {
    "start": 10.8,
    "end": 13.44,
    "text": "他想把X的知識星球 網頁 文章 線內容"
  },
  {
    "start": 13.44,
    "end": 14.72,
    "text": "全部都收進Obsidian"
  },
  {
    "start": 14.72,
    "end": 16.6,
    "text": "還想讓Codex自動分類"
  },
  {
    "start": 16.6,
    "end": 17.64,
    "text": "但內容越受越多"
  },
  {
    "start": 17.64,
    "end": 19.2,
    "text": "最後自己反而看不來了"
  },
  {
    "start": 19.2,
    "end": 21.76,
    "text": "我聽完發現他最大的卡點不是工具不夠強"
  },
  {
    "start": 21.76,
    "end": 23.84,
    "text": "而是入口太多了規則太亂"
  },
  {
    "start": 23.84,
    "end": 27.16,
    "text": "所以我建議他先別管複雜的知識庫先跑通自身部"
  },
  {
    "start": 27.16,
    "end": 27.68,
    "text": "第一步"
  },
  {
    "start": 27.68,
    "end": 31.08,
    "text": "先在瀏覽器裡裝一個Obsidian WebPlipper給你插件"
  },
  {
    "start": 31.08,
    "end": 31.72,
    "text": "第二步"
  },
  {
    "start": 31.72,
    "end": 34.64,
    "text": "刷到好內容的時候直接點插件圖標"
  },
  {
    "start": 34.64,
    "end": 36.88,
    "text": "把內容保存成本DMD文件"
  },
  {
    "start": 36.88,
    "end": 39.04,
    "text": "放進你的Obsidian的素材文件夾"
  },
  {
    "start": 39.04,
    "end": 39.6,
    "text": "第三步"
  },
  {
    "start": 39.6,
    "end": 42.28,
    "text": "打開Codex讓他先幫你做一輪整理"
  },
  {
    "start": 42.28,
    "end": 43.76,
    "text": "比如打標籤分目錄"
  },
  {
    "start": 43.76,
    "end": 46.6,
    "text": "標出哪些內容後面是值得再處理的"
  },
  {
    "start": 46.6,
    "end": 47.88,
    "text": "先做到這裡就夠了"
  },
  {
    "start": 47.88,
    "end": 49.6,
    "text": "這時候你只需要看兩件事"
  },
  {
    "start": 49.6,
    "end": 51.84,
    "text": "看到好的內容能不能順手收進來"
  },
  {
    "start": 51.84,
    "end": 52.68,
    "text": "收進來之後"
  },
  {
    "start": 52.68,
    "end": 54.6,
    "text": "AI能不能幫你做第一輪的整理"
  },
  {
    "start": 54.6,
    "end": 55.72,
    "text": "只要這兩件事跑通了"
  },
  {
    "start": 55.72,
    "end": 57.52,
    "text": "你的知識庫就已經開始動起來了"
  },
  {
    "start": 57.52,
    "end": 59.4,
    "text": "後面再慢慢去夾分類的規則"
  },
  {
    "start": 59.4,
    "end": 60.16,
    "text": "標籤體系"
  },
  {
    "start": 60.16,
    "end": 61.04,
    "text": "自動化流程"
  },
  {
    "start": 61.04,
    "end": 61.72,
    "text": "都來得及"
  },
  {
    "start": 61.72,
    "end": 63.0,
    "text": "我自己現在也是這麼做的"
  },
  {
    "start": 63.0,
    "end": 64.44,
    "text": "素材庫先統一收進來"
  },
  {
    "start": 64.44,
    "end": 66.24,
    "text": "分類和整理先交給AI跑一遍"
  },
  {
    "start": 66.24,
    "end": 67.36,
    "text": "亂一點沒關係"
  },
  {
    "start": 67.36,
    "end": 69.16,
    "text": "知識庫不是一上來就完美"
  },
  {
    "start": 69.16,
    "end": 70.64,
    "text": "它第一步要解決的是"
  },
  {
    "start": 70.64,
    "end": 72.24,
    "text": "先把有價值的內容接住"
  },
  {
    "start": 72.24,
    "end": 73.56,
    "text": "先有內容再談整理"
  }
]