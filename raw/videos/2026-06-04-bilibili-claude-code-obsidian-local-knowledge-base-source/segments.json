[
  {
    "start": 0.0,
    "end": 1.84,
    "text": "帮我写一份离校系统解决方案"
  },
  {
    "start": 1.84,
    "end": 3.8,
    "text": "我就跟Agent说了这一句"
  },
  {
    "start": 3.8,
    "end": 5.2,
    "text": "他读完我整个知识库"
  },
  {
    "start": 5.2,
    "end": 6.72,
    "text": "三分钟写了一份给我"
  },
  {
    "start": 6.72,
    "end": 7.88,
    "text": "分了七个章节"
  },
  {
    "start": 7.88,
    "end": 9.8,
    "text": "每个章节标了引用来源"
  },
  {
    "start": 9.8,
    "end": 11.96,
    "text": "点一下引用直接跳回原始文档"
  },
  {
    "start": 11.96,
    "end": 13.28,
    "text": "不是编的"
  },
  {
    "start": 13.28,
    "end": 14.52,
    "text": "怎么做到的"
  },
  {
    "start": 14.52,
    "end": 16.2,
    "text": "这是我工作中积累的文档"
  },
  {
    "start": 16.2,
    "end": 17.44,
    "text": "有一千多份"
  },
  {
    "start": 17.44,
    "end": 20.04,
    "text": "Word XL, PPT, PDF, Saga石都有"
  },
  {
    "start": 20.04,
    "end": 21.08,
    "text": "一开始还归类"
  },
  {
    "start": 21.08,
    "end": 22.28,
    "text": "后来就随手扔"
  },
  {
    "start": 22.28,
    "end": 25.0,
    "text": "你想找一份的时候基本是这个状态"
  },
  {
    "start": 25.0,
    "end": 26.12,
    "text": "现在是这个状态"
  },
  {
    "start": 26.12,
    "end": 28.24,
    "text": "所有文档关系划成了一张图"
  },
  {
    "start": 28.24,
    "end": 29.32,
    "text": "更关键的是"
  },
  {
    "start": 29.4,
    "end": 31.24,
    "text": "是Agent能基于这一堆文档"
  },
  {
    "start": 31.24,
    "end": 33.56,
    "text": "帮你写一份带引用的新方案出来"
  },
  {
    "start": 33.56,
    "end": 34.72,
    "text": "全套就两个工具"
  },
  {
    "start": 34.72,
    "end": 36.28,
    "text": "Cloud加Oversetting"
  },
  {
    "start": 36.28,
    "end": 37.32,
    "text": "不用写一行代码"
  },
  {
    "start": 37.32,
    "end": 38.96,
    "text": "全程三十多分钟跑完"
  },
  {
    "start": 38.96,
    "end": 41.0,
    "text": "如果你也有一堆工作文档没整理"
  },
  {
    "start": 41.0,
    "end": 42.44,
    "text": "这条视频跟着做就行"
  },
  {
    "start": 42.44,
    "end": 43.32,
    "text": "先说清楚"
  },
  {
    "start": 43.32,
    "end": 45.16,
    "text": "这套更合适管理工作文档"
  },
  {
    "start": 45.16,
    "end": 46.28,
    "text": "如果是学习笔记"
  },
  {
    "start": 46.28,
    "end": 47.96,
    "text": "或者科研引文指示管理"
  },
  {
    "start": 47.96,
    "end": 48.76,
    "text": "也可以参考"
  },
  {
    "start": 48.76,
    "end": 49.88,
    "text": "整个过程就五步"
  },
  {
    "start": 49.88,
    "end": 50.96,
    "text": "先不讲怎么搭"
  },
  {
    "start": 50.96,
    "end": 53.6,
    "text": "先给你看一遍搭好之后能干出什么活"
  },
  {
    "start": 53.6,
    "end": 56.36,
    "text": "你再决定直不直花这点时间跟着做"
  },
  {
    "start": 56.36,
    "end": 57.76,
    "text": "提示词我现场打"
  },
  {
    "start": 57.76,
    "end": 60.2,
    "text": "基于知识库里所有离效系统相关文档"
  },
  {
    "start": 60.2,
    "end": 61.4,
    "text": "帮我写一份完整的"
  },
  {
    "start": 61.4,
    "end": 63.2,
    "text": "数字离效系统解决方案"
  },
  {
    "start": 63.2,
    "end": 65.44,
    "text": "每个章节都要标出引用来源"
  },
  {
    "start": 65.44,
    "end": 67.84,
    "text": "它第一步先去全库发行的"
  },
  {
    "start": 67.84,
    "end": 70.72,
    "text": "找到了12份跟离效系统相关的文档"
  },
  {
    "start": 70.72,
    "end": 72.16,
    "text": "然后一份一份读"
  },
  {
    "start": 72.16,
    "end": 74.44,
    "text": "最终经读了其中八份核心文档"
  },
  {
    "start": 74.44,
    "end": 75.48,
    "text": "它说以消化"
  },
  {
    "start": 75.48,
    "end": 76.52,
    "text": "开始按知识库"
  },
  {
    "start": 76.52,
    "end": 78.72,
    "text": "已经订好的归档规则写新方案"
  },
  {
    "start": 78.72,
    "end": 80.32,
    "text": "这个规则我们等下第五步"
  },
  {
    "start": 80.32,
    "end": 81.48,
    "text": "会从零搭一遍"
  },
  {
    "start": 81.48,
    "end": 83.88,
    "text": "三分钟不到方案出来了"
  },
  {
    "start": 83.88,
    "end": 86.08,
    "text": "自动归档到对应产品目录"
  },
  {
    "start": 86.16,
    "end": 88.76,
    "text": "连产品的所有营业也顺手帮我更新了"
  },
  {
    "start": 88.76,
    "end": 90.4,
    "text": "每个章节都标的内容来源"
  },
  {
    "start": 90.4,
    "end": 91.96,
    "text": "是哪份归档文件"
  },
  {
    "start": 91.96,
    "end": 93.24,
    "text": "重点看这个"
  },
  {
    "start": 93.24,
    "end": 95.64,
    "text": "我随便点一个引用weekly link"
  },
  {
    "start": 95.64,
    "end": 98.6,
    "text": "直接跳到我原始的那份归档文件"
  },
  {
    "start": 98.6,
    "end": 99.44,
    "text": "它不是编的"
  },
  {
    "start": 99.44,
    "end": 102.64,
    "text": "是真的从这12份文档里抽出来的内容"
  },
  {
    "start": 102.64,
    "end": 105.28,
    "text": "每一段都能溯原到具体哪份文件"
  },
  {
    "start": 105.28,
    "end": 107.04,
    "text": "如果用传统方式自己写"
  },
  {
    "start": 107.04,
    "end": 108.8,
    "text": "我以前干的是小半天"
  },
  {
    "start": 108.8,
    "end": 109.72,
    "text": "现在三分钟"
  },
  {
    "start": 109.72,
    "end": 111.8,
    "text": "带流程图带引用自动归档"
  },
  {
    "start": 111.8,
    "end": 112.68,
    "text": "想要这个效果"
  },
  {
    "start": 112.68,
    "end": 114.64,
    "text": "接下来五步跟着做就行"
  },
  {
    "start": 114.64,
    "end": 115.92,
    "text": "前面四步装环境"
  },
  {
    "start": 115.96,
    "end": 117.24,
    "text": "跳一步会卡在后面"
  },
  {
    "start": 117.24,
    "end": 118.88,
    "text": "但每步需要自己操作的时间"
  },
  {
    "start": 118.88,
    "end": 120.04,
    "text": "不超过一分钟"
  },
  {
    "start": 120.04,
    "end": 121.96,
    "text": "第一步把所有的Word XL"
  },
  {
    "start": 121.96,
    "end": 124.0,
    "text": "PPT PDF转成Markdown"
  },
  {
    "start": 124.0,
    "end": 125.56,
    "text": "Obsidian指认Markdown"
  },
  {
    "start": 125.56,
    "end": 127.44,
    "text": "你不转它就不认你的文档"
  },
  {
    "start": 127.44,
    "end": 129.6,
    "text": "工具用微软开源的Market档"
  },
  {
    "start": 129.6,
    "end": 131.28,
    "text": "我做的图形化整合包"
  },
  {
    "start": 131.28,
    "end": 132.84,
    "text": "不想自己装的直接下载"
  },
  {
    "start": 132.84,
    "end": 134.88,
    "text": "链接在评论区置领"
  },
  {
    "start": 134.88,
    "end": 136.52,
    "text": "双击一键启动"
  },
  {
    "start": 136.52,
    "end": 138.52,
    "text": "选择文档存放模拟"
  },
  {
    "start": 138.52,
    "end": 140.28,
    "text": "指定输出模拟"
  },
  {
    "start": 140.28,
    "end": 142.0,
    "text": "点开始转换"
  },
  {
    "start": 142.0,
    "end": 143.36,
    "text": "自动识别文件内容"
  },
  {
    "start": 143.36,
    "end": 145.92,
    "text": "老的DOC自动转成DOCX"
  },
  {
    "start": 145.92,
    "end": 147.8,
    "text": "PPT转PPTX"
  },
  {
    "start": 147.8,
    "end": 149.56,
    "text": "无关文件会直接跳过"
  },
  {
    "start": 149.56,
    "end": 151.56,
    "text": "全程力不用管"
  },
  {
    "start": 151.56,
    "end": 152.4,
    "text": "这一步完成"
  },
  {
    "start": 152.4,
    "end": 155.04,
    "text": "所有文档已经准备好被AR理解了"
  },
  {
    "start": 155.04,
    "end": 157.08,
    "text": "第二步 装Cloud Code"
  },
  {
    "start": 157.08,
    "end": 158.16,
    "text": "说句反直觉的"
  },
  {
    "start": 158.16,
    "end": 159.48,
    "text": "虽然叫Cloud Code"
  },
  {
    "start": 159.48,
    "end": 161.56,
    "text": "装完之后你不会再打开它一次"
  },
  {
    "start": 161.56,
    "end": 163.44,
    "text": "装这一步纯粹是为了Obsidian"
  },
  {
    "start": 163.44,
    "end": 165.12,
    "text": "那个插件能调用它"
  },
  {
    "start": 165.12,
    "end": 166.44,
    "text": "一条指令"
  },
  {
    "start": 166.44,
    "end": 168.56,
    "text": "回车跑完就行"
  },
  {
    "start": 168.56,
    "end": 169.28,
    "text": "这一步结束"
  },
  {
    "start": 169.28,
    "end": 171.0,
    "text": "后面再也不开它了"
  },
  {
    "start": 171.0,
    "end": 172.76,
    "text": "第三步 装Obsidian"
  },
  {
    "start": 172.8,
    "end": 174.44,
    "text": "官网下载 摸人安装就行"
  },
  {
    "start": 174.44,
    "end": 176.0,
    "text": "没什么特别的"
  },
  {
    "start": 176.0,
    "end": 177.72,
    "text": "然后运行创建仓库"
  },
  {
    "start": 177.72,
    "end": 178.84,
    "text": "仓库名随便"
  },
  {
    "start": 178.84,
    "end": 180.4,
    "text": "我叫WalkDOC"
  },
  {
    "start": 180.4,
    "end": 182.16,
    "text": "存放在地盘"
  },
  {
    "start": 182.16,
    "end": 183.64,
    "text": "把刚才转出来的文件价"
  },
  {
    "start": 183.64,
    "end": 186.08,
    "text": "整个拖进去"
  },
  {
    "start": 186.08,
    "end": 188.52,
    "text": "这时Obsidian会卡十几秒"
  },
  {
    "start": 188.52,
    "end": 189.04,
    "text": "别关"
  },
  {
    "start": 189.04,
    "end": 190.76,
    "text": "它在家载里所有文档"
  },
  {
    "start": 190.76,
    "end": 191.56,
    "text": "等它转完"
  },
  {
    "start": 191.56,
    "end": 193.36,
    "text": "文件全部在Obsidian里"
  },
  {
    "start": 193.36,
    "end": 195.44,
    "text": "但现在它们之间没有任何关系"
  },
  {
    "start": 195.44,
    "end": 196.76,
    "text": "下一步装的那个插件"
  },
  {
    "start": 196.76,
    "end": 198.24,
    "text": "就是来建关系的"
  },
  {
    "start": 198.24,
    "end": 199.92,
    "text": "第四步 装Cloud的插件"
  },
  {
    "start": 199.92,
    "end": 200.6,
    "text": "这一步装完"
  },
  {
    "start": 200.6,
    "end": 203.28,
    "text": "Cloud Code才算真的接上Obsidian"
  },
  {
    "start": 203.28,
    "end": 204.36,
    "text": "进设置"
  },
  {
    "start": 204.36,
    "end": 205.64,
    "text": "第三方插件"
  },
  {
    "start": 205.64,
    "end": 207.16,
    "text": "关安全模式"
  },
  {
    "start": 207.16,
    "end": 208.64,
    "text": "点浏览"
  },
  {
    "start": 208.64,
    "end": 212.4,
    "text": "这里收Cloud点"
  },
  {
    "start": 212.4,
    "end": 214.32,
    "text": "装完启用"
  },
  {
    "start": 214.32,
    "end": 215.8,
    "text": "然后把语言改成中文"
  },
  {
    "start": 215.8,
    "end": 217.32,
    "text": "顺手多了"
  },
  {
    "start": 217.32,
    "end": 218.8,
    "text": "接到Cloud Code"
  },
  {
    "start": 218.8,
    "end": 220.72,
    "text": "拿到底部环境设置这一难"
  },
  {
    "start": 220.72,
    "end": 222.24,
    "text": "填写接入模型"
  },
  {
    "start": 222.24,
    "end": 223.48,
    "text": "我笔记这里列出了"
  },
  {
    "start": 223.48,
    "end": 225.2,
    "text": "各类模型的接入写法"
  },
  {
    "start": 225.2,
    "end": 227.12,
    "text": "想建哪个模型复制粘贴过来"
  },
  {
    "start": 227.12,
    "end": 228.52,
    "text": "这里我接DeepSeq"
  },
  {
    "start": 228.52,
    "end": 230.44,
    "text": "API-K换成自己购买的"
  },
  {
    "start": 230.44,
    "end": 231.36,
    "text": "要想不花钱"
  },
  {
    "start": 231.4,
    "end": 233.08,
    "text": "可以接本地的欧拉马"
  },
  {
    "start": 233.08,
    "end": 234.64,
    "text": "视频结尾另讲"
  },
  {
    "start": 234.64,
    "end": 235.96,
    "text": "回到主界面"
  },
  {
    "start": 235.96,
    "end": 237.96,
    "text": "这边难多了小机器人图标"
  },
  {
    "start": 237.96,
    "end": 240.76,
    "text": "Cloud Code已经接上Obsidian了"
  },
  {
    "start": 240.76,
    "end": 241.56,
    "text": "到这一步"
  },
  {
    "start": 241.56,
    "end": 242.92,
    "text": "环境全部就位"
  },
  {
    "start": 242.92,
    "end": 244.28,
    "text": "接下来我们用一句话"
  },
  {
    "start": 244.28,
    "end": 245.76,
    "text": "让它把这一千多份文档"
  },
  {
    "start": 245.76,
    "end": 248.08,
    "text": "自动整理成知识图谱"
  },
  {
    "start": 248.08,
    "end": 251.08,
    "text": "为我的仓库创建关系索引和知识图谱"
  },
  {
    "start": 251.08,
    "end": 253.32,
    "text": "我让它做一个成长型的"
  },
  {
    "start": 253.32,
    "end": 255.28,
    "text": "意思是后续每次新增文档"
  },
  {
    "start": 255.28,
    "end": 256.8,
    "text": "它自己能找到位置"
  },
  {
    "start": 256.8,
    "end": 259.36,
    "text": "不用我手动归档"
  },
  {
    "start": 259.4,
    "end": 261.64,
    "text": "它先把整个仓库扫了一遍"
  },
  {
    "start": 261.64,
    "end": 264.28,
    "text": "所有目录所有文件过一遍"
  },
  {
    "start": 264.28,
    "end": 266.16,
    "text": "读完它给了一份整段报告"
  },
  {
    "start": 266.16,
    "end": 267.28,
    "text": "哪些目录混乱"
  },
  {
    "start": 267.28,
    "end": 269.04,
    "text": "哪些文档没有归内"
  },
  {
    "start": 269.04,
    "end": 271.16,
    "text": "它自己制定了一份重购方案"
  },
  {
    "start": 271.16,
    "end": 272.4,
    "text": "我看了一眼点确认"
  },
  {
    "start": 273.68,
    "end": 275.0,
    "text": "接下来就看着它干活"
  },
  {
    "start": 276.16,
    "end": 278.6,
    "text": "从命名归内建所有文件"
  },
  {
    "start": 278.6,
    "end": 279.68,
    "text": "几分钟重购完成"
  },
  {
    "start": 280.76,
    "end": 282.48,
    "text": "我们来看一下知识图谱"
  },
  {
    "start": 282.48,
    "end": 283.8,
    "text": "先别急着夸"
  },
  {
    "start": 283.8,
    "end": 286.12,
    "text": "你看图谱中间这一堆点"
  },
  {
    "start": 286.12,
    "end": 287.68,
    "text": "是我归档的几百份文档"
  },
  {
    "start": 287.68,
    "end": 289.08,
    "text": "看起来好像在图里"
  },
  {
    "start": 289.08,
    "end": 290.32,
    "text": "实际上全是离散的"
  },
  {
    "start": 290.32,
    "end": 291.96,
    "text": "没有任何真实链接"
  },
  {
    "start": 291.96,
    "end": 293.48,
    "text": "他们只是被放在了一起"
  },
  {
    "start": 293.48,
    "end": 294.84,
    "text": "不是被连在一起"
  },
  {
    "start": 294.84,
    "end": 296.72,
    "text": "把这个问题告诉agent"
  },
  {
    "start": 296.72,
    "end": 298.6,
    "text": "大部分归档内容在关系图谱中"
  },
  {
    "start": 298.6,
    "end": 300.16,
    "text": "并没有建立连接"
  },
  {
    "start": 300.16,
    "end": 301.28,
    "text": "都是离散的脸"
  },
  {
    "start": 301.28,
    "end": 301.68,
    "text": "回车"
  },
  {
    "start": 303.12,
    "end": 304.92,
    "text": "他给的回答让我有点意外"
  },
  {
    "start": 304.92,
    "end": 306.84,
    "text": "他说需要用真正的vik link"
  },
  {
    "start": 306.84,
    "end": 308.8,
    "text": "把这些文档连起来"
  },
  {
    "start": 308.8,
    "end": 309.88,
    "text": "但几百条链接"
  },
  {
    "start": 309.88,
    "end": 312.32,
    "text": "一条一条手动家显然不现实"
  },
  {
    "start": 312.32,
    "end": 314.72,
    "text": "然后他自己想了一个特别优雅的办法"
  },
  {
    "start": 314.72,
    "end": 317.4,
    "text": "为每个产品线创建了一个桥接文件"
  },
  {
    "start": 317.44,
    "end": 319.36,
    "text": "放在归档桥接目录下"
  },
  {
    "start": 319.36,
    "end": 320.56,
    "text": "桥接文件里塞满了"
  },
  {
    "start": 320.56,
    "end": 323.64,
    "text": "指向这条产品线所有归档文档的vik link"
  },
  {
    "start": 323.64,
    "end": 325.64,
    "text": "然后产品的index所有文件"
  },
  {
    "start": 325.64,
    "end": 327.36,
    "text": "只链接到桥接文件"
  },
  {
    "start": 327.36,
    "end": 329.48,
    "text": "这样图谱就形成了三级链路"
  },
  {
    "start": 329.48,
    "end": 332.08,
    "text": "第一级产品索营指向桥接文件"
  },
  {
    "start": 332.08,
    "end": 334.8,
    "text": "第二级桥接文件指向所有归档文档"
  },
  {
    "start": 334.8,
    "end": 337.2,
    "text": "第三级归档文档之间互相引用"
  },
  {
    "start": 337.2,
    "end": 338.36,
    "text": "三层链路一打通"
  },
  {
    "start": 338.36,
    "end": 340.52,
    "text": "整个支枢库就连成了一张网"
  },
  {
    "start": 340.52,
    "end": 343.04,
    "text": "然后他一口气创建了25个桥接文件"
  },
  {
    "start": 343.04,
    "end": 344.96,
    "text": "全部塞满了真实的vik link"
  },
  {
    "start": 344.96,
    "end": 346.32,
    "text": "我什么都没干"
  },
  {
    "start": 346.32,
    "end": 347.8,
    "text": "现在再看图谱"
  },
  {
    "start": 347.8,
    "end": 349.28,
    "text": "所有归档全部连通"
  },
  {
    "start": 349.28,
    "end": 351.64,
    "text": "点任何一个节点都能跳到观念文档"
  },
  {
    "start": 351.64,
    "end": 353.04,
    "text": "这一段我最想说的是"
  },
  {
    "start": 353.04,
    "end": 355.0,
    "text": "重构方案是Agent自己想的"
  },
  {
    "start": 355.0,
    "end": 356.2,
    "text": "不是我教他的"
  },
  {
    "start": 356.2,
    "end": 357.72,
    "text": "我只告诉他有问题"
  },
  {
    "start": 357.72,
    "end": 359.0,
    "text": "他自己定位问题"
  },
  {
    "start": 359.0,
    "end": 360.92,
    "text": "自己想方案自己执行"
  },
  {
    "start": 360.92,
    "end": 364.44,
    "text": "这是Cloud Code跟普通文档文档工具最大的区别"
  },
  {
    "start": 364.44,
    "end": 365.68,
    "text": "可能有人会担心"
  },
  {
    "start": 365.68,
    "end": 368.4,
    "text": "我那些文档售密API走外网不放心"
  },
  {
    "start": 368.4,
    "end": 369.44,
    "text": "完全没问题"
  },
  {
    "start": 369.44,
    "end": 372.32,
    "text": "把Cloud.的API换成本地Olama就行"
  },
  {
    "start": 372.32,
    "end": 374.0,
    "text": "模型在你自己电脑上跑"
  },
  {
    "start": 374.0,
    "end": 376.2,
    "text": "数据一个字节都不出本级"
  },
  {
    "start": 376.24,
    "end": 377.76,
    "text": "就是对显存有点要求"
  },
  {
    "start": 377.76,
    "end": 379.04,
    "text": "看你跑什么模型"
  },
  {
    "start": 379.04,
    "end": 380.12,
    "text": "具体做法"
  },
  {
    "start": 380.12,
    "end": 382.32,
    "text": "Olama官网下载安装程序"
  },
  {
    "start": 382.32,
    "end": 384.52,
    "text": "然后默认安装即可"
  },
  {
    "start": 384.52,
    "end": 385.64,
    "text": "安装好以后"
  },
  {
    "start": 385.64,
    "end": 387.76,
    "text": "chat里面可以选择下载模型"
  },
  {
    "start": 387.76,
    "end": 389.8,
    "text": "不要选带云小图标的"
  },
  {
    "start": 389.8,
    "end": 390.92,
    "text": "都是要订阅的"
  },
  {
    "start": 390.92,
    "end": 392.36,
    "text": "下面带下载图标的"
  },
  {
    "start": 392.36,
    "end": 394.08,
    "text": "可以直接下载到本地"
  },
  {
    "start": 394.08,
    "end": 396.24,
    "text": "如果这里没列出你想要的模型"
  },
  {
    "start": 396.24,
    "end": 398.6,
    "text": "也可以到官网手动下载"
  },
  {
    "start": 398.6,
    "end": 400.72,
    "text": "进入模型页面"
  },
  {
    "start": 400.72,
    "end": 402.92,
    "text": "比如我用签问3.5"
  },
  {
    "start": 402.92,
    "end": 404.72,
    "text": "根据你的显卡型号"
  },
  {
    "start": 404.76,
    "end": 408.48,
    "text": "像我8G显存可以跑个量化9B参数的"
  },
  {
    "start": 408.48,
    "end": 410.28,
    "text": "复制它给的指令"
  },
  {
    "start": 410.28,
    "end": 411.84,
    "text": "新开命令窗口"
  },
  {
    "start": 411.84,
    "end": 414.64,
    "text": "暂停过来下载"
  },
  {
    "start": 414.64,
    "end": 415.6,
    "text": "下载好以后"
  },
  {
    "start": 415.6,
    "end": 418.16,
    "text": "命令窗口和Olama都可以关掉"
  },
  {
    "start": 418.16,
    "end": 421.12,
    "text": "只要系统右下角小图标不要退出就行"
  },
  {
    "start": 421.12,
    "end": 422.76,
    "text": "回到Cloud.上插件"
  },
  {
    "start": 422.76,
    "end": 426.12,
    "text": "这里填写接入本地Olama模型的写法"
  },
  {
    "start": 426.12,
    "end": 428.32,
    "text": "可以直接到我笔记里复制"
  },
  {
    "start": 428.32,
    "end": 429.92,
    "text": "注意这里的模型名称"
  },
  {
    "start": 429.92,
    "end": 433.04,
    "text": "要换成你本地Olama已经下载的模型"
  },
  {
    "start": 433.04,
    "end": 434.96,
    "text": "不知道Olama跑了哪些模型"
  },
  {
    "start": 435.0,
    "end": 436.44,
    "text": "可以打开命令窗口"
  },
  {
    "start": 436.44,
    "end": 438.04,
    "text": "输入Olama List查看"
  },
  {
    "start": 439.52,
    "end": 441.44,
    "text": "如果你平时也用Cloud Code"
  },
  {
    "start": 441.44,
    "end": 442.28,
    "text": "回到上面"
  },
  {
    "start": 442.28,
    "end": 445.08,
    "text": "把加载用户Cloud的设置关掉"
  },
  {
    "start": 445.08,
    "end": 446.44,
    "text": "对话测试一下"
  },
  {
    "start": 446.44,
    "end": 449.64,
    "text": "能正常回复就连上Olama的模型了"
  },
  {
    "start": 449.64,
    "end": 450.6,
    "text": "总结一下"
  },
  {
    "start": 450.6,
    "end": 453.52,
    "text": "这套流程的核心价值不是用AI收稳档"
  },
  {
    "start": 453.52,
    "end": 455.36,
    "text": "而是Agent能像同事一样"
  },
  {
    "start": 455.36,
    "end": 457.64,
    "text": "基于你的知识库帮你写出新东西"
  },
  {
    "start": 457.64,
    "end": 459.4,
    "text": "还给你标好处处"
  },
  {
    "start": 459.4,
    "end": 460.52,
    "text": "我自己用下来"
  },
  {
    "start": 460.52,
    "end": 462.28,
    "text": "这是目前唯一不用写代码"
  },
  {
    "start": 462.28,
    "end": 463.4,
    "text": "不用配数据库"
  },
  {
    "start": 463.44,
    "end": 465.72,
    "text": "纯点点点能跑通的方案"
  },
  {
    "start": 465.72,
    "end": 468.12,
    "text": "如果你想看科研引文研究型"
  },
  {
    "start": 468.12,
    "end": 469.68,
    "text": "或者企业智能温达型"
  },
  {
    "start": 469.68,
    "end": 471.88,
    "text": "可以评论区告诉我下期做哪一个"
  },
  {
    "start": 471.88,
    "end": 473.2,
    "text": "本期用到的所有链接"
  },
  {
    "start": 473.2,
    "end": 474.76,
    "text": "全部在评论区置顶"
  },
  {
    "start": 474.76,
    "end": 475.6,
    "text": "感谢观看"
  },
  {
    "start": 475.6,
    "end": 476.16,
    "text": "下期见"
  }
]