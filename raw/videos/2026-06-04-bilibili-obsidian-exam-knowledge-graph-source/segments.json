[
  {
    "id": 0,
    "start": 0.0,
    "end": 3.2,
    "text": "这是我BugCoding的四点知识图谱插件"
  },
  {
    "id": 1,
    "start": 3.2,
    "end": 6.04,
    "text": "基于备考终极快计的十几场景研制"
  },
  {
    "id": 2,
    "start": 6.04,
    "end": 8.48,
    "text": "知识图谱分为内环和外环"
  },
  {
    "id": 3,
    "start": 8.48,
    "end": 10.0,
    "text": "内环为知识内容"
  },
  {
    "id": 4,
    "start": 10.0,
    "end": 11.32,
    "text": "外环为真体"
  },
  {
    "id": 5,
    "start": 11.32,
    "end": 13.040000000000001,
    "text": "搭配基于卡帕西"
  },
  {
    "id": 6,
    "start": 13.040000000000001,
    "end": 14.36,
    "text": "WM加微体"
  },
  {
    "id": 7,
    "start": 14.36,
    "end": 17.2,
    "text": "以念建立的终极快计知识库"
  },
  {
    "id": 8,
    "start": 17.2,
    "end": 19.84,
    "text": "形成的理论与实践的智慧载体"
  },
  {
    "id": 9,
    "start": 19.84,
    "end": 20.68,
    "text": "想象一下"
  },
  {
    "id": 10,
    "start": 20.68,
    "end": 22.56,
    "text": "如果Ai是一个杠杆"
  },
  {
    "id": 11,
    "start": 22.56,
    "end": 24.96,
    "text": "基于现在的Transformer原理"
  },
  {
    "id": 12,
    "start": 24.96,
    "end": 27.44,
    "text": "普通人不太容易定制这根杠杆"
  },
  {
    "id": 13,
    "start": 27.76,
    "end": 30.16,
    "text": "私有化的知识库就是知点"
  },
  {
    "id": 14,
    "start": 30.16,
    "end": 32.160000000000004,
    "text": "但是根据自己的需求定制"
  },
  {
    "id": 15,
    "start": 32.160000000000004,
    "end": 33.84,
    "text": "这个知点是比较容易的"
  },
  {
    "id": 16,
    "start": 34.72,
    "end": 35.8,
    "text": "而且越实用"
  },
  {
    "id": 17,
    "start": 35.8,
    "end": 38.0,
    "text": "这个知点就会越全面"
  },
  {
    "id": 18,
    "start": 38.0,
    "end": 39.68,
    "text": "回到我们的主题"
  },
  {
    "id": 19,
    "start": 39.68,
    "end": 41.88,
    "text": "终极备考知识库"
  },
  {
    "id": 20,
    "start": 41.88,
    "end": 43.68000000000001,
    "text": "是基于官方教材"
  },
  {
    "id": 21,
    "start": 43.68000000000001,
    "end": 45.96,
    "text": "接着Ai进行拆解"
  },
  {
    "id": 22,
    "start": 45.96,
    "end": 49.84,
    "text": "科利度为每个考点为一个单独文件家"
  },
  {
    "id": 23,
    "start": 49.84,
    "end": 52.68000000000001,
    "text": "每个文件家内包含干活内容"
  },
  {
    "id": 24,
    "start": 52.68000000000001,
    "end": 55.08,
    "text": "自我理解和巩固理体"
  },
  {
    "id": 25,
    "start": 55.08,
    "end": 55.96,
    "text": "干活"
  },
  {
    "id": 26,
    "start": 56.04,
    "end": 59.52,
    "text": "顾名思义就是纯考点知识内容"
  },
  {
    "id": 27,
    "start": 59.52,
    "end": 62.52,
    "text": "理解文件本身为空白"
  },
  {
    "id": 28,
    "start": 62.52,
    "end": 64.84,
    "text": "可以作为自己在不同阶段"
  },
  {
    "id": 29,
    "start": 64.84,
    "end": 66.88,
    "text": "对知识迭代的记录"
  },
  {
    "id": 30,
    "start": 66.88,
    "end": 71.08,
    "text": "例如可以让Ai辅助理解考点内容"
  },
  {
    "id": 31,
    "start": 71.08,
    "end": 74.48,
    "text": "也可以自己把理解写到文件当中"
  },
  {
    "id": 32,
    "start": 74.48,
    "end": 77.72,
    "text": "让Ai判断有哪些理解不足"
  },
  {
    "id": 33,
    "start": 77.72,
    "end": 78.88,
    "text": "或有误的地方"
  },
  {
    "id": 34,
    "start": 79.84,
    "end": 82.72,
    "text": "类似废满学习法的原理"
  },
  {
    "id": 35,
    "start": 82.72,
    "end": 85.28,
    "text": "而这些夯式基础的阶段构成了"
  },
  {
    "id": 36,
    "start": 85.32000000000001,
    "end": 88.68,
    "text": "我们知识图谱当中内环的节点"
  },
  {
    "id": 37,
    "start": 88.68,
    "end": 90.52,
    "text": "基于历年考试真体"
  },
  {
    "id": 38,
    "start": 90.52,
    "end": 92.96000000000001,
    "text": "我们同样进行拆解"
  },
  {
    "id": 39,
    "start": 92.96000000000001,
    "end": 96.8,
    "text": "形成知识图谱当中外环的节点"
  },
  {
    "id": 40,
    "start": 96.8,
    "end": 100.48,
    "text": "并且充分关联到所有相关知识考点"
  },
  {
    "id": 41,
    "start": 100.48,
    "end": 101.6,
    "text": "构建联系"
  },
  {
    "id": 42,
    "start": 101.6,
    "end": 104.36,
    "text": "到此我们依然是对知识内容树立的过程"
  },
  {
    "id": 43,
    "start": 104.36,
    "end": 105.92,
    "text": "考试离不开刷题"
  },
  {
    "id": 44,
    "start": 105.92,
    "end": 108.64,
    "text": "这里我们拿一个判断题掩饰"
  },
  {
    "id": 45,
    "start": 108.64,
    "end": 112.92,
    "text": "真正让Ai参与到我们的学习理解当中的"
  },
  {
    "id": 46,
    "start": 112.96000000000001,
    "end": 116.12,
    "text": "是基于我们建立的真体与考点"
  },
  {
    "id": 47,
    "start": 116.12,
    "end": 119.28,
    "text": "以及考点内部之间的关联关系"
  },
  {
    "id": 48,
    "start": 119.28,
    "end": 123.48,
    "text": "每个外环节点都是一个独立的答题面板"
  },
  {
    "id": 49,
    "start": 123.48,
    "end": 125.68,
    "text": "在我们答完题之后"
  },
  {
    "id": 50,
    "start": 125.68,
    "end": 129.88,
    "text": "工作流对我们的答案进行全面的批改反馈"
  },
  {
    "id": 51,
    "start": 129.88,
    "end": 134.44,
    "text": "并回写记录到我们整理的考点笔记文件当中"
  },
  {
    "id": 52,
    "start": 134.44,
    "end": 138.56,
    "text": "作为干货考点笔记当中的属性进行记录"
  },
  {
    "id": 53,
    "start": 138.56,
    "end": 141.6,
    "text": "并随着我们答题的质量和次数增加"
  },
  {
    "id": 54,
    "start": 141.64,
    "end": 143.51999999999998,
    "text": "进行加权计算"
  },
  {
    "id": 55,
    "start": 143.51999999999998,
    "end": 144.96,
    "text": "合理的反馈出"
  },
  {
    "id": 56,
    "start": 144.96,
    "end": 147.79999999999998,
    "text": "以对该知识考点的掌握程度"
  },
  {
    "id": 57,
    "start": 147.79999999999998,
    "end": 150.56,
    "text": "能够让背考过程直观高效"
  },
  {
    "id": 58,
    "start": 150.56,
    "end": 153.04,
    "text": "并且形成长期积累"
  },
  {
    "id": 59,
    "start": 153.04,
    "end": 156.12,
    "text": "最后简单介绍一下仓库主页"
  },
  {
    "id": 60,
    "start": 156.12,
    "end": 160.07999999999998,
    "text": "主要功能是由热力图和两个入口组成"
  },
  {
    "id": 61,
    "start": 160.07999999999998,
    "end": 162.64,
    "text": "热力图对应每个考点"
  },
  {
    "id": 62,
    "start": 162.64,
    "end": 166.6,
    "text": "热力值的展示依据为考点的某个属性值"
  },
  {
    "id": 63,
    "start": 166.6,
    "end": 169.84,
    "text": "第一个入口是能够直接进入知识图谱界面"
  },
  {
    "id": 64,
    "start": 169.88,
    "end": 171.64000000000001,
    "text": "和正常从左侧变软"
  },
  {
    "id": 65,
    "start": 171.64000000000001,
    "end": 173.76,
    "text": "打开知识图谱插件一样"
  },
  {
    "id": 66,
    "start": 173.76,
    "end": 176.96,
    "text": "第二个入口为官方模考系统"
  },
  {
    "id": 67,
    "start": 176.96,
    "end": 180.84,
    "text": "可以在此架构上根据自己需求再增加"
  },
  {
    "id": 68,
    "start": 180.84,
    "end": 184.12,
    "text": "目前仅完成会计科目的搭建"
  },
  {
    "id": 69,
    "start": 184.12,
    "end": 185.28,
    "text": "想吞后续"
  },
  {
    "id": 70,
    "start": 185.28,
    "end": 187.28,
    "text": "欢迎点赞评论加关注"
  }
]