[
  {
    "start": 0.0,
    "end": 3.44,
    "text": "最强大的 AI 工具往往毁于跨绘画失忆"
  },
  {
    "start": 3.44,
    "end": 4.84,
    "text": "为了解决这个痛点"
  },
  {
    "start": 4.84,
    "end": 7.04,
    "text": "我用 Obsidian 接入 CloudCode"
  },
  {
    "start": 7.04,
    "end": 10.28,
    "text": "打造一个纯本地 零成本的三层记忆系统"
  },
  {
    "start": 10.28,
    "end": 12.28,
    "text": "不用连云 不用跑 API"
  },
  {
    "start": 12.28,
    "end": 14.48,
    "text": "彻底解决 AI 跨绘画断层"
  },
  {
    "start": 14.48,
    "end": 17.4,
    "text": "让它从以自信工具变成愿用愿懂你"
  },
  {
    "start": 17.4,
    "end": 20.08,
    "text": "支持永久保存 灵感实施补货"
  },
  {
    "start": 20.08,
    "end": 22.08,
    "text": "思路永远连续的第二大脑"
  },
  {
    "start": 24.67,
    "end": 26.67,
    "text": "我用 Obsidian 加 CloudCode"
  },
  {
    "start": 26.67,
    "end": 28.47,
    "text": "打造的三层记忆系统"
  },
  {
    "start": 28.47,
    "end": 30.99,
    "text": "本质上是把你的 Obsidian 支持库"
  },
  {
    "start": 31.07,
    "end": 33.83,
    "text": "转化为 CloudCode 的外置神经元"
  },
  {
    "start": 33.83,
    "end": 37.31,
    "text": "通过三层结构模拟人类大脑的记忆回录"
  },
  {
    "start": 37.31,
    "end": 40.55,
    "text": "你的知识库不再只是一个静态的文件家"
  },
  {
    "start": 40.55,
    "end": 43.71,
    "text": "而是被划分为三个功能明确的逻辑分区"
  },
  {
    "start": 43.71,
    "end": 46.15,
    "text": "第一层是长期记忆层"
  },
  {
    "start": 46.15,
    "end": 48.79,
    "text": "它在物理上 就是 Obsidian 里"
  },
  {
    "start": 48.79,
    "end": 51.39,
    "text": "那些你已经整理好的笔记文件家"
  },
  {
    "start": 51.39,
    "end": 55.31,
    "text": "比如你的项目资料 读书笔记 内容脚本"
  },
  {
    "start": 55.31,
    "end": 58.39,
    "text": "但在系统里 它的角色完全不一样"
  },
  {
    "start": 58.43,
    "end": 61.75,
    "text": "它不再是笔记 而是 Cloud 的知识底座"
  },
  {
    "start": 61.75,
    "end": 64.31,
    "text": "就像人脑里的大脑皮层一样"
  },
  {
    "start": 64.31,
    "end": 67.75,
    "text": "所有稳定 结构化 长期有价值的信息"
  },
  {
    "start": 67.75,
    "end": 69.47,
    "text": "全部沉淀在这里"
  },
  {
    "start": 69.47,
    "end": 73.47,
    "text": "你可以理解为 以后 CloudCode 所有输出的认知水平"
  },
  {
    "start": 73.47,
    "end": 75.51,
    "text": "都取决于这一层的质量"
  },
  {
    "start": 75.51,
    "end": 77.91,
    "text": "第二层是汇化记忆层"
  },
  {
    "start": 77.91,
    "end": 79.39,
    "text": "这一层非常关键"
  },
  {
    "start": 79.39,
    "end": 81.11,
    "text": "它专门解决一个问题"
  },
  {
    "start": 81.11,
    "end": 83.07,
    "text": "AI为什么一关就忘"
  },
  {
    "start": 83.07,
    "end": 85.59,
    "text": "答案是 它没有短期记忆"
  },
  {
    "start": 85.59,
    "end": 88.15,
    "text": "所以 我专门给它设计了一个区域"
  },
  {
    "start": 88.23,
    "end": 90.59,
    "text": "一个叫 CloudNamory 的文件家"
  },
  {
    "start": 90.59,
    "end": 93.35,
    "text": "在这里 CloudCode 会实施记录"
  },
  {
    "start": 93.35,
    "end": 98.15,
    "text": "当前对话的思路 临时的灵感 推理过程 决策路径"
  },
  {
    "start": 98.15,
    "end": 100.31,
    "text": "这就相当于人脑的前额页"
  },
  {
    "start": 100.31,
    "end": 102.39,
    "text": "也就是我们的工作记忆"
  },
  {
    "start": 102.39,
    "end": 105.87,
    "text": "它的核心作用只有一个 让思考不中断"
  },
  {
    "start": 105.87,
    "end": 109.19,
    "text": "而更关键的是 这些内容不会浪费"
  },
  {
    "start": 109.19,
    "end": 110.47,
    "text": "在汇化结束后"
  },
  {
    "start": 110.47,
    "end": 115.55,
    "text": "你可以把有价值的内容 直接体验 升级 迁移到第一层"
  },
  {
    "start": 115.63,
    "end": 118.23,
    "text": "第三层 是整个系统最隐形"
  },
  {
    "start": 118.23,
    "end": 121.31,
    "text": "但也是最关键的一层 大脑木路层"
  },
  {
    "start": 121.31,
    "end": 122.63,
    "text": "它就是一个文件"
  },
  {
    "start": 122.63,
    "end": 124.39,
    "text": "Namory.MB"
  },
  {
    "start": 124.39,
    "end": 126.11,
    "text": "但你不要小看这个文件"
  },
  {
    "start": 126.11,
    "end": 129.51,
    "text": "它的作用是 告诉 CloudCode 你是谁"
  },
  {
    "start": 129.51,
    "end": 131.87,
    "text": "你的数据在哪 你该怎么用"
  },
  {
    "start": 131.87,
    "end": 133.51,
    "text": "如果前两层是记忆"
  },
  {
    "start": 133.51,
    "end": 137.11,
    "text": "那这一层就是 导航系统加操作系统"
  },
  {
    "start": 137.11,
    "end": 139.11,
    "text": "每一次 CloudCode 启动"
  },
  {
    "start": 139.11,
    "end": 141.03,
    "text": "它都会先读这个文件"
  },
  {
    "start": 141.03,
    "end": 142.95,
    "text": "然后瞬间完成三件事"
  },
  {
    "start": 142.95,
    "end": 144.63,
    "text": "确认身份 你是谁"
  },
  {
    "start": 144.67,
    "end": 145.75,
    "text": "你在做什么"
  },
  {
    "start": 145.75,
    "end": 148.15,
    "text": "找到长期之时 第一层记忆在哪"
  },
  {
    "start": 148.15,
    "end": 150.83,
    "text": "接上 上一次的思路 第二层在哪"
  },
  {
    "start": 150.83,
    "end": 152.91,
    "text": "本质上 它就是一句话"
  },
  {
    "start": 152.91,
    "end": 154.87,
    "text": "让 AI 从随机对话"
  },
  {
    "start": 154.87,
    "end": 157.31,
    "text": "变成有连续性的工作系统"
  },
  {
    "start": 157.31,
    "end": 159.83,
    "text": "当我们完成这三层架构的部署后"
  },
  {
    "start": 159.83,
    "end": 162.63,
    "text": "CloudCode 的运行逻辑 将发生质变"
  },
  {
    "start": 162.63,
    "end": 164.11,
    "text": "整个流程是这样的"
  },
  {
    "start": 164.11,
    "end": 165.11,
    "text": "每次启动"
  },
  {
    "start": 165.11,
    "end": 167.35,
    "text": "先读 Memory.MB 文件"
  },
  {
    "start": 167.35,
    "end": 168.95,
    "text": "快速定位上下文"
  },
  {
    "start": 168.95,
    "end": 171.67,
    "text": "然后自动从 Layer 移调取长期之时"
  },
  {
    "start": 171.67,
    "end": 174.71,
    "text": "从 Layer 2 读取上次未经的草稿"
  },
  {
    "start": 174.71,
    "end": 176.79,
    "text": "最后再进行思考和输出"
  },
  {
    "start": 176.79,
    "end": 179.03,
    "text": "以及把新内容写回系统"
  },
  {
    "start": 179.03,
    "end": 180.63,
    "text": "这就形成了一个臂环"
  },
  {
    "start": 180.63,
    "end": 183.79,
    "text": "读取 思考 沉淀 再利用"
  },
  {
    "start": 183.79,
    "end": 185.11,
    "text": "所以你会发现"
  },
  {
    "start": 185.11,
    "end": 187.67,
    "text": "这根本不是一个笔记整理方法"
  },
  {
    "start": 187.67,
    "end": 190.07,
    "text": "而是你在做一件更底层的事情"
  },
  {
    "start": 190.07,
    "end": 191.47,
    "text": "把 AI 从工具"
  },
  {
    "start": 191.47,
    "end": 193.83,
    "text": "变成持续进化的认知系统"
  },
  {
    "start": 193.83,
    "end": 195.71,
    "text": "一旦这个结构跑起来之后"
  },
  {
    "start": 195.71,
    "end": 197.87,
    "text": "你的知识不再是散开的"
  },
  {
    "start": 197.87,
    "end": 199.19,
    "text": "而是被调用的"
  },
  {
    "start": 199.19,
    "end": 201.07,
    "text": "你的思路不再是断的"
  },
  {
    "start": 201.11,
    "end": 202.55,
    "text": "而是可延续的"
  },
  {
    "start": 202.55,
    "end": 204.87,
    "text": "你的内容不再是临时产物"
  },
  {
    "start": 204.87,
    "end": 206.87,
    "text": "而是持续积累的资产"
  },
  {
    "start": 206.87,
    "end": 208.39,
    "text": "AI 也就不再是一个"
  },
  {
    "start": 208.39,
    "end": 210.31,
    "text": "每次都要重新交的新人"
  },
  {
    "start": 210.31,
    "end": 213.59,
    "text": "而是一个越用越懂你的长期合伙人"
  },
  {
    "start": 213.59,
    "end": 215.75,
    "text": "接下来我们进入实操"
  },
  {
    "start": 215.75,
    "end": 217.23,
    "text": "带你完成三件事"
  },
  {
    "start": 217.23,
    "end": 219.43,
    "text": "搭建 Obsidian 知识库结构"
  },
  {
    "start": 219.43,
    "end": 221.07,
    "text": "配置三层记忆系统"
  },
  {
    "start": 221.07,
    "end": 226.56,
    "text": "让 Clock Code 真正介入并跑起来"
  },
  {
    "start": 226.56,
    "end": 229.36,
    "text": "首先我们先从最基础的一步开始"
  },
  {
    "start": 229.36,
    "end": 231.6,
    "text": "搭一个属于你的知识仓库"
  },
  {
    "start": 231.6,
    "end": 233.92,
    "text": "打开 Obsidian 点击左下角"
  },
  {
    "start": 233.92,
    "end": 235.12,
    "text": "创建新仓库"
  },
  {
    "start": 235.12,
    "end": 236.44,
    "text": "给它起一个名字"
  },
  {
    "start": 236.44,
    "end": 238.52,
    "text": "然后选择一个存放位置"
  },
  {
    "start": 238.52,
    "end": 239.96,
    "text": "名字你可以随意"
  },
  {
    "start": 239.96,
    "end": 241.04,
    "text": "但我更建议你"
  },
  {
    "start": 241.04,
    "end": 242.8,
    "text": "用一个有长期感的名字"
  },
  {
    "start": 242.8,
    "end": 244.84,
    "text": "比如 My Second Brain"
  },
  {
    "start": 244.84,
    "end": 245.56,
    "text": "当然"
  },
  {
    "start": 245.56,
    "end": 247.92,
    "text": "如果你已经有现成的本地文件家"
  },
  {
    "start": 247.92,
    "end": 249.72,
    "text": "也可以直接在 Obsidian 里"
  },
  {
    "start": 249.72,
    "end": 250.6,
    "text": "把它打开"
  },
  {
    "start": 250.6,
    "end": 252.48,
    "text": "当做你的仓库来用"
  },
  {
    "start": 252.48,
    "end": 253.56,
    "text": "这个文件家"
  },
  {
    "start": 253.56,
    "end": 254.76,
    "text": "从这一刻开始"
  },
  {
    "start": 254.76,
    "end": 257.24,
    "text": "它就是你的认知资产仓库"
  },
  {
    "start": 257.24,
    "end": 259.36,
    "text": "你之后所有重要的知识"
  },
  {
    "start": 259.36,
    "end": 260.6,
    "text": "思考 内容"
  },
  {
    "start": 260.6,
    "end": 262.4,
    "text": "都会慢慢沉淀到这里"
  },
  {
    "start": 262.4,
    "end": 263.16,
    "text": "接下来"
  },
  {
    "start": 263.16,
    "end": 264.6,
    "text": "我们进入第二步"
  },
  {
    "start": 264.6,
    "end": 266.8,
    "text": "在我们刚创建的知识仓库中"
  },
  {
    "start": 266.8,
    "end": 268.88,
    "text": "建立三层记忆结构"
  },
  {
    "start": 268.88,
    "end": 270.44,
    "text": "前面我们已经讲过"
  },
  {
    "start": 270.44,
    "end": 271.72,
    "text": "这套系统的核心"
  },
  {
    "start": 271.72,
    "end": 273.6,
    "text": "就是把你的 Obsidian 仓库"
  },
  {
    "start": 273.6,
    "end": 274.84,
    "text": "划分成三层"
  },
  {
    "start": 274.84,
    "end": 275.56,
    "text": "Layer 1"
  },
  {
    "start": 275.56,
    "end": 276.76,
    "text": "永久记忆层"
  },
  {
    "start": 276.76,
    "end": 279.52,
    "text": "存放你长期重要知识的笔记文件家"
  },
  {
    "start": 279.52,
    "end": 280.28,
    "text": "Layer 2"
  },
  {
    "start": 280.28,
    "end": 281.44,
    "text": "绘画记忆层"
  },
  {
    "start": 281.44,
    "end": 283.84,
    "text": "一个专门的 Cloud Memory 文件家"
  },
  {
    "start": 283.84,
    "end": 284.64,
    "text": "Layer 3"
  },
  {
    "start": 284.64,
    "end": 285.8,
    "text": "路由所隐藏"
  },
  {
    "start": 285.8,
    "end": 287.24,
    "text": "一个名为 Memory"
  },
  {
    "start": 287.24,
    "end": 289.04,
    "text": "MD 的核心文件"
  },
  {
    "start": 289.04,
    "end": 290.92,
    "text": "当你理解了这个结构之后"
  },
  {
    "start": 290.92,
    "end": 293.2,
    "text": "实际搭建就非常简单了"
  },
  {
    "start": 293.2,
    "end": 295.16,
    "text": "我以自己的知识仓库为例"
  },
  {
    "start": 295.16,
    "end": 296.6,
    "text": "给大家演示"
  },
  {
    "start": 296.6,
    "end": 298.2,
    "text": "现在屏幕上看到的"
  },
  {
    "start": 298.2,
    "end": 300.08,
    "text": "就是我的 Obsidian 仓库"
  },
  {
    "start": 300.08,
    "end": 301.84,
    "text": "它的整体结构是这样的"
  },
  {
    "start": 301.84,
    "end": 304.28,
    "text": "首先是Layer 1 永久记忆层"
  },
  {
    "start": 304.28,
    "end": 306.28,
    "text": "它又以下五个文件家组成"
  },
  {
    "start": 306.28,
    "end": 307.24,
    "text": "Context"
  },
  {
    "start": 307.24,
    "end": 308.68,
    "text": "存放我的个人身份"
  },
  {
    "start": 308.68,
    "end": 309.68,
    "text": "品牌定位"
  },
  {
    "start": 309.68,
    "end": 310.6,
    "text": "用户画像"
  },
  {
    "start": 310.6,
    "end": 312.28,
    "text": "和核心偏好规则"
  },
  {
    "start": 312.28,
    "end": 313.44,
    "text": "这是 Cloud Code"
  },
  {
    "start": 313.44,
    "end": 315.48,
    "text": "最需要了解的关于我的信息"
  },
  {
    "start": 315.48,
    "end": 316.32,
    "text": "Clipings"
  },
  {
    "start": 316.32,
    "end": 318.52,
    "text": "收集我从网络检查的文章"
  },
  {
    "start": 318.52,
    "end": 320.24,
    "text": "网页等原始素材"
  },
  {
    "start": 320.24,
    "end": 321.04,
    "text": "Script"
  },
  {
    "start": 321.04,
    "end": 322.68,
    "text": "存放所有的视频脚本"
  },
  {
    "start": 322.68,
    "end": 323.84,
    "text": "和教程资料"
  },
  {
    "start": 323.84,
    "end": 324.44,
    "text": "Dali"
  },
  {
    "start": 324.44,
    "end": 325.32,
    "text": "日常记录"
  },
  {
    "start": 325.32,
    "end": 326.88,
    "text": "和每日灵感捕捉"
  },
  {
    "start": 326.88,
    "end": 327.6,
    "text": "Reading"
  },
  {
    "start": 327.6,
    "end": 328.64,
    "text": "书记画线"
  },
  {
    "start": 328.64,
    "end": 329.52,
    "text": "读书笔记"
  },
  {
    "start": 329.52,
    "end": 330.96,
    "text": "和深度思考"
  },
  {
    "start": 330.96,
    "end": 332.04,
    "text": "这些文件家"
  },
  {
    "start": 332.04,
    "end": 334.52,
    "text": "共同构成了知识库的长期根基"
  },
  {
    "start": 334.52,
    "end": 335.8,
    "text": "所有重要的内容"
  },
  {
    "start": 335.8,
    "end": 337.8,
    "text": "最终都会沉淀在这里"
  },
  {
    "start": 337.8,
    "end": 338.68,
    "text": "接下来是"
  },
  {
    "start": 338.68,
    "end": 339.44,
    "text": "Layer 2"
  },
  {
    "start": 339.44,
    "end": 340.56,
    "text": "绘画记忆层"
  },
  {
    "start": 340.56,
    "end": 342.32,
    "text": "Cloud Memory 文件家"
  },
  {
    "start": 342.32,
    "end": 343.68,
    "text": "这个文件家的作用"
  },
  {
    "start": 343.68,
    "end": 344.44,
    "text": "相当于"
  },
  {
    "start": 344.44,
    "end": 345.88,
