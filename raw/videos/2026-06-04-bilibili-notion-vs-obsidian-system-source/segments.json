[
  {
    "id": 0,
    "start": 0.0,
    "end": 1.12,
    "text": "如果你现在还在纠结"
  },
  {
    "id": 1,
    "start": 1.12,
    "end": 2.68,
    "text": "notion和obsceding到底选难"
  },
  {
    "id": 2,
    "start": 2.68,
    "end": 3.84,
    "text": "我先直接说结论"
  },
  {
    "id": 3,
    "start": 3.84,
    "end": 5.16,
    "text": "大度受人真正缺的"
  },
  {
    "id": 4,
    "start": 5.16,
    "end": 5.88,
    "text": "不是工具"
  },
  {
    "id": 5,
    "start": 5.88,
    "end": 6.68,
    "text": "而是一套系统"
  },
  {
    "id": 6,
    "start": 6.68,
    "end": 7.92,
    "text": "很多人一开始会觉得"
  },
  {
    "id": 7,
    "start": 7.92,
    "end": 9.040000000000001,
    "text": "是不是我用了notion"
  },
  {
    "id": 8,
    "start": 9.040000000000001,
    "end": 11.200000000000001,
    "text": "就能把生活和工作管理好"
  },
  {
    "id": 9,
    "start": 11.200000000000001,
    "end": 12.68,
    "text": "或者说我换成obsceding"
  },
  {
    "id": 10,
    "start": 12.68,
    "end": 14.64,
    "text": "知识管理就能突然开巧"
  },
  {
    "id": 11,
    "start": 14.64,
    "end": 15.84,
    "text": "但是现实通常是"
  },
  {
    "id": 12,
    "start": 15.84,
    "end": 17.6,
    "text": "你的工具换了一个又一个"
  },
  {
    "id": 13,
    "start": 17.6,
    "end": 19.2,
    "text": "笔记记得越来越多"
  },
  {
    "id": 14,
    "start": 19.2,
    "end": 21.44,
    "text": "生活工作学习还是照样乱"
  },
  {
    "id": 15,
    "start": 21.44,
    "end": 22.68,
    "text": "那这到底是为什么呢"
  },
  {
    "id": 16,
    "start": 22.68,
    "end": 25.240000000000002,
    "text": "因为问题根本就不在于工具本身"
  },
  {
    "id": 17,
    "start": 25.240000000000002,
    "end": 28.12,
    "text": "而是在于你没有一套稳定的结构"
  },
  {
    "id": 18,
    "start": 28.2,
    "end": 30.96,
    "text": "去管理你每天接触到的信息任务项目"
  },
  {
    "id": 19,
    "start": 30.96,
    "end": 33.76,
    "text": "还有那些你想长期推进的事情"
  },
  {
    "id": 20,
    "start": 33.76,
    "end": 35.44,
    "text": "你表面上是在选工级"
  },
  {
    "id": 21,
    "start": 35.44,
    "end": 36.44,
    "text": "但是很多时候"
  },
  {
    "id": 22,
    "start": 36.44,
    "end": 38.88,
    "text": "你其实是在逃遍一件更困难的事情"
  },
  {
    "id": 23,
    "start": 38.88,
    "end": 41.400000000000006,
    "text": "你到底要怎么组织自己的人生呢"
  },
  {
    "id": 24,
    "start": 41.400000000000006,
    "end": 43.2,
    "text": "我自己以前也经历过这个阶段"
  },
  {
    "id": 25,
    "start": 43.2,
    "end": 44.16,
    "text": "notion我用过很久"
  },
  {
    "id": 26,
    "start": 44.16,
    "end": 45.44,
    "text": "obsceding也折腾过"
  },
  {
    "id": 27,
    "start": 45.44,
    "end": 46.6,
    "text": "很久后来我发现"
  },
  {
    "id": 28,
    "start": 46.6,
    "end": 48.72,
    "text": "这两个工具根本就不是一个维度的问题"
  },
  {
    "id": 29,
    "start": 48.72,
    "end": 49.36,
    "text": "在我看来"
  },
  {
    "id": 30,
    "start": 49.36,
    "end": 51.64,
    "text": "notion它是更适合做组织和管理"
  },
  {
    "id": 31,
    "start": 51.64,
    "end": 53.480000000000004,
    "text": "比如说项目推进任务追踪"
  },
  {
    "id": 32,
    "start": 53.480000000000004,
    "end": 54.72,
    "text": "工作流生活管理"
  },
  {
    "id": 33,
    "start": 54.72,
    "end": 56.36,
    "text": "它第一个是结构清晰"
  },
  {
    "id": 34,
    "start": 56.36,
    "end": 57.400000000000006,
    "text": "上手直接"
  },
  {
    "id": 35,
    "start": 57.44,
    "end": 59.68,
    "text": "尤其适合把事情推下去"
  },
  {
    "id": 36,
    "start": 59.68,
    "end": 61.839999999999996,
    "text": "obsceding更适合做思考和沉淀"
  },
  {
    "id": 37,
    "start": 61.839999999999996,
    "end": 63.32,
    "text": "比如说鞋笔及技灵感"
  },
  {
    "id": 38,
    "start": 63.32,
    "end": 65.08,
    "text": "搭置库做内容创作"
  },
  {
    "id": 39,
    "start": 65.08,
    "end": 68.52,
    "text": "它更像是一个适合深度思考和长期积累的地方"
  },
  {
    "id": 40,
    "start": 68.52,
    "end": 71.96,
    "text": "所以如果你问我notion和obsceding到底怎么选呢"
  },
  {
    "id": 41,
    "start": 71.96,
    "end": 74.6,
    "text": "我的答案是先别着急选工具"
  },
  {
    "id": 42,
    "start": 74.6,
    "end": 76.12,
    "text": "先搞清楚你的系统"
  },
  {
    "id": 43,
    "start": 76.12,
    "end": 77.52,
    "text": "因为如果你没有系统"
  },
  {
    "id": 44,
    "start": 77.52,
    "end": 81.0,
    "text": "你用notion最后可能只是做了一个更漂亮的杂物间"
  },
  {
    "id": 45,
    "start": 81.0,
    "end": 84.64,
    "text": "你用obsceding也可能只是多了一个更高级的笔记仓库"
  },
  {
    "id": 46,
    "start": 84.64,
    "end": 86.03999999999999,
    "text": "真正让我稳定下来"
  },
  {
    "id": 47,
    "start": 86.08000000000001,
    "end": 87.84,
    "text": "不是选对了某一个软件"
  },
  {
    "id": 48,
    "start": 87.84,
    "end": 90.80000000000001,
    "text": "而是我一开始就用一套固定的结构"
  },
  {
    "id": 49,
    "start": 90.80000000000001,
    "end": 91.96000000000001,
    "text": "去整理工作"
  },
  {
    "id": 50,
    "start": 91.96000000000001,
    "end": 92.92,
    "text": "学习还有生活"
  },
  {
    "id": 51,
    "start": 92.92,
    "end": 96.0,
    "text": "我现在主要用的是PARA这套思路"
  },
  {
    "id": 52,
    "start": 96.0,
    "end": 96.64,
    "text": "很简单"
  },
  {
    "id": 53,
    "start": 96.64,
    "end": 98.4,
    "text": "它不是让你记得更多"
  },
  {
    "id": 54,
    "start": 98.4,
    "end": 101.64,
    "text": "而是让你把东西放到正确的位置上面"
  },
  {
    "id": 55,
    "start": 101.64,
    "end": 104.0,
    "text": "project就是你现在正在推进的事情"
  },
  {
    "id": 56,
    "start": 104.0,
    "end": 106.60000000000001,
    "text": "arid就是你长期要负责的部分"
  },
  {
    "id": 57,
    "start": 106.60000000000001,
    "end": 107.48,
    "text": "比如说工作"
  },
  {
    "id": 58,
    "start": 107.48,
    "end": 108.08000000000001,
    "text": "健康"
  },
  {
    "id": 59,
    "start": 108.08000000000001,
    "end": 108.52000000000001,
    "text": "学习"
  },
  {
    "id": 60,
    "start": 108.52000000000001,
    "end": 108.80000000000001,
    "text": "内容"
  },
  {
    "id": 61,
    "start": 108.80000000000001,
    "end": 109.48,
    "text": "创作"
  },
  {
    "id": 62,
    "start": 109.48,
    "end": 112.4,
    "text": "resources就是你暂时先存着"
  },
  {
    "id": 63,
    "start": 112.4,
    "end": 114.36000000000001,
    "text": "以后可能会用到的资料"
  },
  {
    "id": 64,
    "start": 114.4,
    "end": 116.48,
    "text": "而且就是已经完成"
  },
  {
    "id": 65,
    "start": 116.48,
    "end": 119.2,
    "text": "暂时退出当前视野的内容"
  },
  {
    "id": 66,
    "start": 119.2,
    "end": 120.96,
    "text": "这套东西真正有用一点点"
  },
  {
    "id": 67,
    "start": 120.96,
    "end": 124.16,
    "text": "就在于它会让你的记录慢慢的变成行动"
  },
  {
    "id": 68,
    "start": 124.16,
    "end": 126.88,
    "text": "比如以前有很多人的最大问题不是不努力"
  },
  {
    "id": 69,
    "start": 126.88,
    "end": 128.72,
    "text": "而是所有的东西都混在一起"
  },
  {
    "id": 70,
    "start": 128.72,
    "end": 130.0,
    "text": "灵感混在任务里"
  },
  {
    "id": 71,
    "start": 130.0,
    "end": 131.36,
    "text": "任务混在资料里"
  },
  {
    "id": 72,
    "start": 131.36,
    "end": 132.8,
    "text": "资料混在目标里"
  },
  {
    "id": 73,
    "start": 132.8,
    "end": 134.48,
    "text": "结果就是脑子一直很满"
  },
  {
    "id": 74,
    "start": 134.48,
    "end": 136.07999999999998,
    "text": "但是人始终推不动"
  },
  {
    "id": 75,
    "start": 136.07999999999998,
    "end": 138.32,
    "text": "当你开始按系统去放这些东西的时候"
  },
  {
    "id": 76,
    "start": 138.32,
    "end": 140.8,
    "text": "你会发现大脑突然清了"
  },
  {
    "id": 77,
    "start": 140.8,
    "end": 143.2,
    "text": "你知道什么是现在要推进的"
  },
  {
    "id": 78,
    "start": 143.2,
    "end": 144.79999999999998,
    "text": "什么是以后再看的"
  },
  {
    "id": 79,
    "start": 144.79999999999998,
    "end": 146.32,
    "text": "什么是需要长期维护的"
  },
  {
    "id": 80,
    "start": 146.32,
    "end": 148.83999999999997,
    "text": "这个时候工具才开始真正的发挥作用"
  },
  {
    "id": 81,
    "start": 148.83999999999997,
    "end": 153.44,
    "text": "所以如果你现在还在Obsidian或是Notion之间反复的很挑"
  },
  {
    "id": 82,
    "start": 153.44,
    "end": 155.95999999999998,
    "text": "我的建议是不要先问哪一个更强"
  },
  {
    "id": 83,
    "start": 155.95999999999998,
    "end": 156.83999999999997,
    "text": "先问自己"
  },
  {
    "id": 84,
    "start": 156.83999999999997,
    "end": 160.92,
    "text": "你有没有一套能让你持续行动的结构"
  },
  {
    "id": 85,
    "start": 160.92,
    "end": 162.35999999999999,
    "text": "工具只是载体"
  },
  {
    "id": 86,
    "start": 162.35999999999999,
    "end": 167.95999999999998,
    "text": "系统才是决定你到底能不能把生活工作和学习真正的管起来"
  },
  {
    "id": 87,
    "start": 167.95999999999998,
    "end": 170.95999999999998,
    "text": "如果你也有过工具越还越多"
  },
  {
    "id": 88,
    "start": 170.95999999999998,
    "end": 172.6,
    "text": "但是人还是很乱的阶段"
  },
  {
    "id": 89,
    "start": 172.68,
    "end": 174.12,
    "text": "平时去打一个系统"
  },
  {
    "id": 90,
    "start": 174.12,
    "end": 176.28,
    "text": "我下期呢就会直接拆解使操"
  },
  {
    "id": 91,
    "start": 176.28,
    "end": 178.96,
    "text": "这就是这期所有的我们下个视频再见了"
  },
  {
    "id": 92,
    "start": 178.96,
    "end": 179.48,
    "text": "Peace out"
  },
  {
    "id": 93,
    "start": 179.48,
    "end": 179.96,
    "text": "拜拜"
  }
]