  "segments": [
    {
      "start": 7.76,
      "end": 11.82,
      "text": "JSNOW是一款面向個人與企業的AI原生穩當的協作平臺"
    },
    {
      "start": 11.82,
      "end": 14.84,
      "text": "它將純本編輯實施多人協同支持庫管理"
    },
    {
      "start": 14.84,
      "end": 16.68,
      "text": "與AI智能體深度融合"
    },
    {
      "start": 16.68,
      "end": 18.88,
      "text": "構建從穩當創作到知識沈電"
    },
    {
      "start": 18.88,
      "end": 21.08,
      "text": "再到智能問答的完整閉環"
    },
    {
      "start": 21.8,
      "end": 23.44,
      "text": "市面上的支庫有很多"
    },
    {
      "start": 23.44,
      "end": 24.84,
      "text": "但企業真正怕的是三件事"
    },
    {
      "start": 24.84,
      "end": 26.68,
      "text": "數據泄露回答不准機身困難"
    },
    {
      "start": 26.68,
      "end": 28.8,
      "text": "JSNOW支庫有三個核心優勢"
    },
    {
      "start": 28.8,
      "end": 30.8,
      "text": "第一個是支持企業四五花布署"
    },
    {
      "start": 30.8,
      "end": 32.2,
      "text": "保證數據的絕對安全"
    },
    {
      "start": 32.2,
      "end": 33.92,
      "text": "第二個就是精準的IG"
    },
    {
      "start": 33.92,
      "end": 35.28,
      "text": "拒絕模型換絕"
    },
    {
      "start": 35.28,
      "end": 37.04,
      "text": "第三個就是開放API"
    },
    {
      "start": 37.32,
      "end": 39.56,
      "text": "無縫即使到寫的內部系統並支持二開"
    },
    {
      "start": 40.76,
      "end": 42.56,
      "text": "下面我從多格式解析"
    },
    {
      "start": 42.56,
      "end": 44.68,
      "text": "強納的文囊編輯和AI智能創作能力"
    },
    {
      "start": 44.68,
      "end": 45.64,
      "text": "IG支持檢鎖"
    },
    {
      "start": 45.64,
      "end": 46.28,
      "text": "智能問答"
    },
    {
      "start": 46.28,
      "end": 48.16,
      "text": "常經引擎可刷 Agents編排"
    },
    {
      "start": 48.16,
      "end": 49.2,
      "text": "MCP服務"
    },
    {
      "start": 49.2,
      "end": 50.36,
      "text": "企業多集管理"
    },
    {
      "start": 50.36,
      "end": 51.24,
      "text": "這幾個核心模塊"
    },
    {
      "start": 51.24,
      "end": 52.4,
      "text": "詳細給大家介紹一下"
    },
    {
      "start": 54.24,
      "end": 55.72,
      "text": "首先是多格式解析"
    },
    {
      "start": 55.72,
      "end": 57.2,
      "text": "我們可以把P.I.服務的"
    },
    {
      "start": 57.2,
      "end": 57.96,
      "text": "MAC檔網頁"
    },
    {
      "start": 57.96,
      "end": 59.64,
      "text": "甚至電影表格一一拖賺進來"
    },
    {
      "start": 59.64,
      "end": 60.88,
      "text": "它會自動解析文囊結構"
    },
    {
      "start": 60.88,
      "end": 62.64,
      "text": "並分片存出到香涼數據庫"
    },
    {
      "start": 62.64,
      "end": 64.84,
      "text": "實現文囊資產的精準文大和分析"
    },
    {
      "start": 65.04,
      "end": 66.76,
      "text": "下一個是強大的文囊編輯"
    },
    {
      "start": 66.76,
      "end": 68.16,
      "text": "和AI智能創作能力"
    },
    {
      "start": 68.16,
      "end": 70.08,
      "text": "我們不僅能上傳解續運檔"
    },
    {
      "start": 70.08,
      "end": 71.96,
      "text": "還能線上多人實施寫通編輯"
    },
    {
      "start": 71.96,
      "end": 73.32,
      "text": "並進行AI創作"
    },
    {
      "start": 73.32,
      "end": 74.6,
      "text": "同時還能繼續文囊"
    },
    {
      "start": 74.6,
      "end": 76.12,
      "text": "內容一件深層支持出譜"
    },
    {
      "start": 77.04,
      "end": 78.68,
      "text": "其次是IG支持檢鎖"
    },
    {
      "start": 78.68,
      "end": 81.24,
      "text": "我們實現了IG內容檢鎖引擎"
    },
    {
      "start": 81.24,
      "end": 82.84,
      "text": "以前文囊散落在各個角落"
    },
    {
      "start": 82.84,
      "end": 83.84,
      "text": "差到效率很低"
    },
    {
      "start": 83.84,
      "end": 85.36,
      "text": "現在我們可以根據關鍵詞"
    },
    {
      "start": 85.36,
      "end": 86.4,
      "text": "對文囊內容金檢鎖"
    },
    {
      "start": 86.4,
      "end": 87.84,
      "text": "輕鬆定位到文囊的位置"
    },
    {
      "start": 87.84,
      "end": 89.32,
      "text": "同時還能一件進行文囊"
    },
    {
      "start": 90.56,
      "end": 92.04,
      "text": "然後是智能問答"
    },
    {
      "start": 92.04,
      "end": 94.28,
      "text": "我們可以基於不同的內容空間"
    },
    {
      "start": 94.44,
      "end": 96.56,
      "text": "進行AI問答就像專屬過問一樣"
    },
    {
      "start": 96.56,
      "end": 97.92,
      "text": "支持多人對話"
    },
    {
      "start": 97.92,
      "end": 99.56,
      "text": "回答內容會附在"
    },
    {
      "start": 99.56,
      "end": 102.08,
      "text": "語言出數和追數不換決"
    },
    {
      "start": 102.08,
      "end": 103.68,
      "text": "這也是場景引擎"
    },
    {
      "start": 103.68,
      "end": 106.44,
      "text": "我們可以配置AI回答的風格方式"
    },
    {
      "start": 106.44,
      "end": 107.72,
      "text": "並進行更高級的AI設置"
    },
    {
      "start": 107.72,
      "end": 108.8,
      "text": "比如說安全互懶"
    },
    {
      "start": 108.8,
      "end": 109.92,
      "text": "大國型調餐"
    },
    {
      "start": 109.92,
      "end": 110.96,
      "text": "局勢編輯等"
    },
    {
      "start": 110.96,
      "end": 113.84,
      "text": "實現更深度可控的AI內容輸出"
    },
    {
      "start": 113.84,
      "end": 114.76,
      "text": "下一個是可說"
    },
    {
      "start": 114.76,
      "end": 115.64,
      "text": "IG ins 編排能力"
    },
    {
      "start": 115.64,
      "end": 116.96,
      "text": "我們可以通過拖拽的方式"
    },
    {
      "start": 116.96,
      "end": 119.0,
      "text": "搭建自己的AI知識指能體"
    },
    {
      "start": 119.0,
      "end": 121.76,
      "text": "讓IG ins 搭建更靈活高效"
    },
    {
      "start": 121.76,
      "end": 123.24,
      "text": "下面是MP符"
    },
    {
      "start": 123.28,
      "end": 125.44,
      "text": "我們提供了對外殼調檔MP符"
    },
    {
      "start": 125.44,
      "end": 127.24,
      "text": "可以實現更符雜的業務接口"
    },
    {
      "start": 127.24,
      "end": 129.28,
      "text": "配置實現符雜的AI中化能力"
    },
    {
      "start": 130.2,
      "end": 131.28,
      "text": "最後是"
    },
    {
      "start": 131.28,
      "end": 133.44,
      "text": "我們最核心的企業管理模塊"
    },
    {
      "start": 133.44,
      "end": 134.48,
      "text": "包括企業知識庫"
    },
    {
      "start": 134.48,
      "end": 135.32,
      "text": "組織部門管理"
    },
    {
      "start": 135.32,
      "end": 136.12,
      "text": "文囊全線管理"
    },
    {
      "start": 136.12,
      "end": 137.8,
      "text": "和AI知識大腦"
    },
    {
      "start": 137.8,
      "end": 138.8,
      "text": "切換到企業工作台"
    },
    {
      "start": 138.8,
      "end": 141.48,
      "text": "我們可以輕鬆創建屬於自己的組織部門"
    },
    {
      "start": 141.48,
      "end": 143.0,
      "text": "和角色全線控制"
    },
    {
      "start": 143.0,
      "end": 144.0,
      "text": "精準管理文囊"
    },
    {
      "start": 144.0,
      "end": 146.08,
      "text": "支持資產保證文囊的數據安全"
    },
    {
      "start": 147.08,
      "end": 148.52,
      "text": "我們可以把技術鬥制庫"
    },
    {
      "start": 148.52,
      "end": 150.92,
      "text": "應用在企業的智能客服"
    },
    {
      "start": 150.92,
      "end": 152.04,
      "text": "企業智中臺"
    },
    {
      "start": 152.04,
      "end": 153.92,
      "text": "銷售負能 智能檔案"
    },
    {
      "start": 153.92,
      "end": 155.44,
      "text": "醫療知識庫"
    },
    {
      "start": 155.44,
      "end": 156.76,
      "text": "等相關領域"
    },
    {
      "start": 156.76,
      "end": 158.64,
      "text": "來提高知識管理的效率"
    },
    {
      "start": 159.64,
      "end": 161.36,
      "text": "後面我們會持續更新激死"
    },
    {
      "start": 161.36,
      "end": 162.24,
      "text": "弄AI知識庫"
    },
    {
      "start": 162.24,
      "end": 163.28,
      "text": "打造出更智能"
    },
    {
      "start": 163.28,
      "end": 165.84,
      "text": "更強大的AI知識管理中臺"
    },
    {
      "start": 165.84,
      "end": 167.16,
      "text": "如果大家有好的建議"
    },
    {
      "start": 167.16,
      "end": 167.92,
      "text": "或想法"
    },
    {
      "start": 167.92,
      "end": 169.92,
      "text": "也歡迎隨時評論去交流反饋"
    }
  ]
