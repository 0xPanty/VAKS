[
  {
    "start": 0.0,
    "end": 2.0,
    "text": "今天的目标是手法手带大家在敌贩中"
  },
  {
    "start": 2.0,
    "end": 4.08,
    "text": "搭建一个基于REJ的支持库DEMO"
  },
  {
    "start": 4.08,
    "end": 5.36,
    "text": "目前的这个企业支持库DEMO"
  },
  {
    "start": 5.36,
    "end": 6.84,
    "text": "他所回答的所有问题都是基于"
  },
  {
    "start": 6.84,
    "end": 8.84,
    "text": "我给他的文档进行回答的"
  },
  {
    "start": 8.84,
    "end": 10.8,
    "text": "比如说原始文档是这个"
  },
  {
    "start": 10.8,
    "end": 11.76,
    "text": "我们问他一个问题"
  },
  {
    "start": 11.76,
    "end": 13.16,
    "text": "系统用哪几类组件"
  },
  {
    "start": 13.16,
    "end": 14.92,
    "text": "我们测试一下他能否回答成功"
  },
  {
    "start": 14.92,
    "end": 16.04,
    "text": "基本组件 数据组件"
  },
  {
    "start": 16.04,
    "end": 17.04,
    "text": "媒体组件 高级组件"
  },
  {
    "start": 17.04,
    "end": 18.2,
    "text": "如果你对这个小DEMO感兴趣"
  },
  {
    "start": 18.2,
    "end": 19.08,
    "text": "可以继续往后看"
  },
  {
    "start": 19.08,
    "end": 19.76,
    "text": "我先声明一下"
  },
  {
    "start": 19.76,
    "end": 21.0,
    "text": "我是一个技术小白旗"
  },
  {
    "start": 21.0,
    "end": 21.72,
    "text": "不会写代码"
  },
  {
    "start": 21.72,
    "end": 24.28,
    "text": "敌贩和REJ也是我刚接触的内容"
  },
  {
    "start": 24.36,
    "end": 26.08,
    "text": "所以本视频全程都会站在一个"
  },
  {
    "start": 26.08,
    "end": 27.28,
    "text": "零基础小白的角度"
  },
  {
    "start": 27.28,
    "end": 28.12,
    "text": "去为大家讲解"
  },
  {
    "start": 28.12,
    "end": 30.72,
    "text": "好 我们首先非常快速的回顾一下"
  },
  {
    "start": 30.72,
    "end": 32.24,
    "text": "REJ的一些基本的要点"
  },
  {
    "start": 32.24,
    "end": 34.16,
    "text": "我们知道为什么需要REJ是因为"
  },
  {
    "start": 34.16,
    "end": 36.24,
    "text": "大模型它会存在一些支持过时"
  },
  {
    "start": 36.24,
    "end": 38.24,
    "text": "或者我们的私有数据大模型也没有的情况"
  },
  {
    "start": 38.24,
    "end": 39.96,
    "text": "所以就需要把我们的私有的文档"
  },
  {
    "start": 39.96,
    "end": 40.84,
    "text": "给大员模型"
  },
  {
    "start": 40.84,
    "end": 42.16,
    "text": "让它去检索我们的资料"
  },
  {
    "start": 42.16,
    "end": 43.32,
    "text": "根据我们的资料去生成答案"
  },
  {
    "start": 43.32,
    "end": 44.64,
    "text": "REJ它的核心流程是有两个"
  },
  {
    "start": 44.64,
    "end": 46.36,
    "text": "第一个是数据准备阶段"
  },
  {
    "start": 46.36,
    "end": 47.44,
    "text": "第二个是用户体问阶段"
  },
  {
    "start": 47.44,
    "end": 48.64,
    "text": "首先我们需要有一个文档"
  },
  {
    "start": 48.64,
    "end": 49.4,
    "text": "但这个文档太大了"
  },
  {
    "start": 49.4,
    "end": 50.76,
    "text": "我们需要切分成chunk"
  },
  {
    "start": 50.8,
    "end": 51.8,
    "text": "切成一块一块的"
  },
  {
    "start": 51.8,
    "end": 53.76,
    "text": "可以按照章节 段落 字符等等"
  },
  {
    "start": 53.76,
    "end": 54.32,
    "text": "去划分"
  },
  {
    "start": 54.32,
    "end": 55.24,
    "text": "切成的这一块"
  },
  {
    "start": 55.24,
    "end": 57.28,
    "text": "每一块它的语义要相对完整一点"
  },
  {
    "start": 57.28,
    "end": 58.6,
    "text": "不能是说章三是个好人"
  },
  {
    "start": 58.6,
    "end": 59.6,
    "text": "我把章三给隔开了"
  },
  {
    "start": 59.6,
    "end": 60.84,
    "text": "完了不知道这个好人是谁了"
  },
  {
    "start": 60.84,
    "end": 61.72,
    "text": "等等类似这样的情况"
  },
  {
    "start": 61.72,
    "end": 62.24,
    "text": "切成块之后"
  },
  {
    "start": 62.24,
    "end": 63.76,
    "text": "我们需要进行Inviting项量化"
  },
  {
    "start": 63.76,
    "end": 64.84,
    "text": "也就是把每一块的文本"
  },
  {
    "start": 64.84,
    "end": 66.0,
    "text": "转换成对应的项量"
  },
  {
    "start": 66.0,
    "end": 67.44,
    "text": "项量我们可以把它想象成"
  },
  {
    "start": 67.44,
    "end": 69.36,
    "text": "XY坐标主上的坐标"
  },
  {
    "start": 69.36,
    "end": 70.96,
    "text": "每一块语义都对应一个坐标点"
  },
  {
    "start": 70.96,
    "end": 71.96,
    "text": "存放的项量数据库"
  },
  {
    "start": 71.96,
    "end": 73.24,
    "text": "这就是我们的数据准备阶段"
  },
  {
    "start": 73.24,
    "end": 74.24,
    "text": "然后到用户提问阶段"
  },
  {
    "start": 74.24,
    "end": 75.04,
    "text": "比如说用户问"
  },
  {
    "start": 75.04,
    "end": 76.2,
    "text": "章三是谁这个问题"
  },
  {
    "start": 76.2,
    "end": 78.68,
    "text": "首先这个问题也是要给它进行Inviting项量化的"
  },
  {
    "start": 78.68,
    "end": 80.48,
    "text": "像速度检索是将这个问题"
  },
  {
    "start": 80.48,
    "end": 81.56,
    "text": "章三是谁这个项量"
  },
  {
    "start": 81.56,
    "end": 83.04,
    "text": "和我们存放在项量数据库"
  },
  {
    "start": 83.04,
    "end": 84.2,
    "text": "也就是这么多块的项量"
  },
  {
    "start": 84.2,
    "end": 85.4,
    "text": "去做一个像速度检索"
  },
  {
    "start": 85.4,
    "end": 86.48,
    "text": "看哪个更匹配"
  },
  {
    "start": 86.48,
    "end": 87.8,
    "text": "去进行召回片段"
  },
  {
    "start": 87.8,
    "end": 89.72,
    "text": "比如说这9个片段里面有4个片段"
  },
  {
    "start": 89.72,
    "end": 90.96,
    "text": "和章三是谁比较相近"
  },
  {
    "start": 90.96,
    "end": 91.72,
    "text": "我们就召回4个"
  },
  {
    "start": 91.72,
    "end": 93.76,
    "text": "Rank模型是一个更精致的一个筛选"
  },
  {
    "start": 93.76,
    "end": 94.76,
    "text": "搭建这个demo的时候"
  },
  {
    "start": 94.76,
    "end": 96.36,
    "text": "也完全是遵循这样的一个流程"
  },
  {
    "start": 96.36,
    "end": 97.48,
    "text": "在这里get started的"
  },
  {
    "start": 97.48,
    "end": 99.16,
    "text": "我这里是已经注册登录过了"
  },
  {
    "start": 99.16,
    "end": 100.12,
    "text": "所以大家在这里只要选择"
  },
  {
    "start": 100.12,
    "end": 101.28,
    "text": "邮箱去登录就可以"
  },
  {
    "start": 101.28,
    "end": 102.28,
    "text": "进入到define之后"
  },
  {
    "start": 102.28,
    "end": 104.2,
    "text": "我们点击右上角的这个头像"
  },
  {
    "start": 104.2,
    "end": 105.2,
    "text": "点击设置"
  },
  {
    "start": 105.2,
    "end": 106.68,
    "text": "点击这里的模型供应商"
  },
  {
    "start": 106.68,
    "end": 108.64,
    "text": "我们是需要自己去配一个API的"
  },
  {
    "start": 108.64,
    "end": 109.88,
    "text": "因为define只是给我们"
  },
  {
    "start": 109.88,
    "end": 111.0,
    "text": "提供了一个搭建的平台"
  },
  {
    "start": 111.0,
    "end": 112.28,
    "text": "但是它并不给我们提供大模型"
  },
  {
    "start": 112.28,
    "end": 114.6,
    "text": "所以我们需要自己去借一个API K"
  },
  {
    "start": 114.6,
    "end": 116.56,
    "text": "安装的话就在下面找到"
  },
  {
    "start": 116.56,
    "end": 117.48,
    "text": "通易签问"
  },
  {
    "start": 117.48,
    "end": 118.28,
    "text": "然后进行安装"
  },
  {
    "start": 118.28,
    "end": 119.96,
    "text": "安装好了之后去进行配置"
  },
  {
    "start": 120.6,
    "end": 121.6,
    "text": "添加API密要"
  },
  {
    "start": 121.6,
    "end": 122.96,
    "text": "在这里输入API K"
  },
  {
    "start": 122.96,
    "end": 125.2,
    "text": "然后具体的大家可以搜索阿里云百炼"
  },
  {
    "start": 125.2,
    "end": 126.0,
    "text": "以及体验这里"
  },
  {
    "start": 126.0,
    "end": 127.08,
    "text": "进入到模型体验这里"
  },
  {
    "start": 127.08,
    "end": 128.4,
    "text": "可以看到左下角有个API K"
  },
  {
    "start": 128.4,
    "end": 130.0,
    "text": "点进去在这里创建API K"
  },
  {
    "start": 130.0,
    "end": 131.68,
    "text": "确定之后它就会自动创建一条"
  },
  {
    "start": 131.68,
    "end": 133.28,
    "text": "然后在这里复制API K就可以"
  },
  {
    "start": 133.28,
    "end": 134.16,
    "text": "然后这个一般新人"
  },
  {
    "start": 134.16,
    "end": 135.48,
    "text": "是有免费额度可以让我们使用的"
  },
  {
    "start": 135.48,
    "end": 136.48,
    "text": "申请完API K之后"
  },
  {
    "start": 136.48,
    "end": 137.52,
    "text": "我们在这里进行配置"
  },
  {
    "start": 137.52,
    "end": 138.96,
    "text": "主要通易签问它可以使用"
  },
  {
    "start": 138.96,
    "end": 140.72,
    "text": "Inviting模型还有Re-rank模型"
  },
  {
    "start": 140.72,
    "end": 142.6,
    "text": "这个是我们在之后都会使用到的模型"
  },
  {
    "start": 142.6,
    "end": 143.48,
    "text": "点击显示模型"
  },
  {
    "start": 143.48,
    "end": 145.24,
    "text": "在这里可以看到所有我们可以使用的模型"
  },
  {
    "start": 145.24,
    "end": 146.4,
    "text": "包括这里的Inviting模型"
  },
  {
    "start": 146.4,
    "end": 147.16,
    "text": "Re-rank模型"
  },
  {
    "start": 147.16,
    "end": 148.72,
    "text": "如果第一次使用这个产品"
  },
  {
    "start": 148.72,
    "end": 149.68,
    "text": "也不需要太担心"
  },
  {
    "start": 149.68,
    "end": 151.2,
    "text": "我们只需要关注上面这两个"
  },
  {
    "start": 151.2,
    "end": 152.24,
    "text": "一个是知识库"
  },
  {
    "start": 152.24,
    "end": 153.2,
    "text": "一个是工作室"
  },
  {
    "start": 153.2,
    "end": 154.64,
    "text": "关注这两个模块就可以"
  },
  {
    "start": 154.64,
    "end": 155.72,
    "text": "知识库是什么呢"
  },
  {
    "start": 155.72,
    "end": 156.96,
    "text": "你看它这里有个创建知识库"
  },
  {
    "start": 156.96,
    "end": 158.72,
    "text": "就是让我们上传自己的文档上选"
  },
  {
    "start": 158.72,
    "end": 160.48,
    "text": "在这里导入我们的一有文档就可以"
  },
  {
    "start": 160.48,
    "end": 161.84,
    "text": "我准备了一篇文档"
  },
  {
    "start": 161.84,
    "end": 163.28,
    "text": "这篇文档它是有表格的"
  },
  {
    "start": 163.28,
    "end": 164.0,
    "text": "表格和文档"
  },
  {
    "start": 164.0,
    "end": 165.8,
    "text": "它们两个的处理方法是不一样的"
  },
  {
    "start": 165.8,
    "end": 167.0,
    "text": "所以在这里避免表格"
  },
  {
    "start": 167.0,
    "end": 168.64,
    "text": "会对文档产生影响"
  },
  {
    "start": 168.64,
    "end": 169.68,
    "text": "我先把它给删除"
  },
  {
    "start": 169.68,
    "end": 170.72,
    "text": "但是我要在这里标记一下"
  },
  {
    "start": 170.72,
    "end": 171.88,
    "text": "这里是有一个这个表格的"
  },
  {
    "start": 171.88,
    "end": 173.76,
    "text": "那么就把这个文档进行导出"
  },
  {
    "start": 173.76,
    "end": 175.16,
    "text": "像这种文档类型的内容"
  },
  {
    "start": 175.16,
    "end": 177.08,
    "text": "我们最好去选择 Markdown 的格式"
  },
  {
    "start": 177.08,
    "end": 179.28,
    "text": "然后 HTML 只要是一些网页"
  },
  {
    "start": 179.28,
    "end": 180.2,
    "text": "可以使用这个格式"
  },
  {
    "start": 180.2,
    "end": 181.32,
    "text": "PDF 我们最好不要用"
  },
  {
    "start": 181.32,
    "end": 182.28,
    "text": "因为计算机来说"
  },
  {
    "start": 182.28,
    "end": 183.6,
    "text": "PDF 就像图片一样"
  },
  {
    "start": 183.6,
    "end": 185.28,
    "text": "它识别图片是非常困难的"
  },
  {
    "start": 185.28,
    "end": 186.72,
    "text": "我们把它导出成 Markdown 的格式"
  },
  {
    "start": 186.72,
    "end": 187.36,
    "text": "点击导出"
  },
  {
    "start": 187.36,
    "end": 188.36,
    "text": "我们先预览一下"
  },
  {
    "start": 188.36,
    "end": 190.12,
    "text": "Markdown 格式就是像这样"
  },
  {
    "start": 190.12,
    "end": 191.24,
    "text": "它会进行一级标题"
  },
  {
    "start": 191.24,
    "end": 192.4,
    "text": "二级标题的标识"
  },
  {
    "start": 192.4,
    "end": 193.84,
    "text": "一级标题前面是一个颈号"
  },
  {
    "start": 193.84,
    "end": 195.44,
    "text": "二级标题前面是两个颈号"
  },
  {
    "start": 195.44,
    "end": 197.24,
    "text": "三级标题的话前面是三个颈号"
  },
  {
    "start": 197.56,
    "end": 199.4,
    "text": "它会层次结构更分明一点"
  },
  {
    "start": 199.4,
    "end": 200.4,
    "text": "然后因为带有一个颈号"
  },
  {
    "start": 200.4,
    "end": 201.08,
    "text": "两个颈号 三个颈号"
  },
  {
    "start": 201.08,
    "end": 202.64,
    "text": "所以计算机它就可以识别"
  },
  {
    "start": 202.64,
    "end": 203.36,
    "text": "哪里是一级标题"
  },
  {
    "start": 203.36,
    "end": 203.96,
    "text": "哪里是二级标题"
  },
  {
    "start": 203.96,
    "end": 204.68,
    "text": "哪里是三级标题"
  },
  {
    "start": 204.68,
    "end": 205.44,
    "text": "就会更明确一点"
  },
  {
    "start": 205.44,
    "end": 206.92,
    "text": "我们在这里选择刚刚的文件"
  },
  {
    "start": 206.92,
    "end": 207.76,
    "text": "我们刚刚不是讲了"
  },
  {
    "start": 207.76,
    "end": 209.0,
    "text": "首先先用我们的文档"
  },
  {
    "start": 209.0,
    "end": 210.2,
    "text": "有文档之后去切分"
  },
  {
    "start": 210.2,
    "end": 210.96,
    "text": "切成 chunk"
  },
  {
    "start": 210.96,
    "end": 212.24,
    "text": "然后对每一个块去进行"
  },
  {
    "start": 212.24,
    "end": 213.12,
    "text": "Inviting 相量化"
  },
  {
    "start": 213.12,
    "end": 214.2,
    "text": "我们上传的知识库"
  },
  {
    "start": 214.2,
    "end": 216.24,
    "text": "然后第一步是需要对它进行切块"
  },
  {
    "start": 216.24,
    "end": 216.8,
    "text": "分断设置"
  },
  {
    "start": 216.8,
    "end": 218.72,
    "text": "这一部分都是对它如何进行切块"
  },
  {
    "start": 218.72,
    "end": 219.92,
    "text": "然后所引方式"
  },
  {
    "start": 219.92,
    "end": 220.76,
    "text": "这一部分就是"
  },
  {
    "start": 220.76,
    "end": 222.08,
    "text": "选择什么样的Inviting模型"
  },
  {
    "start": 222.08,
    "end": 223.48,
    "text": "然后对它进行相量化"
  },
  {
    "start": 223.48,
    "end": 224.68,
    "text": "我们现在看一下"
  },
  {
    "start": 224.68,
    "end": 225.64,
    "text": "这里是怎么设置的"
  },
  {
    "start": 225.64,
    "end": 227.64,
    "text": "它默认是给我们有一个分断标识幅"
  },
  {
    "start": 227.64,
    "end": 228.64,
    "text": "是刚刚"
  },
  {
    "start": 228.64,
    "end": 229.4,
    "text": "我们先预览一下"
  },
  {
    "start": 229.4,
    "end": 230.56,
    "text": "它给我们切分了什么样的块"
