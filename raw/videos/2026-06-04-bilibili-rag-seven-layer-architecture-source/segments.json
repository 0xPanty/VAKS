[
  {
    "start": 0.0,
    "end": 2.36,
    "text": "上一集我們講了PROM的工程化"
  },
  {
    "start": 2.36,
    "end": 5.04,
    "text": "貴旗進入本課最重磅的模塊"
  },
  {
    "start": 5.04,
    "end": 5.88,
    "text": "ROG"
  },
  {
    "start": 5.88,
    "end": 7.56,
    "text": "解鎖增強生成"
  },
  {
    "start": 7.56,
    "end": 8.52,
    "text": "先問你一個問題"
  },
  {
    "start": 8.52,
    "end": 10.0,
    "text": "你讓ChatGPT回答"
  },
  {
    "start": 10.0,
    "end": 12.48,
    "text": "關於你公司內部文檔的問題"
  },
  {
    "start": 12.48,
    "end": 13.76,
    "text": "它能答對嗎?"
  },
  {
    "start": 13.76,
    "end": 14.48,
    "text": "大"
  },
  {
    "start": 14.48,
    "end": 16.2,
    "text": "因為它根本沒見過你的文檔"
  },
  {
    "start": 16.2,
    "end": 17.8,
    "text": "HWANG就是解決這個問題的"
  },
  {
    "start": 17.8,
    "end": 20.16,
    "text": "讓AI能讀懂你的私有知識"
  },
  {
    "start": 20.16,
    "end": 21.96,
    "text": "如果說大模型是一個博學"
  },
  {
    "start": 21.96,
    "end": 23.92,
    "text": "但沒見過你家情況的醫生"
  },
  {
    "start": 23.92,
    "end": 26.12,
    "text": "REG就是把你的病例遞給它"
  },
  {
    "start": 26.12,
    "end": 28.16,
    "text": "大模型有三大軟肋"
  },
  {
    "start": 28.16,
    "end": 28.76,
    "text": "第一"
  },
  {
    "start": 28.88,
    "end": 29.8,
    "text": "知識過時"
  },
  {
    "start": 29.8,
    "end": 31.56,
    "text": "訓練數據有截止日期"
  },
  {
    "start": 31.56,
    "end": 33.0,
    "text": "昨天發佈的新規"
  },
  {
    "start": 33.0,
    "end": 34.16,
    "text": "它不知道"
  },
  {
    "start": 34.16,
    "end": 34.68,
    "text": "第二"
  },
  {
    "start": 34.68,
    "end": 36.12,
    "text": "沒有私有數據"
  },
  {
    "start": 36.12,
    "end": 37.52,
    "text": "你公司的內部文檔"
  },
  {
    "start": 37.52,
    "end": 38.32,
    "text": "課破紀錄"
  },
  {
    "start": 38.32,
    "end": 39.96,
    "text": "它從未見過"
  },
  {
    "start": 39.96,
    "end": 40.68,
    "text": "第三"
  },
  {
    "start": 40.68,
    "end": 41.52,
    "text": "幻覺"
  },
  {
    "start": 41.52,
    "end": 42.4,
    "text": "不只到酒邊"
  },
  {
    "start": 42.4,
    "end": 44.12,
    "text": "邊的還特別像真的"
  },
  {
    "start": 44.12,
    "end": 46.6,
    "text": "REG的本質就是別讓模型瞎猜"
  },
  {
    "start": 46.6,
    "end": 49.32,
    "text": "先幫它把相關資料找出來"
  },
  {
    "start": 49.32,
    "end": 51.2,
    "text": "再讓它基於資料回答"
  },
  {
    "start": 51.2,
    "end": 52.2,
    "text": "但目前回答一下"
  },
  {
    "start": 52.2,
    "end": 54.36,
    "text": "你覺得200k上下文"
  },
  {
    "start": 54.36,
    "end": 55.56,
    "text": "穿狗時代"
  },
  {
    "start": 55.56,
    "end": 56.72,
    "text": "還需要RAG嗎?"
  },
  {
    "start": 56.72,
    "end": 58.28,
    "text": "有人說直接把所有文檔"
  },
  {
    "start": 58.28,
    "end": 59.44,
    "text": "塞進去不就行了"
  },
  {
    "start": 59.44,
    "end": 60.44,
    "text": "聽起來有道理"
  },
  {
    "start": 60.44,
    "end": 61.32,
    "text": "但算一筆帳"
  },
  {
    "start": 61.32,
    "end": 62.4,
    "text": "十萬份文檔"
  },
  {
    "start": 62.4,
    "end": 63.48,
    "text": "每一份五千字"
  },
  {
    "start": 63.48,
    "end": 64.6,
    "text": "總共五億字"
  },
  {
    "start": 64.6,
    "end": 66.84,
    "text": "200k窗口只能裝十五萬字"
  },
  {
    "start": 66.84,
    "end": 68.72,
    "text": "你連千分之一都塞不進去"
  },
  {
    "start": 68.72,
    "end": 70.16,
    "text": "而且就算塞得下"
  },
  {
    "start": 70.16,
    "end": 71.0,
    "text": "成本呢"
  },
  {
    "start": 71.0,
    "end": 72.92,
    "text": "每次查詢都帶十五萬字"
  },
  {
    "start": 72.92,
    "end": 74.08,
    "text": "一天一萬次查詢"
  },
  {
    "start": 74.08,
    "end": 75.92,
    "text": "光API費就幾萬美元"
  },
  {
    "start": 75.92,
    "end": 77.48,
    "text": "REG在二零二六年"
  },
  {
    "start": 77.48,
    "end": 78.56,
    "text": "不僅沒過時"
  },
  {
    "start": 78.56,
    "end": 81.32,
    "text": "反而是最高頻的加薄模式"
  },
  {
    "start": 81.32,
    "end": 82.88,
    "text": "很多人搭了個RAG覺得挺好"
  },
  {
    "start": 82.88,
    "end": 85.84,
    "text": "DEMO裡問十個問題對八個"
  },
  {
    "start": 85.84,
    "end": 87.08,
    "text": "然後上線用戶來了"
  },
  {
    "start": 87.08,
    "end": 88.88,
    "text": "準確率暴跌到百分之四十"
  },
  {
    "start": 88.88,
    "end": 89.64,
    "text": "為什麼"
  },
  {
    "start": 89.64,
    "end": 91.04,
    "text": "因為你的玩具有話"
  },
  {
    "start": 91.04,
    "end": 92.72,
    "text": "至少有七個字名問題"
  },
  {
    "start": 92.72,
    "end": 94.68,
    "text": "這段內容可能比較扎心"
  },
  {
    "start": 94.68,
    "end": 96.84,
    "text": "但你早知道別上線翻車牆"
  },
  {
    "start": 96.84,
    "end": 97.68,
    "text": "第一個問題"
  },
  {
    "start": 97.68,
    "end": 99.32,
    "text": "文檔解析丟結構"
  },
  {
    "start": 99.32,
    "end": 100.96,
    "text": "你的PDF裡有表格"
  },
  {
    "start": 100.96,
    "end": 101.64,
    "text": "有公式"
  },
  {
    "start": 101.64,
    "end": 102.84,
    "text": "有圖片說明"
  },
  {
    "start": 102.84,
    "end": 104.8,
    "text": "用最簡單的解析庫意圖"
  },
  {
    "start": 104.8,
    "end": 106.12,
    "text": "表格變成一行亂馬"
  },
  {
    "start": 106.12,
    "end": 106.92,
    "text": "公式消失了"
  },
  {
    "start": 106.92,
    "end": 108.12,
    "text": "圖片直接跳過"
  },
  {
    "start": 108.12,
    "end": 109.04,
    "text": "模型"
  },
  {
    "start": 109.04,
    "end": 110.84,
    "text": "拿到的是長圈信息"
  },
  {
    "start": 110.84,
    "end": 112.36,
    "text": "能回答對才怪"
  },
  {
    "start": 112.36,
    "end": 113.24,
    "text": "第二個問題"
  },
  {
    "start": 113.24,
    "end": 114.32,
    "text": "切片粗暴"
  },
  {
    "start": 114.32,
    "end": 116.36,
    "text": "100文檔按500字一刀切"
  },
  {
    "start": 116.36,
    "end": 117.32,
    "text": "正好把這項政策"
  },
  {
    "start": 117.32,
    "end": 119.64,
    "text": "適用於和2024年1月1日之後"
  },
  {
    "start": 119.64,
    "end": 121.68,
    "text": "入職的員工切成兩塊"
  },
  {
    "start": 121.68,
    "end": 122.76,
    "text": "解鎖只找到後半句"
  },
  {
    "start": 122.76,
    "end": 124.96,
    "text": "模型不知道是什麼政策"
  },
  {
    "start": 124.96,
    "end": 126.04,
    "text": "一刀切"
  },
  {
    "start": 126.04,
    "end": 127.12,
    "text": "切斷了語意"
  },
  {
    "start": 127.12,
    "end": 128.04,
    "text": "第三個問題"
  },
  {
    "start": 128.04,
    "end": 129.64,
    "text": "Invading模型選錯"
  },
  {
    "start": 129.64,
    "end": 131.8,
    "text": "用英文模型處理中文文檔"
  },
  {
    "start": 131.8,
    "end": 133.32,
    "text": "語意匹配圈端"
  },
  {
    "start": 133.32,
    "end": 135.6,
    "text": "但信念價和Idle Leaf是一個意思"
  },
  {
    "start": 135.6,
    "end": 137.56,
    "text": "但選錯模型就匹配不上"
  },
  {
    "start": 137.56,
    "end": 138.24,
    "text": "第四"
  },
  {
    "start": 138.24,
    "end": 139.44,
    "text": "只用相量解鎖"
  },
  {
    "start": 139.44,
    "end": 140.68,
    "text": "不用關鍵詞"
  },
  {
    "start": 140.68,
    "end": 141.32,
    "text": "用戶文"
  },
  {
    "start": 141.32,
    "end": 142.72,
    "text": "Restful API文檔"
  },
  {
    "start": 142.72,
    "end": 143.48,
    "text": "下輛解鎖"
  },
  {
    "start": 143.48,
    "end": 144.28,
    "text": "可能給你一篇"
  },
  {
    "start": 144.28,
    "end": 145.92,
    "text": "講接口設計原則的文章"
  },
  {
    "start": 146.0,
    "end": 147.44,
    "text": "英文語"
  },
  {
    "start": 147.44,
    "end": 148.36,
    "text": "以進"
  },
  {
    "start": 148.36,
    "end": 149.12,
    "text": "但用戶要的"
  },
  {
    "start": 149.12,
    "end": 151.12,
    "text": "就是那個叫Restful的具體文檔"
  },
  {
    "start": 151.12,
    "end": 152.04,
    "text": "關鍵詞解鎖"
  },
  {
    "start": 152.04,
    "end": 152.96,
    "text": "疫苗搞定"
  },
  {
    "start": 152.96,
    "end": 153.68,
    "text": "第五個問題"
  },
  {
    "start": 153.68,
    "end": 154.64,
    "text": "沒有rearrank"
  },
  {
    "start": 154.64,
    "end": 155.76,
    "text": "解鎖回來十條結果"
  },
  {
    "start": 155.76,
    "end": 157.72,
    "text": "其中可能只有三條真正相關"
  },
  {
    "start": 157.72,
    "end": 158.92,
    "text": "七條是噪聲"
  },
  {
    "start": 158.92,
    "end": 159.92,
    "text": "你全塞給模型"
  },
  {
    "start": 159.92,
    "end": 161.16,
    "text": "模型被噪聲干擾"
  },
  {
    "start": 161.16,
    "end": 162.8,
    "text": "答案質量暴跌"
  },
  {
    "start": 162.8,
    "end": 163.48,
    "text": "第六"
  },
  {
    "start": 163.48,
    "end": 164.36,
    "text": "Prompt Setter滿"
  },
  {
    "start": 164.36,
    "end": 166.08,
    "text": "十條常文本全部拼進去"
  },
  {
    "start": 166.08,
    "end": 167.28,
    "text": "模型中間一時"
  },
  {
    "start": 167.28,
    "end": 168.52,
    "text": "只看開頭結尾"
  },
  {
    "start": 168.52,
    "end": 169.04,
    "text": "第七"
  },
  {
    "start": 169.04,
    "end": 170.12,
    "text": "也是最關鍵的"
  },
  {
    "start": 170.12,
    "end": 171.52,
    "text": "沒有評估級"
  },
  {
    "start": 171.52,
    "end": 172.96,
    "text": "你憑感覺覺得改好了"
  },
  {
    "start": 172.96,
    "end": 173.6,
    "text": "其實改好了"
  },
  {
    "start": 173.6,
    "end": 174.2,
    "text": "這個case"
  },
  {
    "start": 174.2,
    "end": 175.12,
    "text": "壞了那個case"
  },
  {
    "start": 175.12,
    "end": 175.76,
    "text": "沒有數據"
  },
  {
    "start": 175.76,
    "end": 176.8,
    "text": "就明明沒有真相"
  },
  {
    "start": 176.8,
    "end": 178.48,
    "text": "那生產級外格應該怎麼做"
  },
  {
    "start": 178.48,
    "end": 180.92,
    "text": "我給你一個七層架構模型"
  },
  {
    "start": 180.92,
    "end": 183.0,
    "text": "就像網絡有OSI七層一樣"
  },
  {
    "start": 183.0,
    "end": 184.52,
    "text": "reg也有七層"
  },
  {
    "start": 184.52,
    "end": 186.52,
    "text": "每一層都有專門的技術方案"
  },
  {
    "start": 186.52,
    "end": 188.16,
    "text": "記住這個架構後面每一個優化"
  },
  {
    "start": 188.16,
    "end": 190.12,
    "text": "都是在某一層上做文章"
  },
  {
    "start": 190.12,
    "end": 191.92,
    "text": "第一層Ingestion"
  },
  {
    "start": 191.92,
    "end": 192.48,
    "text": "文檔"
  },
  {
    "start": 192.48,
    "end": 193.2,
    "text": "設錄"
  },
  {
    "start": 193.2,
    "end": 193.8,
    "text": "文檔"
  },
  {
    "start": 193.8,
    "end": 194.6,
    "text": "從哪裡來"
  },
  {
    "start": 194.6,
    "end": 195.28,
    "text": "數據庫"
  },
  {
    "start": 195.28,
    "end": 196.04,
    "text": "網頁"
  },
  {
    "start": 196.04,
    "end": 196.72,
    "text": "文件系統"
  },
  {
    "start": 196.72,
    "end": 197.68,
    "text": "API"
  },
  {
    "start": 197.68,
    "end": 199.24,
    "text": "你需要一條流水線"
  },
  {
    "start": 199.24,
    "end": 201.04,
    "text": "持續監聽新文檔"
  },
  {
    "start": 201.04,
    "end": 202.4,
    "text": "第二層Parsing"
  },
  {
    "start": 202.4,
    "end": 203.56,
    "text": "文檔解析"
  },
  {
    "start": 203.56,
    "end": 204.84,
    "text": "把PDF Board"
  },
  {
    "start": 204.84,
    "end": 205.56,
    "text": "HTML"
  },
  {
    "start": 205.56,
    "end": 207.88,
    "text": "變成乾淨的結構化文本"
  },
  {
    "start": 207.88,
    "end": 208.8,
    "text": "這一層的質量"
  },
  {
    "start": 208.8,
    "end": 210.96,
    "text": "決定了後面所有層的上限"
  },
  {
    "start": 210.96,
    "end": 212.8,
    "text": "Garbage"
  },
  {
    "start": 212.8,
    "end": 214.32,
    "text": "Garbage Art"
  },
  {
    "start": 214.32,
    "end": 215.96,
    "text": "第三層Chunking"
  },
  {
    "start": 215.96,
    "end": 216.72,
    "text": "切片"
  },
  {
    "start": 216.72,
    "end": 219.12,
    "text": "把長文檔切成適合剪鎖的小塊"
  },
  {
    "start": 219.12,
    "end": 220.6,
    "text": "這不是簡單的自術切割"
  },
  {
    "start": 220.6,
    "end": 223.12,
    "text": "好的切片應該保證語意完整性"
  },
  {
    "start": 223.12,
    "end": 224.76,
    "text": "第四層Indexing"
  },
  {
    "start": 224.76,
    "end": 225.4,
    "text": "鎖影"
  },
  {
    "start": 225.4,
    "end": 226.48,
    "text": "不只是相量鎖影"
  },
  {
    "start": 226.48,
    "end": 228.52,
    "text": "還有BM-25關鍵詞鎖影"
  },
  {
    "start": 228.52,
    "end": 230.08,
    "text": "甚至知識圖譜鎖影"
  },
  {
    "start": 230.08,
    "end": 231.28,
    "text": "多種鎖影並行"
  },
  {
    "start": 231.28,
    "end": 232.92,
    "text": "覆蓋不同剪鎖場景"
  },
  {
    "start": 232.92,
    "end": 234.56,
    "text": "第五層Rechlevel"
  },
  {
    "start": 234.56,
    "end": 235.4,
    "text": "剪鎖"
  },
  {
    "start": 235.4,
    "end": 237.48,
    "text": "用戶的問題進來改寫優化"
  },
  {
    "start": 237.48,
    "end": 240.16,
    "text": "然後同時查相量鎖和關鍵詞鎖合併結果"
  },
  {
    "start": 240.16,
    "end": 241.48,
    "text": "第六層Ranking"
  },
  {
    "start": 241.48,
    "end": 242.24,
    "text": "金牌"
  },
  {
    "start": 242.24,
    "end": 244.08,
    "text": "對剪鎖結果重新排序"
  },
  {
    "start": 244.08,
    "end": 246.2,
    "text": "把最相關的排到最前面"
  },
  {
    "start": 246.2,
    "end": 247.72,
    "text": "噪聲排到後面"
  },
  {
    "start": 247.72,
    "end": 250.08,
    "text": "第七層Generation"
  },
  {
    "start": 250.08,
    "end": 251.2,
    "text": "生成"
  },
  {
    "start": 251.2,
    "end": 253.64,
