[
  {
    "id": 0,
    "start": 0.0,
    "end": 1.72,
    "text": "大家好 我是新號"
  },
  {
    "id": 1,
    "start": 1.72,
    "end": 6.5200000000000005,
    "text": "今天我們探討Obsidian的三大使用障礙這款雙鍊筆記工具"
  },
  {
    "id": 2,
    "start": 6.5200000000000005,
    "end": 7.72,
    "text": "功能強大"
  },
  {
    "id": 3,
    "start": 7.72,
    "end": 10.68,
    "text": "但很多人用著用著就陷入了怪圈"
  },
  {
    "id": 4,
    "start": 10.68,
    "end": 14.6,
    "text": "要麼懶得動筆記錄 要麼筆記堆成垃圾堆"
  },
  {
    "id": 5,
    "start": 14.6,
    "end": 17.96,
    "text": "就算整理完了 也永遠只成不用"
  },
  {
    "id": 6,
    "start": 17.96,
    "end": 22.400000000000002,
    "text": "大家總覺得是自己執行力不夠 或是工具太難用"
  },
  {
    "id": 7,
    "start": 22.400000000000002,
    "end": 25.2,
    "text": "但今天我們跳出表面現象"
  },
  {
    "id": 8,
    "start": 25.2,
    "end": 29.36,
    "text": "從認知心理學 行為科學 知識管理理論出發"
  },
  {
    "id": 9,
    "start": 29.36,
    "end": 33.68,
    "text": "系統性拆解Obsidian用戶最典型的三類障礙"
  },
  {
    "id": 10,
    "start": 33.68,
    "end": 38.4,
    "text": "搞懂底層邏輯 才能真正把筆記工具用明白"
  },
  {
    "id": 11,
    "start": 38.4,
    "end": 41.96,
    "text": "1. 記錄動機不足 筆記入口癱瘓"
  },
  {
    "id": 12,
    "start": 41.96,
    "end": 45.64,
    "text": "首先第一類問題 記錄環節徹底卡殼"
  },
  {
    "id": 13,
    "start": 45.64,
    "end": 47.8,
    "text": "筆記入口直接癱瘓"
  },
  {
    "id": 14,
    "start": 47.8,
    "end": 50.16,
    "text": "它主要表現為兩種行為"
  },
  {
    "id": 15,
    "start": 50.16,
    "end": 53.32,
    "text": "第一 大家會下一時篩選信息"
  },
  {
    "id": 16,
    "start": 53.32,
    "end": 57.72,
    "text": "覺得只有重要 正式的內容才值得記下來"
  },
  {
    "id": 17,
    "start": 57.839999999999996,
    "end": 63.28,
    "text": "那些碎片化靈感 臨時想法 邊角信息 直接被忽略"
  },
  {
    "id": 18,
    "start": 63.28,
    "end": 67.32,
    "text": "同時還會陷入一個誤區 高估自己的記憶力"
  },
  {
    "id": 19,
    "start": 67.32,
    "end": 69.8,
    "text": "總覺得這點東西我腦子記得住"
  },
  {
    "id": 20,
    "start": 69.8,
    "end": 74.44,
    "text": "2. 很多人從寫第一行字開始 就要求完美"
  },
  {
    "id": 21,
    "start": 74.44,
    "end": 79.8,
    "text": "標籤 分類 排版 畫布 可視畫 結構畫書裡"
  },
  {
    "id": 22,
    "start": 79.8,
    "end": 84.84,
    "text": "把成品筆記的全套標準全都套在最開始的記錄環節"
  },
  {
    "id": 23,
    "start": 84.92,
    "end": 88.8,
    "text": "起步門檻一下子拉滿 自然遲遲不敢動手"
  },
  {
    "id": 24,
    "start": 88.8,
    "end": 92.16,
    "text": "這兩種行為背後 藏著三層核心原因"
  },
  {
    "id": 25,
    "start": 92.16,
    "end": 95.52000000000001,
    "text": "每一層都和我們的認知規律息息相關"
  },
  {
    "id": 26,
    "start": 95.52000000000001,
    "end": 99.4,
    "text": "第一點 對工具定位徹底認知錯配"
  },
  {
    "id": 27,
    "start": 99.4,
    "end": 103.32000000000001,
    "text": "很多人把Obsidian當成單純的知識存檔庫"
  },
  {
    "id": 28,
    "start": 103.32000000000001,
    "end": 107.76,
    "text": "但它真正的核心是延伸我們思維的外部載體"
  },
  {
    "id": 29,
    "start": 107.76,
    "end": 110.68,
    "text": "人腦的創意 聯想 推理"
  },
  {
    "id": 30,
    "start": 110.68,
    "end": 113.52000000000001,
    "text": "本就來自碎片化信息的碰撞"
  },
  {
    "id": 31,
    "start": 113.52,
    "end": 115.64,
    "text": "你主動丟掉零散想法"
  },
  {
    "id": 32,
    "start": 115.64,
    "end": 118.72,
    "text": "其實就是切斷了知識產生關聯的觸點"
  },
  {
    "id": 33,
    "start": 118.72,
    "end": 122.72,
    "text": "在結合記憶規律來說 我們的短時記憶容量極小"
  },
  {
    "id": 34,
    "start": 122.72,
    "end": 124.8,
    "text": "而且衰退速度極快"
  },
  {
    "id": 35,
    "start": 124.8,
    "end": 128.64,
    "text": "當下在清晰的靈感 幾小時後就會失真"
  },
  {
    "id": 36,
    "start": 128.64,
    "end": 133.6,
    "text": "遺忘 完全靠大腦硬扛 本身就是最低效的選擇"
  },
  {
    "id": 37,
    "start": 133.6,
    "end": 138.48,
    "text": "第二點 典型的中太前置 大幅拉高了行動門檻"
  },
  {
    "id": 38,
    "start": 138.48,
    "end": 142.88,
    "text": "Obsidian的雙鍊 標籤 思維導圖 畫布"
  },
  {
    "id": 39,
    "start": 142.88,
    "end": 147.6,
    "text": "設計初衷都是後期加工的工具 不是用來寫草稿的"
  },
  {
    "id": 40,
    "start": 147.6,
    "end": 154.48,
    "text": "可我們偏要把隨手記錄草稿和排版裝真搭建結構合併成一件事"
  },
  {
    "id": 41,
    "start": 154.48,
    "end": 158.24,
    "text": "按照行為心理學的規律 任務一開始越複雜"
  },
  {
    "id": 42,
    "start": 158.24,
    "end": 160.48,
    "text": "人的行動意願就越弱"
  },
  {
    "id": 43,
    "start": 160.48,
    "end": 164.88,
    "text": "這就是想記筆記卻始終不動手的核心原因"
  },
  {
    "id": 44,
    "start": 164.88,
    "end": 167.35999999999999,
    "text": "第三點 出現了目標置換"
  },
  {
    "id": 45,
    "start": 167.35999999999999,
    "end": 171.28,
    "text": "不少人把美觀 條理當成筆記的第一標準"
  },
  {
    "id": 46,
    "start": 171.28,
    "end": 174.72,
    "text": "花大量時間調整格式 優化視覺"
  },
  {
    "id": 47,
    "start": 174.72,
    "end": 178.16,
    "text": "原本用來輔助思考 串連知識的筆記"
  },
  {
    "id": 48,
    "start": 178.16,
    "end": 180.48,
    "text": "反倒變成了做美工"
  },
  {
    "id": 49,
    "start": 180.48,
    "end": 184.88,
    "text": "形式蓋過了本質 記錄的動力自然越來越弱"
  },
  {
    "id": 50,
    "start": 184.88,
    "end": 187.52,
    "text": "久而久之就形成惡性循環"
  },
  {
    "id": 51,
    "start": 187.52,
    "end": 192.0,
    "text": "挑內容高標準不敢動筆筆記 長期空白更加認定"
  },
  {
    "id": 52,
    "start": 192.0,
    "end": 196.0,
    "text": "只有正經內容才配記錄 徹底鎖死入口"
  },
  {
    "id": 53,
    "start": 196.0,
    "end": 199.52,
    "text": "二 處理動機不足 信息流轉癱瘓"
  },
  {
    "id": 54,
    "start": 199.52,
    "end": 202.08,
    "text": "如果說第一類人是沒筆記可寫"
  },
  {
    "id": 55,
    "start": 202.08,
    "end": 205.04000000000002,
    "text": "那第二類人就是筆記多到爆炸"
  },
  {
    "id": 56,
    "start": 205.04000000000002,
    "end": 206.96,
    "text": "卻完全不會處理"
  },
  {
    "id": 57,
    "start": 206.96,
    "end": 209.52,
    "text": "也就是信息流轉徹底癱瘓"
  },
  {
    "id": 58,
    "start": 209.52,
    "end": 211.92000000000002,
    "text": "這類用戶的行為也很典型"
  },
  {
    "id": 59,
    "start": 211.92000000000002,
    "end": 214.24,
    "text": "第一種 無差別囤積"
  },
  {
    "id": 60,
    "start": 214.24,
    "end": 218.0,
    "text": "網頁摘錄 文章片段 AI對話"
  },
  {
    "id": 61,
    "start": 218.0,
    "end": 220.88,
    "text": "各類素材 不篩選 不刪減"
  },
  {
    "id": 62,
    "start": 220.88,
    "end": 223.36,
    "text": "一股腦全部篩進筆記裡"
  },
  {
    "id": 63,
    "start": 223.36,
    "end": 226.72,
    "text": "時間一長 筆記庫變成素材拉積堆"
  },
  {
    "id": 64,
    "start": 226.72,
    "end": 229.36,
    "text": "視覺和心理雙重壓抑"
  },
  {
    "id": 65,
    "start": 229.36,
    "end": 231.92000000000002,
    "text": "第二種 涉入即終止"
  },
  {
    "id": 66,
    "start": 231.92000000000002,
    "end": 234.8,
    "text": "內容只做到摘鈔保存這一步"
  },
  {
    "id": 67,
    "start": 234.8,
    "end": 238.88000000000002,
    "text": "停留在覺得內容有意思的潛程感受"
  },
  {
    "id": 68,
    "start": 238.88000000000002,
    "end": 241.36,
    "text": "不拆解 不梳理 不關聯"
  },
  {
    "id": 69,
    "start": 241.36,
    "end": 244.8,
    "text": "筆記最後淪為無人問津的信息墳場"
  },
  {
    "id": 70,
    "start": 244.8,
    "end": 247.60000000000002,
    "text": "背後同樣有三層科學邏輯"
  },
  {
    "id": 71,
    "start": 247.60000000000002,
    "end": 250.96,
    "text": "首先是存儲幻覺疊加損失厭惡心理"
  },
  {
    "id": 72,
    "start": 250.96,
    "end": 253.84,
    "text": "很多人誤以為內容純淨Obsidian"
  },
  {
    "id": 73,
    "start": 253.84,
    "end": 255.52,
    "text": "就等於自己學會"
  },
  {
    "id": 74,
    "start": 255.60000000000002,
    "end": 259.76,
    "text": "掌握了 再加上人天生害怕丟失有用信息"
  },
  {
    "id": 75,
    "start": 259.76,
    "end": 262.0,
    "text": "捨不得刪掉任何一份素材"
  },
  {
    "id": 76,
    "start": 262.0,
    "end": 264.16,
    "text": "素材就會無限堆積"
  },
  {
    "id": 77,
    "start": 264.16,
    "end": 266.24,
    "text": "而海量雜亂的內容"
  },
  {
    "id": 78,
    "start": 266.24,
    "end": 268.8,
    "text": "會直接造成認知負荷過載"
  },
  {
    "id": 79,
    "start": 268.8,
    "end": 271.12,
    "text": "大腦被榮於信息填滿"
  },
  {
    "id": 80,
    "start": 271.12,
    "end": 274.24,
    "text": "出於自我保護會本能的拖延"
  },
  {
    "id": 81,
    "start": 274.24,
    "end": 277.28000000000003,
    "text": "東西越多越不敢整理越放越亂"
  },
  {
    "id": 82,
    "start": 277.28000000000003,
    "end": 280.8,
    "text": "第二點違背了經典的認知加工水平理論"
  },
  {
    "id": 83,
    "start": 280.8,
    "end": 284.72,
    "text": "單純的摘鈔保存屬於潛程信息加工"
  },
  {
    "id": 84,
    "start": 284.72,
    "end": 287.12,
    "text": "只能停留在符號識別層面"
  },
  {
    "id": 85,
    "start": 287.12,
    "end": 289.44000000000005,
    "text": "記憶和理解效果極差"
  },
  {
    "id": 86,
    "start": 289.44000000000005,
    "end": 292.88000000000005,
    "text": "只有主動改寫 提問 梳理邏輯"
  },
  {
    "id": 87,
    "start": 292.88000000000005,
    "end": 295.76000000000005,
    "text": "建立關聯才算深沉於一加工"
  },
  {
    "id": 88,
    "start": 295.76000000000005,
    "end": 298.40000000000003,
    "text": "知識才能真正被你內化"
  },
  {
    "id": 89,
    "start": 298.40000000000003,
    "end": 301.92,
    "text": "絕大多數人卡在了表層加工這一步"
  },
  {
    "id": 90,
    "start": 301.92,
    "end": 305.52000000000004,
    "text": "第三點整理成本成指數級上漲"
  },
  {
    "id": 91,
    "start": 305.52000000000004,
    "end": 308.32000000000005,
    "text": "素材堆積的越久越雜亂"
  },
  {
    "id": 92,
    "start": 308.32000000000005,
    "end": 311.68,
    "text": "後續梳理重構串連的工作量"
  },
  {
    "id": 93,
    "start": 311.68,
    "end": 315.04,
    "text": "不是慢慢增加而是指數級飆升"
  },
  {
    "id": 94,
    "start": 315.04,
    "end": 318.48,
    "text": "越拖越難做越難做越想逃避"
  },
  {
    "id": 95,
    "start": 318.48,
    "end": 320.8,
    "text": "惡性循環就此形成"
  },
  {
    "id": 96,
    "start": 320.8,
    "end": 323.6,
    "text": "囤積素材內容預設認知過載"
  },
  {
    "id": 97,
    "start": 323.6,
    "end": 325.6,
    "text": "拖延百難繼續囤積"
  },
  {
    "id": 98,
    "start": 325.6,
    "end": 328.8,
    "text": "整個筆記體系變成一潭死水"
  },
  {
    "id": 99,
    "start": 328.8,
    "end": 332.48,
    "text": "三 輸出動機不足 知識無法外化"
  },
  {
    "id": 100,
    "start": 332.48,
    "end": 334.88,
    "text": "熬過了記錄熬過了整理"
  },
  {
    "id": 101,
    "start": 334.88,
    "end": 337.04,
    "text": "還有第三道最難的關卡"
  },
  {
    "id": 102,
    "start": 337.04,
    "end": 339.28000000000003,
    "text": "輸出環節動機缺失"
  },
  {
    "id": 103,
    "start": 339.28000000000003,
    "end": 341.52,
    "text": "知識永遠無法外化"
  },
  {
    "id": 104,
    "start": 341.68,
    "end": 344.88,
    "text": "這類用戶的筆記邏輯完整 梳理到位"
  },
  {
    "id": 105,
    "start": 344.88,
    "end": 346.88,
    "text": "但依舊走不通避緩"
  },
  {
    "id": 106,
    "start": 346.88,
    "end": 350.71999999999997,
    "text": "第一 記完整理完直接歸蕩封存"
  },
  {
    "id": 107,
    "start": 350.71999999999997,
    "end": 353.91999999999996,
    "text": "默認筆記寫完學習就結束了"
  },
  {
    "id": 108,
    "start": 353.91999999999996,
    "end": 357.35999999999996,
    "text": "完全沒有輸出復盤復用的意識"
  },
  {
    "id": 109,
    "start": 357.35999999999996,
    "end": 360.24,
    "text": "第二 嚴重的完美主義內耗"
  },
  {
    "id": 110,
    "start": 360.24,
    "end": 362.96,
    "text": "總覺得內容不夠嚴謹 文筆不好"
  },
  {
    "id": 111,
    "start": 362.96,
    "end": 364.32,
    "text": "觀點不成熟"
  },
  {
    "id": 112,
    "start": 364.32,
    "end": 367.03999999999996,
    "text": "非要做到百分百完美才肯動筆"
  },
  {
    "id": 113,
    "start": 367.03999999999996,
    "end": 369.91999999999996,
    "text": "結果一拖再拖永遠不開始"
  },
  {
    "id": 114,
    "start": 369.92,
    "end": 372.16,
    "text": "第三 心理壁壘作祟"
  },
  {
    "id": 115,
    "start": 372.16,
    "end": 375.2,
    "text": "一方面預判輸出後沒有互動反饋"
  },
  {
    "id": 116,
    "start": 375.2,
    "end": 376.72,
    "text": "缺少正向激勵"
  },
  {
    "id": 117,
    "start": 376.72,
    "end": 379.92,
    "text": "另一方面把筆記當成私有知識"
  },
  {
    "id": 118,
    "start": 379.92,
    "end": 384.0,
    "text": "不願公開害怕被評判直接放棄輸出"
  },
  {
    "id": 119,
    "start": 384.0,
    "end": 385.52000000000004,
    "text": "輸出之所以難"
  },
  {
    "id": 120,
    "start": 385.52000000000004,
    "end": 387.92,
    "text": "是因為它是整個知識鍊路裡"
  },
  {
    "id": 121,
    "start": 387.92,
    "end": 390.16,
    "text": "認知負荷最高的環節"
  },
  {
    "id": 122,
    "start": 390.16,
    "end": 393.12,
    "text": "第一 遵循認知審立原則"
  },
  {
    "id": 123,
    "start": 393.12,
    "end": 395.6,
    "text": "大腦天生偏愛低耗能的事"
  },
  {
    "id": 124,
    "start": 395.6,
    "end": 398.96000000000004,
    "text": "記錄整理都屬於相對輕鬆的工作"
  },
  {
    "id": 125,
    "start": 398.96,
    "end": 400.96,
    "text": "而輸出需要整合"
  },
  {
    "id": 126,
    "start": 400.96,
    "end": 404.79999999999995,
    "text": "重構 論證 表達 極度耗費腦力"
  },
  {
    "id": 127,
    "start": 404.79999999999995,
    "end": 406.47999999999996,
    "text": "本能趨利避害"
  },
  {
    "id": 128,
    "start": 406.47999999999996,
    "end": 409.03999999999996,
    "text": "我們自然會逃避高難度任務"
  },
  {
    "id": 129,
    "start": 409.03999999999996,
    "end": 410.96,
    "text": "第二 能力缺口"
  },
  {
    "id": 130,
    "start": 410.96,
    "end": 414.24,
    "text": "很多人的筆記都是淋傘的單點內容"
  },
  {
    "id": 131,
    "start": 414.24,
    "end": 416.64,
    "text": "沒有搭建整體邏輯框架"
  },
  {
    "id": 132,
    "start": 416.64,
    "end": 418.08,
    "text": "哪怕想輸出"
  },
  {
    "id": 133,
    "start": 418.08,
    "end": 420.47999999999996,
    "text": "也不知道怎麼把碎片化筆記"
  },
  {
    "id": 134,
    "start": 420.47999999999996,
    "end": 422.0,
    "text": "串成完整內容"
  },
  {
    "id": 135,
    "start": 422.0,
    "end": 424.47999999999996,
    "text": "有心無力只能放棄"
  },
  {
    "id": 136,
    "start": 424.47999999999996,
    "end": 427.84,
    "text": "第三 行為路徑依賴長期只做輸入"
  },
  {
    "id": 137,
    "start": 427.91999999999996,
    "end": 431.03999999999996,
    "text": "不做輸出 慢慢就固化了習慣"
  },
  {
    "id": 138,
    "start": 431.03999999999996,
    "end": 433.91999999999996,
    "text": "我們一直待在收集整理的輸出區"
  },
  {
    "id": 139,
    "start": 433.91999999999996,
    "end": 436.4,
    "text": "壓根沒有建立輸出的行為範使"
  },
  {
    "id": 140,
    "start": 436.4,
    "end": 438.96,
    "text": "第四 雙重心理阻礙"
  },
  {
    "id": 141,
    "start": 438.96,
    "end": 441.03999999999996,
    "text": "不良完美主義帶來拖延"
  },
  {
    "id": 142,
    "start": 441.03999999999996,
    "end": 445.03999999999996,
    "text": "知識私有的心態加上對他人評價的恐懼"
  },
  {
    "id": 143,
    "start": 445.03999999999996,
    "end": 446.96,
    "text": "又足起一道心理牆"
  },
  {
    "id": 144,
    "start": 446.96,
    "end": 449.03999999999996,
    "text": "而且筆記體量越大"
  },
  {
    "id": 145,
    "start": 449.03999999999996,
    "end": 452.15999999999997,
    "text": "大家越會覺得輸出是一項大工程"
  },
  {
    "id": 146,
    "start": 452.15999999999997,
    "end": 454.0,
    "text": "未難情緒翻倍"
  },
  {
    "id": 147,
    "start": 454.0,
    "end": 456.71999999999997,
    "text": "筆記歸導 無輸出 無驗證"
  },
  {
    "id": 148,
    "start": 456.8,
    "end": 460.32000000000005,
    "text": "無疊帶沒有真相反饋越來越未具輸出"
  },
  {
    "id": 149,
    "start": 460.32000000000005,
    "end": 464.64000000000004,
    "text": "最終所有沉澱的知識全部鎖在筆記裡"
  },
  {
    "id": 150,
    "start": 464.64000000000004,
    "end": 466.40000000000003,
    "text": "無法發揮價值"
  },
  {
    "id": 151,
    "start": 466.40000000000003,
    "end": 468.72,
    "text": "講到這裡相信大家已經明白"
  },
  {
    "id": 152,
    "start": 468.72,
    "end": 471.04,
    "text": "Obsidian出現這三類問題"
  },
  {
    "id": 153,
    "start": 471.04,
    "end": 473.20000000000005,
    "text": "從來不是工具不夠強"
  },
  {
    "id": 154,
    "start": 473.20000000000005,
    "end": 474.96000000000004,
    "text": "也不是你單純懶"
  },
  {
    "id": 155,
    "start": 474.96000000000004,
    "end": 477.28000000000003,
    "text": "本質是我們的認知模式"
  },
  {
    "id": 156,
    "start": 477.28000000000003,
    "end": 479.76000000000005,
    "text": "行為習慣 知識流轉流程"
  },
  {
    "id": 157,
    "start": 479.76000000000005,
    "end": 483.36,
    "text": "和雙鏈筆記的設計邏輯完全錯配"
  },
  {
    "id": 158,
    "start": 483.52000000000004,
    "end": 486.40000000000003,
    "text": "記錄 處理 輸出 刪大環節"
  },
  {
    "id": 159,
    "start": 486.40000000000003,
    "end": 488.56,
    "text": "層層斷裂再強大的工具"
  },
  {
    "id": 160,
    "start": 488.56,
    "end": 491.92,
    "text": "最後也只會淪為普通的文檔倉庫"
  },
  {
    "id": 161,
    "start": 491.92,
    "end": 494.32,
    "text": "如果你也中了上面某一類問題"
  },
  {
    "id": 162,
    "start": 494.32,
    "end": 497.36,
    "text": "歡迎在彈幕和評論區抠對應的數字"
  },
  {
    "id": 163,
    "start": 497.36,
    "end": 499.36,
    "text": "覺得本期內容有收穫"
  },
  {
    "id": 164,
    "start": 499.36,
    "end": 501.68,
    "text": "別忘了點贊 收藏 轉發"
  },
  {
    "id": 165,
    "start": 501.68,
    "end": 503.12,
    "text": "我們下期再見"
  }
]