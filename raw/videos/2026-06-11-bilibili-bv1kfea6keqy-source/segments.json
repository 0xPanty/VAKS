[
  {
    "start": 0.0,
    "end": 1.28,
    "text": "Hello 大家好 我是王同学"
  },
  {
    "start": 1.28,
    "end": 2.8,
    "text": "欢迎来到I外科技"
  },
  {
    "start": 2.8,
    "end": 4.48,
    "text": "Gate比技大家都用过吗"
  },
  {
    "start": 4.48,
    "end": 7.12,
    "text": "它就是得到团队自家推出的比基软件"
  },
  {
    "start": 7.12,
    "end": 9.68,
    "text": "说实话 平时不用得到app的朋友"
  },
  {
    "start": 9.68,
    "end": 12.08,
    "text": "大概率也接触不到这款比基软件"
  },
  {
    "start": 12.08,
    "end": 16.0,
    "text": "它最核心的用处就是搭配得到里面的课程电子书使用"
  },
  {
    "start": 16.0,
    "end": 19.04,
    "text": "里面学到的内容能一键同步到Gate比技"
  },
  {
    "start": 19.04,
    "end": 21.2,
    "text": "平时看书画重点 写批注"
  },
  {
    "start": 21.2,
    "end": 24.08,
    "text": "还能自动整理成清晰比技和思维导图"
  },
  {
    "start": 24.08,
    "end": 26.32,
    "text": "作为AI智能知识记录工具"
  },
  {
    "start": 26.32,
    "end": 28.4,
    "text": "它的理念特别简单之败"
  },
  {
    "start": 28.4,
    "end": 29.6,
    "text": "你只管开口说"
  },
  {
    "start": 29.76,
    "end": 32.88,
    "text": "剩下整理记录的事全都交给AI来完成"
  },
  {
    "start": 32.88,
    "end": 35.76,
    "text": "今天我不讲如何从得到app到Gate比技"
  },
  {
    "start": 35.76,
    "end": 37.6,
    "text": "而是单纯的使用这款比技"
  },
  {
    "start": 37.6,
    "end": 39.68,
    "text": "看看它有哪些特色功能"
  },
  {
    "start": 39.68,
    "end": 42.0,
    "text": "和传统软件最大的不同是什么呢"
  },
  {
    "start": 42.0,
    "end": 44.24,
    "text": "传统软件是你写它存"
  },
  {
    "start": 44.24,
    "end": 47.04,
    "text": "Gate比技是你丢给它 它帮你整理"
  },
  {
    "start": 47.04,
    "end": 49.44,
    "text": "它的创始人打过一个很形象的比喻"
  },
  {
    "start": 49.44,
    "end": 52.16,
    "text": "把它当成AI时代的文件传输助手"
  },
  {
    "start": 52.16,
    "end": 54.56,
    "text": "你能把任何想要留存的内容喂给它"
  },
  {
    "start": 54.56,
    "end": 58.0,
    "text": "一段语音 一篇文章链接 一张照片 一份PDF"
  },
  {
    "start": 58.08,
    "end": 59.68,
    "text": "它会自动提取 理解"
  },
  {
    "start": 59.68,
    "end": 61.68,
    "text": "然后帮你整理成结构化的比技"
  },
  {
    "start": 61.68,
    "end": 64.08,
    "text": "你不需要考虑分类 标签 合适"
  },
  {
    "start": 64.08,
    "end": 65.36,
    "text": "甚至不需要打字"
  },
  {
    "start": 65.36,
    "end": 66.96,
    "text": "你只需要负责一件事"
  },
  {
    "start": 66.96,
    "end": 68.32,
    "text": "把信息丢进去"
  },
  {
    "start": 68.32,
    "end": 69.76,
    "text": "剩下的AI全包了"
  },
  {
    "start": 69.76,
    "end": 71.76,
    "text": "Gate比技已经接入了DeepSync的"
  },
  {
    "start": 71.76,
    "end": 72.96,
    "text": "满血版弹幕型"
  },
  {
    "start": 72.96,
    "end": 75.68,
    "text": "所以无论是语音转文字的润色精度"
  },
  {
    "start": 75.68,
    "end": 77.52,
    "text": "还是后续的知识库问答能力"
  },
  {
    "start": 77.52,
    "end": 79.12,
    "text": "都有模型层面的保障"
  },
  {
    "start": 79.12,
    "end": 81.52,
    "text": "Gate比技支持四种主要输入方式"
  },
  {
    "start": 81.52,
    "end": 84.32,
    "text": "基本涵盖了日常信息收集的所有场景"
  },
  {
    "start": 84.32,
    "end": 85.68,
    "text": "第一个 语音记录"
  },
  {
    "start": 85.68,
    "end": 87.44,
    "text": "打开app 点击录音按钮"
  },
  {
    "start": 87.44,
    "end": 89.52,
    "text": "说话 通听录上开会时"
  },
  {
    "start": 89.52,
    "end": 90.72,
    "text": "甚至躺在床上"
  },
  {
    "start": 90.72,
    "end": 92.72,
    "text": "如果突然有想法 直接说就行"
  },
  {
    "start": 92.72,
    "end": 94.96,
    "text": "AI会自动把语音转成文字"
  },
  {
    "start": 94.96,
    "end": 98.0,
    "text": "还能致的润色把口语中的NR去掉"
  },
  {
    "start": 98.0,
    "end": 99.92,
    "text": "把DN3导测的表达比清楚"
  },
  {
    "start": 99.92,
    "end": 101.2,
    "text": "整理成书面语"
  },
  {
    "start": 101.2,
    "end": 103.2,
    "text": "第二个就是链接转笔记"
  },
  {
    "start": 103.2,
    "end": 106.16,
    "text": "在公众号D站抖音小木书等平台"
  },
  {
    "start": 106.16,
    "end": 107.28,
    "text": "看到好的内容"
  },
  {
    "start": 107.28,
    "end": 108.96,
    "text": "复制链接发给Gate的笔记"
  },
  {
    "start": 108.96,
    "end": 110.48,
    "text": "它会自动抓取全文"
  },
  {
    "start": 110.48,
    "end": 112.64,
    "text": "并用AI生成经验总结"
  },
  {
    "start": 112.64,
    "end": 114.8,
    "text": "你不用再纠结先读完再复制"
  },
  {
    "start": 114.8,
    "end": 116.16,
    "text": "还是先复制再整理"
  },
  {
    "start": 116.16,
    "end": 117.36,
    "text": "它都帮你读了"
  },
  {
    "start": 117.36,
    "end": 119.04,
    "text": "第三个 图片转文字"
  },
  {
    "start": 119.04,
    "end": 120.24,
    "text": "拍照或者截图"
  },
  {
    "start": 120.24,
    "end": 122.56,
    "text": "Gate笔记可以识别图片中的文字"
  },
  {
    "start": 122.56,
    "end": 124.24,
    "text": "并整理成结构化的笔记"
  },
  {
    "start": 124.24,
    "end": 126.4,
    "text": "比如拍一张白板的会议记录"
  },
  {
    "start": 126.4,
    "end": 128.24,
    "text": "一张书页 一张PPT"
  },
  {
    "start": 128.24,
    "end": 129.84,
    "text": "AI会自动提取文字"
  },
  {
    "start": 129.84,
    "end": 131.52,
    "text": "省去手动录入的麻烦"
  },
  {
    "start": 131.52,
    "end": 133.04,
    "text": "第四个是文件上传"
  },
  {
    "start": 133.04,
    "end": 135.28,
    "text": "如果你有现成的PDF Word"
  },
  {
    "start": 135.28,
    "end": 136.96,
    "text": "ISL或者PPT文件"
  },
  {
    "start": 136.96,
    "end": 138.56,
    "text": "可以直接上传到知识库"
  },
  {
    "start": 138.56,
    "end": 141.36,
    "text": "Gate笔记的AI就能解析这些文件"
  },
  {
    "start": 141.36,
    "end": 143.68,
    "text": "并且与其他笔记内容建立关联"
  },
  {
    "start": 143.68,
    "end": 146.48,
    "text": "如果你以为Gate笔记只是一个智能收藏家"
  },
  {
    "start": 146.56,
    "end": 147.6,
    "text": "那就太浪费了"
  },
  {
    "start": 147.6,
    "end": 149.84,
    "text": "它真正厉害的地方是知识库功能"
  },
  {
    "start": 149.84,
    "end": 152.48,
    "text": "在App首页点击顶部的更多按钮"
  },
  {
    "start": 152.48,
    "end": 153.76,
    "text": "进入知识库页面"
  },
  {
    "start": 153.76,
    "end": 155.76,
    "text": "然后点击右上角的新键"
  },
  {
    "start": 155.76,
    "end": 157.52,
    "text": "就可以创建自己的知识库了"
  },
  {
    "start": 157.52,
    "end": 158.96,
    "text": "知识库可以做什么呢"
  },
  {
    "start": 158.96,
    "end": 160.4,
    "text": "第一个就是集中管理"
  },
  {
    "start": 160.4,
    "end": 162.32,
    "text": "你可以把上面所有输入的内容"
  },
  {
    "start": 162.32,
    "end": 164.96,
    "text": "语音记录 链接笔记 图片识别"
  },
  {
    "start": 164.96,
    "end": 167.44,
    "text": "上传文件都归笼到一个知识库里"
  },
  {
    "start": 167.44,
    "end": 170.32,
    "text": "按主题分类形成自己的私有知识库"
  },
  {
    "start": 170.32,
    "end": 172.4,
    "text": "第二就是订阅博主和直播"
  },
  {
    "start": 172.4,
    "end": 174.56,
    "text": "这是Gate笔记很亮眼的一个功能"
  },
  {
    "start": 174.64,
    "end": 176.64,
    "text": "你可以订阅特定的微信公众号"
  },
  {
    "start": 176.64,
    "end": 178.56,
    "text": "抖音博主 视频号博主"
  },
  {
    "start": 178.56,
    "end": 180.88,
    "text": "以及得到App和视频号的直播"
  },
  {
    "start": 180.88,
    "end": 183.84,
    "text": "订阅之后 AI会帮你追踪最新的内容"
  },
  {
    "start": 183.84,
    "end": 185.04,
    "text": "自动整理入库"
  },
  {
    "start": 185.04,
    "end": 187.04,
    "text": "比如你订阅了某个公众号"
  },
  {
    "start": 187.04,
    "end": 189.28,
    "text": "它每天会自动抓取新的文章"
  },
  {
    "start": 189.28,
    "end": 190.72,
    "text": "你订阅了一场直播"
  },
  {
    "start": 190.72,
    "end": 192.88,
    "text": "只需要把直播链接粘贴进去"
  },
  {
    "start": 192.88,
    "end": 194.4,
    "text": "AI会全程旁听"
  },
  {
    "start": 194.4,
    "end": 196.64,
    "text": "结束后会自动生成重点机要"
  },
  {
    "start": 196.64,
    "end": 197.92,
    "text": "还能回看原文"
  },
  {
    "start": 197.92,
    "end": 200.08,
    "text": "第三 上传文件补充内容"
  },
  {
    "start": 200.08,
    "end": 201.04,
    "text": "在知识库里"
  },
  {
    "start": 201.04,
    "end": 202.32,
    "text": "你还可以上传本地"
  },
  {
    "start": 202.32,
    "end": 204.48,
    "text": "PDF Word PVT等文件"
  },
  {
    "start": 204.56,
    "end": 206.56,
    "text": "把零散的文档和订阅博主的内容"
  },
  {
    "start": 206.56,
    "end": 207.6,
    "text": "整合在一起"
  },
  {
    "start": 207.6,
    "end": 209.36,
    "text": "进一步丰富你的知识库"
  },
  {
    "start": 209.36,
    "end": 210.16,
    "text": "举个例子"
  },
  {
    "start": 210.16,
    "end": 212.56,
    "text": "如果你在研究AI对教育的影响"
  },
  {
    "start": 212.56,
    "end": 214.88,
    "text": "可以创建一个AI加教育的知识库"
  },
  {
    "start": 214.88,
    "end": 218.0,
    "text": "然后把读过的行业报告PDF上传进去"
  },
  {
    "start": 218.0,
    "end": 219.92,
    "text": "订阅几个相关公众号的博主"
  },
  {
    "start": 219.92,
    "end": 222.88,
    "text": "把B站看到的深度分析视频链接丢进去"
  },
  {
    "start": 222.88,
    "end": 223.84,
    "text": "每次有灵感"
  },
  {
    "start": 223.84,
    "end": 225.28,
    "text": "用语音快速记录"
  },
  {
    "start": 225.28,
    "end": 226.88,
    "text": "所有和这个主题相关的内容"
  },
  {
    "start": 226.88,
    "end": 228.64,
    "text": "都会自动汇总到一个地方"
  },
  {
    "start": 228.64,
    "end": 229.6,
    "text": "随时调用"
  },
  {
    "start": 229.6,
    "end": 230.88,
    "text": "最后聊一下费用"
  },
  {
    "start": 230.96,
    "end": 232.96,
    "text": "盖的笔记的记录功能是免费的"
  },
  {
    "start": 232.96,
    "end": 234.08,
    "text": "包括语音记录"
  },
  {
    "start": 234.08,
    "end": 235.2,
    "text": "链接转笔记"
  },
  {
    "start": 235.2,
    "end": 236.08,
    "text": "图片识别"
  },
  {
    "start": 236.08,
    "end": 237.04,
    "text": "文件上传"
  },
  {
    "start": 237.04,
    "end": 238.16,
    "text": "知识库创建的"
  },
  {
    "start": 238.16,
    "end": 240.48,
    "text": "对于个人用户来说完全够用"
  },
  {
    "start": 240.48,
    "end": 243.44,
    "text": "复费版主要开放更高品次的API调用"
  },
  {
    "start": 243.44,
    "end": 245.2,
    "text": "更大容量的知识库存储"
  },
  {
    "start": 245.2,
    "end": 247.28,
    "text": "以及一些企业级的扩展能力"
  },
  {
    "start": 247.28,
    "end": 249.04,
    "text": "如果你只是日常记录灵感"
  },
  {
    "start": 249.04,
    "end": 249.84,
    "text": "收藏文章"
  },
  {
    "start": 249.84,
    "end": 250.8,
    "text": "行李学习资料"
  },
  {
    "start": 250.8,
    "end": 252.08,
    "text": "免费版足够了"
  },
  {
    "start": 252.08,
    "end": 255.04,
    "text": "反正同笔记软件的搜索是基于关键词的"
  },
  {
    "start": 255.04,
    "end": 257.36,
    "text": "你只要回忆出某个词才能搜到"
  },
  {
    "start": 257.44,
    "end": 259.36,
    "text": "但如果只是记得大概的意思"
  },
  {
    "start": 259.36,
    "end": 261.36,
    "text": "或者问题本身就很模糊"
  },
  {
    "start": 261.36,
    "end": 263.2,
    "text": "那传统搜索就失灵了"
  },
  {
    "start": 263.2,
    "end": 265.04,
    "text": "那盖的笔记的AI智能搜索"
  },
  {
    "start": 265.04,
    "end": 266.32,
    "text": "彻底改变了这件事"
  },
  {
    "start": 266.32,
    "end": 269.6,
    "text": "在App首页或知识库页面的输入框右侧"
  },
  {
    "start": 269.6,
    "end": 271.12,
    "text": "有一个智能搜索按钮"
  },
  {
    "start": 271.12,
    "end": 271.84,
    "text": "点击它"
  },
  {
    "start": 271.84,
    "end": 274.08,
    "text": "你可以用自然语言直接提问"
  },
  {
    "start": 274.08,
    "end": 276.24,
    "text": "AI会基于你所保存的笔记"
  },
  {
    "start": 276.24,
    "end": 278.48,
    "text": "文件和内容来寻找的案"
  },
  {
    "start": 278.48,
    "end": 279.76,
    "text": "并告诉你来源"
  },
  {
    "start": 279.76,
    "end": 280.72,
    "text": "哪条笔记"
  },
  {
    "start": 280.72,
    "end": 282.72,
    "text": "哪个段落都会标注出来"
  },
  {
    "start": 282.72,
    "end": 283.52,
    "text": "举例子"
  },
  {
    "start": 283.52,
    "end": 287.2,
    "text": "你之前在知识库里存了很多关于个人品牌的文章"
  },
  {
    "start": 287.2,
    "end": 288.8,
    "text": "但忘了具体的文件名"
  },
  {
    "start": 288.8,
    "end": 289.76,
    "text": "你可以直接问"
  },
  {
    "start": 289.76,
    "end": 291.84,
    "text": "我存了那些个人品牌的资料里"
  },
  {
    "start": 291.84,
    "end": 294.48,
    "text": "关于内容定位的核心观点有哪些"
  },
  {
    "start": 294.48,
    "end": 297.68,
    "text": "那AI会从你的笔记知识库里提取相关的信息"
  },
  {
    "start": 297.68,
    "end": 299.12,
    "text": "给出带出出的答案"
  },
  {
    "start": 299.12,
    "end": 300.48,
    "text": "真正的告别收藏了"
  },
  {
    "start": 300.48,
    "end": 301.76,
    "text": "但找不到的尴尬"
  },
  {
    "start": 301.76,
    "end": 302.88,
    "text": "除了全局搜索"
  },
  {
    "start": 302.88,
    "end": 305.52,
    "text": "你还可以和单条内容进行深度对话"
  },
  {
    "start": 305.52,
    "end": 308.08,
    "text": "点击打开一篇你保存的笔记"
  },
  {
    "start": 308.08,
    "end": 310.56,
    "text": "无论是你随手记的语音转文字"
  },
  {
    "start": 310.56,
    "end": 312.72,
    "text": "还是从公众号抓取的长文"
  },
  {
    "start": 312.72,
    "end": 314.88,
    "text": "页面底部都有一个对话框"
  },
  {
    "start": 314.88,
    "end": 316.64,
    "text": "你可以在这里向AI提问"
  },
  {
    "start": 316.72,
    "end": 319.84,
