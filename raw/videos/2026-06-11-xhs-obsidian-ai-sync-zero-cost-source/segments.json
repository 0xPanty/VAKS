[
  {
    "id": 0,
    "start": 0.0,
    "end": 1.2,
    "text": "大家好 我是蔡彩"
  },
  {
    "id": 1,
    "start": 1.2,
    "end": 4.2,
    "text": "還有多少人還在糾結Obsidian怎麽同步"
  },
  {
    "id": 2,
    "start": 4.2,
    "end": 6.8,
    "text": "網上關於Obsidian同步的教程非常多"
  },
  {
    "id": 3,
    "start": 6.8,
    "end": 9.4,
    "text": "但要麽就是配置非常複雜"
  },
  {
    "id": 4,
    "start": 9.4,
    "end": 10.6,
    "text": "要麽就是需要收費"
  },
  {
    "id": 5,
    "start": 10.6,
    "end": 13.0,
    "text": "那今天我想從少白的視角分享"
  },
  {
    "id": 6,
    "start": 13.0,
    "end": 17.0,
    "text": "我是如何凌晨本實現Obsidian多端同步的"
  },
  {
    "id": 7,
    "start": 17.0,
    "end": 18.7,
    "text": "其實非常簡單 有所就會"
  },
  {
    "id": 8,
    "start": 18.7,
    "end": 21.9,
    "text": "那我會從以下幾個部分介紹Obsidian同步的方法"
  },
  {
    "id": 9,
    "start": 21.9,
    "end": 24.2,
    "text": "第一部分 市面上現有的同步方案"
  },
  {
    "id": 10,
    "start": 24.2,
    "end": 27.0,
    "text": "各自的優劣室以及不同方案適應的人群"
  },
  {
    "id": 11,
    "start": 27.0,
    "end": 30.4,
    "text": "第二部分我清測過的同步方案以及B坑點"
  },
  {
    "id": 12,
    "start": 30.4,
    "end": 33.3,
    "text": "第三部分我最終選擇的方案以及手玩手的教程"
  },
  {
    "id": 13,
    "start": 33.3,
    "end": 36.0,
    "text": "第四個部分就是我踩過的坑以及如何避免"
  },
  {
    "id": 14,
    "start": 36.0,
    "end": 39.4,
    "text": "那目前市面上Obsidian的同步方法大概分為以下幾種"
  },
  {
    "id": 15,
    "start": 39.4,
    "end": 41.4,
    "text": "大致對應了兩類人群"
  },
  {
    "id": 16,
    "start": 41.4,
    "end": 44.0,
    "text": "上面四個適合沒有技術背景的普通人"
  },
  {
    "id": 17,
    "start": 44.0,
    "end": 47.4,
    "text": "下面三個相對需要一些編程的基礎"
  },
  {
    "id": 18,
    "start": 47.4,
    "end": 49.4,
    "text": "那我會重點分析前四個方案"
  },
  {
    "id": 19,
    "start": 49.4,
    "end": 50.8,
    "text": "因為我本身就是小白"
  },
  {
    "id": 20,
    "start": 50.8,
    "end": 52.8,
    "text": "後面三個對我來說有一定的難度"
  },
  {
    "id": 21,
    "start": 52.8,
    "end": 54.5,
    "text": "第一個最方便最穩定"
  },
  {
    "id": 22,
    "start": 54.5,
    "end": 56.4,
    "text": "毫無疑問就是官方同步"
  },
  {
    "id": 23,
    "start": 56.4,
    "end": 59.2,
    "text": "那唯一的劣勢就是收費每個月最少4美元"
  },
  {
    "id": 24,
    "start": 59.2,
    "end": 62.4,
    "text": "那這種就特別適合那種途省市不差錢的人"
  },
  {
    "id": 25,
    "start": 62.4,
    "end": 63.8,
    "text": "第二個就是iCloud"
  },
  {
    "id": 26,
    "start": 63.8,
    "end": 68.5,
    "text": "官方同步和iCloud同步是Obsidian官方認可的僅有的兩種方案"
  },
  {
    "id": 27,
    "start": 68.5,
    "end": 70.0,
    "text": "如果你是純蘋果用戶"
  },
  {
    "id": 28,
    "start": 70.0,
    "end": 72.0,
    "text": "iCloud無疑是最有的解"
  },
  {
    "id": 29,
    "start": 72.0,
    "end": 74.6,
    "text": "5G的免費同步空間 同步速度幾快"
  },
  {
    "id": 30,
    "start": 74.6,
    "end": 76.9,
    "text": "但它不適合Windows用戶"
  },
  {
    "id": 31,
    "start": 76.9,
    "end": 79.2,
    "text": "雖然也有Windows版的iCloud"
  },
  {
    "id": 32,
    "start": 79.2,
    "end": 80.4,
    "text": "但它極其不穩定"
  },
  {
    "id": 33,
    "start": 80.4,
    "end": 81.1,
    "text": "不建議嘗試"
  },
  {
    "id": 34,
    "start": 81.1,
    "end": 82.9,
    "text": "第三個是網盤同步"
  },
  {
    "id": 35,
    "start": 82.9,
    "end": 85.4,
    "text": "像OneDrive Google Drive或者江國雲"
  },
  {
    "id": 36,
    "start": 85.4,
    "end": 87.2,
    "text": "都提供了一定的免費存存空間"
  },
  {
    "id": 37,
    "start": 87.2,
    "end": 88.4,
    "text": "且支持實施同步"
  },
  {
    "id": 38,
    "start": 88.4,
    "end": 90.0,
    "text": "純電腦使用非常實用"
  },
  {
    "id": 39,
    "start": 90.0,
    "end": 91.3,
    "text": "但如果需要手機同步"
  },
  {
    "id": 40,
    "start": 91.3,
    "end": 92.4,
    "text": "這個方法也不太適合"
  },
  {
    "id": 41,
    "start": 92.4,
    "end": 95.0,
    "text": "第四個是通過Obsidian插件實現的"
  },
  {
    "id": 42,
    "start": 95.0,
    "end": 97.0,
    "text": "這個也是我接下來要重點講的方案"
  },
  {
    "id": 43,
    "start": 97.0,
    "end": 98.8,
    "text": "這個方案非常適合像我這樣"
  },
  {
    "id": 44,
    "start": 98.8,
    "end": 100.2,
    "text": "沒有技術背景的小白"
  },
  {
    "id": 45,
    "start": 100.2,
    "end": 104.4,
    "text": "同時擁有蘋果Windows Android等多品牌的設備用戶"
  },
  {
    "id": 46,
    "start": 104.4,
    "end": 106.6,
    "text": "那我最初用的是Google Drive的同步插件"
  },
  {
    "id": 47,
    "start": 106.6,
    "end": 109.5,
    "text": "但這個插件對網絡穩定性要求極高"
  },
  {
    "id": 48,
    "start": 109.5,
    "end": 112.7,
    "text": "稍有波動就會要求你重新輸入Refresh"
  },
  {
    "id": 49,
    "start": 112.7,
    "end": 115.0,
    "text": "而且它需要你Obsidian的倉庫是空的"
  },
  {
    "id": 50,
    "start": 115.0,
    "end": 116.2,
    "text": "它才可以同步"
  },
  {
    "id": 51,
    "start": 116.2,
    "end": 118.0,
    "text": "這個過程就會非常的繁瑣"
  },
  {
    "id": 52,
    "start": 118.0,
    "end": 120.6,
    "text": "第二個我嘗試過的就是堅果雲"
  },
  {
    "id": 53,
    "start": 120.6,
    "end": 123.0,
    "text": "因為畢竟是國內的產品"
  },
  {
    "id": 54,
    "start": 123.0,
    "end": 125.6,
    "text": "用起來它的同步速度肯定會更快"
  },
  {
    "id": 55,
    "start": 125.6,
    "end": 127.2,
    "text": "但免費版有一個致命的弊端"
  },
  {
    "id": 56,
    "start": 127.2,
    "end": 128.2,
    "text": "就是線流"
  },
  {
    "id": 57,
    "start": 128.2,
    "end": 129.9,
    "text": "它不限你儲存量"
  },
  {
    "id": 58,
    "start": 129.9,
    "end": 132.1,
    "text": "但限制上傳和下載的流量"
  },
  {
    "id": 59,
    "start": 132.1,
    "end": 133.3,
    "text": "一次上傳內容太多"
  },
  {
    "id": 60,
    "start": 133.3,
    "end": 134.3,
    "text": "就會被卡住"
  },
  {
    "id": 61,
    "start": 134.3,
    "end": 136.6,
    "text": "你要等到半個小時以後才能去同步"
  },
  {
    "id": 62,
    "start": 136.6,
    "end": 140.1,
    "text": "但是像我這種剛開始倉庫本來的內容就比較多"
  },
  {
    "id": 63,
    "start": 140.1,
    "end": 141.7,
    "text": "那就直接觸發線流"
  },
  {
    "id": 64,
    "start": 141.7,
    "end": 142.8,
    "text": "根本沒有辦法解決"
  },
  {
    "id": 65,
    "start": 142.8,
    "end": 143.7,
    "text": "除非你去付費"
  },
  {
    "id": 66,
    "start": 143.7,
    "end": 145.5,
    "text": "但是面上免費的方案那麼多"
  },
  {
    "id": 67,
    "start": 145.5,
    "end": 147.5,
    "text": "所以這個方案我也果斷的就放棄掉了"
  },
  {
    "id": 68,
    "start": 147.5,
    "end": 151.3,
    "text": "那我最終選擇了Obsidian的第三方的插件"
  },
  {
    "id": 69,
    "start": 151.3,
    "end": 153.5,
    "text": "Remountless Safe加OneDrive這個搭配"
  },
  {
    "id": 70,
    "start": 153.5,
    "end": 155.2,
    "text": "那為什麼選擇這個插件呢"
  },
  {
    "id": 71,
    "start": 155.2,
    "end": 157.3,
    "text": "因為這個插件它上限的時間夠久"
  },
  {
    "id": 72,
    "start": 157.3,
    "end": 158.5,
    "text": "下載量足夠大"
  },
  {
    "id": 73,
    "start": 158.5,
    "end": 160.8,
    "text": "穩定性也是經過了充分的驗證"
  },
  {
    "id": 74,
    "start": 160.8,
    "end": 162.5,
    "text": "因為你既然要靠插件同步"
  },
  {
    "id": 75,
    "start": 162.5,
    "end": 164.2,
    "text": "穩定性它一定是第一要做的"
  },
  {
    "id": 76,
    "start": 164.2,
    "end": 165.3,
    "text": "為什麼選OneDrive"
  },
  {
    "id": 77,
    "start": 165.3,
    "end": 167.9,
    "text": "首先它的個人版免費有5G的空間"
  },
  {
    "id": 78,
    "start": 167.9,
    "end": 170.2,
    "text": "像我這種以文字記錄為主的倉庫來說"
  },
  {
    "id": 79,
    "start": 170.2,
    "end": 171.7,
    "text": "其實是錯錯有餘的"
  },
  {
    "id": 80,
    "start": 171.7,
    "end": 173.4,
    "text": "那接下來我們講一下具體怎麼操作"
  },
  {
    "id": 81,
    "start": 173.4,
    "end": 175.2,
    "text": "首先要準備兩樣東西"
  },
  {
    "id": 82,
    "start": 175.2,
    "end": 177.3,
    "text": "第一個是微軟的帳號"
  },
  {
    "id": 83,
    "start": 177.3,
    "end": 179.2,
    "text": "我建議是使用舊帳號"
  },
  {
    "id": 84,
    "start": 179.2,
    "end": 181.5,
    "text": "因為我測試過新駐車帳號"
  },
  {
    "id": 85,
    "start": 181.5,
    "end": 183.5,
    "text": "會反覆卡在人機驗證環節"
  },
  {
    "id": 86,
    "start": 183.5,
    "end": 184.4,
    "text": "很難通過"
  },
  {
    "id": 87,
    "start": 184.4,
    "end": 185.8,
    "text": "有成功繞過的小夥伴"
  },
  {
    "id": 88,
    "start": 185.8,
    "end": 187.8,
    "text": "可以在評論區分享一下方法"
  },
  {
    "id": 89,
    "start": 187.8,
    "end": 189.5,
    "text": "第二個就是下載Obsidian"
  },
  {
    "id": 90,
    "start": 189.5,
    "end": 192.0,
    "text": "這個直接可以搜索官網可以免費下載"
  },
  {
    "id": 91,
    "start": 192.0,
    "end": 195.5,
    "text": "但在一切操作之前一定要備份備份備份"
  },
  {
    "id": 92,
    "start": 195.5,
    "end": 197.4,
    "text": "因為這些是第三方的插件"
  },
  {
    "id": 93,
    "start": 197.4,
    "end": 198.5,
    "text": "有可能會出錯"
  },
  {
    "id": 94,
    "start": 198.5,
    "end": 199.4,
    "text": "一定要做好備份"
  },
  {
    "id": 95,
    "start": 199.4,
    "end": 201.0,
    "text": "好用Obsidian打開倉庫"
  },
  {
    "id": 96,
    "start": 201.0,
    "end": 202.4,
    "text": "沒有的話可以新建一個"
  },
  {
    "id": 97,
    "start": 202.4,
    "end": 204.0,
    "text": "點擊左下角的齒輪圖表"
  },
  {
    "id": 98,
    "start": 204.0,
    "end": 205.6,
    "text": "在第三方插件裡面"
  },
  {
    "id": 99,
    "start": 205.6,
    "end": 206.9,
    "text": "搜索Limone Drive Safe"
  },
  {
    "id": 100,
    "start": 206.9,
    "end": 208.7,
    "text": "啟用後進入插件的設置頁面"
  },
  {
    "id": 101,
    "start": 208.7,
    "end": 211.3,
    "text": "首先在遠程服務這裡選擇OneDrive"
  },
  {
    "id": 102,
    "start": 211.3,
    "end": 213.8,
    "text": "然後點擊這裡的鍵圈按鈕"
  },
  {
    "id": 103,
    "start": 213.8,
    "end": 215.1,
    "text": "直接點擊這裡的鏈接"
  },
  {
    "id": 104,
    "start": 215.1,
    "end": 217.5,
    "text": "它會自動跳轉微軟的登入頁面"
  },
  {
    "id": 105,
    "start": 217.5,
    "end": 218.6,
    "text": "登入成功後"
  },
  {
    "id": 106,
    "start": 218.6,
    "end": 220.3,
    "text": "我們直接關閉返回Obsidian"
  },
  {
    "id": 107,
    "start": 220.3,
    "end": 222.4,
    "text": "稍等片刻就可以看到授權成功"
  },
  {
    "id": 108,
    "start": 222.4,
    "end": 223.9,
    "text": "在遠端跟文件夾中"
  },
  {
    "id": 109,
    "start": 223.9,
    "end": 225.8,
    "text": "確定這個文件名稱和"
  },
  {
    "id": 110,
    "start": 225.8,
    "end": 228.2,
    "text": "我們本地倉庫名稱是完全一致的"
  },
  {
    "id": 111,
    "start": 228.2,
    "end": 229.6,
    "text": "往下拉到基本設置"
  },
  {
    "id": 112,
    "start": 229.6,
    "end": 230.7,
    "text": "找到自行設置設置"
  },
  {
    "id": 113,
    "start": 230.7,
    "end": 232.4,
    "text": "你想要同步的頻率"
  },
  {
    "id": 114,
    "start": 232.4,
    "end": 234.3,
    "text": "電腦端我一般設置是10分鐘"
  },
  {
    "id": 115,
    "start": 234.3,
    "end": 235.2,
    "text": "或半個小時"
  },
  {
    "id": 116,
    "start": 235.2,
    "end": 238.0,
    "text": "並可開啟啟動後自行同步一次"
  },
  {
    "id": 117,
    "start": 238.0,
    "end": 239.8,
    "text": "再往下拉到進階設置"
  },
  {
    "id": 118,
    "start": 239.8,
    "end": 240.6,
    "text": "找到必行數"
  },
  {
    "id": 119,
    "start": 240.6,
    "end": 244.0,
    "text": "這裡就是你同時上傳和下載的文件數量"
  },
  {
    "id": 120,
    "start": 244.0,
    "end": 245.4,
    "text": "默認數值是5"
  },
  {
    "id": 121,
    "start": 245.4,
    "end": 247.1,
    "text": "我建議改到1和2"
  },
  {
    "id": 122,
    "start": 247.1,
    "end": 249.1,
    "text": "因為數值太大容易卡住"
  },
  {
    "id": 123,
    "start": 249.1,
    "end": 250.2,
    "text": "會導致同步失敗"
  },
  {
    "id": 124,
    "start": 250.2,
    "end": 251.5,
    "text": "其他的基本可以不動"
  },
  {
    "id": 125,
    "start": 251.5,
    "end": 253.0,
    "text": "但有一個非常關鍵的地方"
  },
  {
    "id": 126,
    "start": 253.0,
    "end": 254.0,
    "text": "就是這個同步方向"
  },
  {
    "id": 127,
    "start": 254.0,
    "end": 256.4,
    "text": "如果你想把電腦端的內容傳出到雲端"
  },
  {
    "id": 128,
    "start": 256.4,
    "end": 258.1,
    "text": "那你可以選擇增量對送"
  },
  {
    "id": 129,
    "start": 258.1,
    "end": 260.4,
    "text": "如果你想把雲端的內容下載到你的"
  },
  {
    "id": 130,
    "start": 260.5,
    "end": 262.9,
    "text": "倉庫你可以選擇增量拉取"
  },
  {
    "id": 131,
    "start": 262.9,
    "end": 265.1,
    "text": "它這個下面有非常清晰的說明"
  },
  {
    "id": 132,
    "start": 265.1,
    "end": 265.9,
    "text": "那設置好以後"
  },
  {
    "id": 133,
    "start": 265.9,
    "end": 268.0,
    "text": "Obsidian就會自動按間隔同步"
  },
  {
    "id": 134,
    "start": 268.0,
    "end": 270.2,
    "text": "此外還有兩種首都同步的方法"
  },
  {
    "id": 135,
    "start": 270.2,
    "end": 273.8,
    "text": "第一就是點擊工具欄的這個圓圈按鈕"
  },
  {
    "id": 136,
    "start": 273.8,
    "end": 276.4,
    "text": "第二個就是打開命令面板輸入"
  },
  {
    "id": 137,
    "start": 276.4,
    "end": 278.7,
    "text": "原本下來點擊第一個就可以開始同步"
  },
  {
    "id": 138,
    "start": 278.7,
    "end": 279.6,
    "text": "如果同步失敗"
  },
  {
    "id": 139,
    "start": 279.6,
    "end": 282.9,
    "text": "可以檢查一下修改這裡的超過百分比折"
  },
  {
    "id": 140,
    "start": 282.9,
    "end": 284.4,
    "text": "宗旨同步這個設置"
  },
  {
    "id": 141,
    "start": 284.4,
    "end": 285.9,
    "text": "這個是插贊的一個保護機制"
  },
  {
    "id": 142,
    "start": 285.9,
    "end": 287.4,
    "text": "變更內容超過設定的百分比"
  },
  {
    "id": 143,
    "start": 287.4,
    "end": 289.1,
    "text": "就會自動停止更新"
  },
  {
    "id": 144,
    "start": 289.1,
    "end": 292.1,
    "text": "我個人設的是百分百相當於關閉了保護"
  },
  {
    "id": 145,
    "start": 292.1,
    "end": 294.1,
    "text": "大家可以根據實際需要調整"
  },
  {
    "id": 146,
    "start": 294.1,
    "end": 297.6,
    "text": "麥克和iPhone端的配置流程和Windows基本保持一致"
  },
  {
    "id": 147,
    "start": 297.6,
    "end": 299.8,
    "text": "唯要注意一點的是倉庫名稱"
  },
  {
    "id": 148,
    "start": 299.8,
    "end": 302.0,
    "text": "必須每個端口都完全相同"
  },
  {
    "id": 149,
    "start": 302.0,
    "end": 304.4,
    "text": "我手機端設置的是增量推送"
  },
  {
    "id": 150,
    "start": 304.4,
    "end": 307.0,
    "text": "手機上的內容會同步到雲端"
  },
  {
    "id": 151,
    "start": 307.0,
    "end": 309.4,
    "text": "但雲端的內容不會下載到手機"
  },
  {
    "id": 152,
    "start": 309.4,
    "end": 311.4,
    "text": "這樣也可以節省手機的空間"
  },
  {
    "id": 153,
    "start": 311.4,
    "end": 314.9,
    "text": "然後我強烈建議開啟手機端的狀態欄顯示"
  },
  {
    "id": 154,
    "start": 314.9,
    "end": 317.1,
    "text": "這樣手機底部會實時顯示同步的狀態"
  },
  {
    "id": 155,
    "start": 317.1,
    "end": 318.7,
    "text": "讓你可以隨時掌握同步"
  },
  {
    "id": 156,
    "start": 318.7,
    "end": 319.4,
    "text": "是否正常"
  },
  {
    "id": 157,
    "start": 319.4,
    "end": 320.9,
    "text": "最後我想跟大家分享一下"
  },
  {
    "id": 158,
    "start": 320.9,
    "end": 324.4,
    "text": "在使用Obsidian同步的這些方法中需要避坑的地方"
  },
  {
    "id": 159,
    "start": 324.4,
    "end": 326.5,
    "text": "第一個就是Obsidian中默認"
  },
  {
    "id": 160,
    "start": 326.5,
    "end": 329.3,
    "text": "它是不同步點Obsidian文件夾的"
  },
  {
    "id": 161,
    "start": 329.3,
    "end": 332.6,
    "text": "這裡面存放的是你的基礎設置和插件的配置"
  },
  {
    "id": 162,
    "start": 332.6,
    "end": 335.3,
    "text": "如果你想把插件配置移動到另一端電腦"
  },
  {
    "id": 163,
    "start": 335.3,
    "end": 338.3,
    "text": "建議直接把Obsidian的文件夾手動備分到網盤"
  },
  {
    "id": 164,
    "start": 338.3,
    "end": 342.6,
    "text": "需要的時候直接下載下來覆蓋掉原來點Obsidian的文件夾就可以了"
  },
  {
    "id": 165,
    "start": 342.6,
    "end": 345.6,
    "text": "這個比在插件中同步會更加簡單可靠一點"
  },
  {
    "id": 166,
    "start": 345.6,
    "end": 348.1,
    "text": "第二個也成堅上一點就是不要打開"
  },
  {
    "id": 167,
    "start": 348.1,
    "end": 351.2,
    "text": "同步配置文件夾Obsidian配置文件不需要同步"
  },
  {
    "id": 168,
    "start": 351.2,
    "end": 353.6,
    "text": "否則會引起多端配置衝突"
  },
  {
    "id": 169,
    "start": 353.6,
    "end": 356.1,
    "text": "第三個就是打開同步狀態"
  },
  {
    "id": 170,
    "start": 356.1,
    "end": 358.6,
    "text": "隨時可以查看右下角的同步情況"
  },
  {
    "id": 171,
    "start": 358.6,
    "end": 361.7,
    "text": "第四個也是最重要的一點就是養成備分的習慣"
  },
  {
    "id": 172,
    "start": 361.7,
    "end": 362.8,
    "text": "無論同步多麼穩定"
  },
  {
    "id": 173,
    "start": 362.8,
    "end": 364.8,
    "text": "我們每周都可以定期的備分一下"
  },
  {
    "id": 174,
    "start": 364.8,
    "end": 367.9,
    "text": "好啦 以上就是Obsidian同步的方法"
  },
  {
    "id": 175,
    "start": 367.9,
    "end": 369.4,
    "text": "如果這些視頻對你有幫助"
  },
  {
    "id": 176,
    "start": 369.4,
    "end": 371.0,
    "text": "歡迎點贊收藏關注我是太太"
  }
]