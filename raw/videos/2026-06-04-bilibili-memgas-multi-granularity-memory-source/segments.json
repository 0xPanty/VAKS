[
  {
    "start": 0.0,
    "end": 3.52,
    "text": "晴天聊一篇对话智能体长期记忆的论文"
  },
  {
    "start": 4.2,
    "end": 5.84,
    "text": "他问的问题很具体"
  },
  {
    "start": 6.24,
    "end": 8.72,
    "text": "如果一个用户和 agent 聊了几个月"
  },
  {
    "start": 9.2,
    "end": 11.68,
    "text": "系统到底应该记住整段对话"
  },
  {
    "start": 11.96,
    "end": 14.84,
    "text": "每一句细节摘药还是关键词"
  },
  {
    "start": 15.32,
    "end": 16.84,
    "text": "mangas的回答是"
  },
  {
    "start": 17.16,
    "end": 18.24,
    "text": "不能只选一个"
  },
  {
    "start": 18.24,
    "end": 20.6,
    "text": "听起来像是记忆力度的问题"
  },
  {
    "start": 20.84,
    "end": 22.52,
    "text": "为什么只选一个会出事"
  },
  {
    "start": 22.76,
    "end": 24.84,
    "text": "这篇论文的核心主张是"
  },
  {
    "start": 25.2,
    "end": 28.44,
    "text": "长期记忆不只是减所最相似片段"
  },
  {
    "start": 28.76,
    "end": 30.84,
    "text": "而是要同时见多力度记忆"
  },
  {
    "start": 31.08,
    "end": 32.72,
    "text": "见力跨记忆关联"
  },
  {
    "start": 33.0,
    "end": 34.44,
    "text": "并在每次查询时"
  },
  {
    "start": 34.68,
    "end": 36.48,
    "text": "自适用选择核实力度"
  },
  {
    "start": 36.88,
    "end": 38.84,
    "text": "否则出力度容易带造生"
  },
  {
    "start": 39.08,
    "end": 41.0,
    "text": "细力度又容易丢上下文"
  },
  {
    "start": 41.0,
    "end": 42.32,
    "text": "先说就做法"
  },
  {
    "start": 43.08,
    "end": 45.56,
    "text": "现有对话记忆系统通常怎么做"
  },
  {
    "start": 45.56,
    "end": 46.4,
    "text": "很多方法"
  },
  {
    "start": 46.4,
    "end": 47.92,
    "text": "严用 RIG 思路"
  },
  {
    "start": 48.16,
    "end": 51.0,
    "text": "把历史对话切成Saturn Summary"
  },
  {
    "start": 51.0,
    "end": 53.4,
    "text": "或topic chunk再做相量减所"
  },
  {
    "start": 53.68,
    "end": 55.56,
    "text": "有的进一步做数或图"
  },
  {
    "start": 55.84,
    "end": 57.84,
    "text": "但常常还是围绕单一层级"
  },
  {
    "start": 58.12,
    "end": 59.88,
    "text": "比如实体图或摘药树"
  },
  {
    "start": 60.12,
    "end": 62.96,
    "text": "问题是用户问题经常跨会化"
  },
  {
    "start": 62.96,
    "end": 64.6,
    "text": "跨主题跨时间"
  },
  {
    "start": 64.92,
    "end": 67.48,
    "text": "单一力度很难同时保留细节和关系"
  },
  {
    "start": 67.64,
    "end": 70.36,
    "text": "它和我们前面聊过的上下文管理"
  },
  {
    "start": 70.36,
    "end": 72.48,
    "text": "技能库论文有什么关系"
  },
  {
    "start": 72.48,
    "end": 75.96,
    "text": "可以把它放在同一个 agent 系统地图里"
  },
  {
    "start": 76.32,
    "end": 78.88,
    "text": "AgentSwin 讨论常识 WebAgent"
  },
  {
    "start": 79.0,
    "end": 81.24,
    "text": "该怎样选择上下文处理度线"
  },
  {
    "start": 81.64,
    "end": 84.52,
    "text": "Graph 讨论技能怎样编一程執行图"
  },
  {
    "start": 84.84,
    "end": 87.44,
    "text": "Skill 临和Skill 一讨论经验"
  },
  {
    "start": 87.52,
    "end": 89.36,
    "text": "怎样变成技能或参数"
  },
  {
    "start": 89.68,
    "end": 91.28,
    "text": "Memgas 更底层一些"
  },
  {
    "start": 91.56,
    "end": 93.6,
    "text": "它处理的是用户长期对话"
  },
  {
    "start": 93.6,
    "end": 95.72,
    "text": "怎样被保存联想和照回"
  },
  {
    "start": 95.72,
    "end": 97.48,
    "text": "这片论文来自哪里"
  },
  {
    "start": 97.48,
    "end": 98.64,
    "text": "论文标题是"
  },
  {
    "start": 98.64,
    "end": 100.96,
    "text": "from single to multi granularity"
  },
  {
    "start": 101.28,
    "end": 103.64,
    "text": "tort long term memory association"
  },
  {
    "start": 103.64,
    "end": 106.12,
    "text": "and selection of conversational agents"
  },
  {
    "start": 106.48,
    "end": 109.96,
    "text": "最终版标注为 ICLR-2026"
  },
  {
    "start": 109.96,
    "end": 112.44,
    "text": "作者来自中国科学技术大学"
  },
  {
    "start": 112.6,
    "end": 115.12,
    "text": "香港城市大学 华为等机构"
  },
  {
    "start": 115.4,
    "end": 117.64,
    "text": "核心作者包括许德荣等人"
  },
  {
    "start": 117.64,
    "end": 119.88,
    "text": "那四种机力度具体是什么"
  },
  {
    "start": 119.88,
    "end": 123.52,
    "text": "第一是三审级保留一整段会化"
  },
  {
    "start": 123.76,
    "end": 125.32,
    "text": "适合看完整背景"
  },
  {
    "start": 125.56,
    "end": 128.4,
    "text": "第二是Torrent机保留具体论刺"
  },
  {
    "start": 128.4,
    "end": 131.04,
    "text": "适合找日期 人民 数量"
  },
  {
    "start": 131.36,
    "end": 133.0,
    "text": "第三是SummerEasy"
  },
  {
    "start": 133.0,
    "end": 135.12,
    "text": "用LLM压缩话题"
  },
  {
    "start": 135.44,
    "end": 136.92,
    "text": "第四是Keyword机"
  },
  {
    "start": 136.92,
    "end": 139.68,
    "text": "用关键词和实体做精确矛点"
  },
  {
    "start": 140.0,
    "end": 143.4,
    "text": "四类信息一起构成一个多力度级单元"
  },
  {
    "start": 143.44,
    "end": 145.2,
    "text": "但把四种都存下来"
  },
  {
    "start": 145.2,
    "end": 147.36,
    "text": "不就只是多见几个所以吗"
  },
  {
    "start": 147.48,
    "end": 150.08,
    "text": "关键不只是存 而是关联"
  },
  {
    "start": 150.4,
    "end": 152.0,
    "text": "新对话进来时"
  },
  {
    "start": 152.0,
    "end": 155.4,
    "text": "MemGas会把不同力度编码程向量"
  },
  {
    "start": 155.4,
    "end": 157.76,
    "text": "和历史记忆比较相似度"
  },
  {
    "start": 157.92,
    "end": 159.84,
    "text": "再用高撕混合模型"
  },
  {
    "start": 159.84,
    "end": 163.44,
    "text": "把历史记忆分成相关集合和无关集合"
  },
  {
    "start": 163.72,
    "end": 167.6,
    "text": "相关的就记才会和新记忆连边进入关联图"
  },
  {
    "start": 167.6,
    "end": 170.16,
    "text": "为什么这里要用高撕混合模型"
  },
  {
    "start": 170.2,
    "end": 173.6,
    "text": "它解决的是哪些旧记忆值得连边"
  },
  {
    "start": 173.96,
    "end": 175.68,
    "text": "如果只按固定预值"
  },
  {
    "start": 175.68,
    "end": 177.56,
    "text": "很容易受数据分布影响"
  },
  {
    "start": 178.04,
    "end": 180.68,
    "text": "GM们把相似度看成两类分布"
  },
  {
    "start": 180.92,
    "end": 182.6,
    "text": "一类更像相关级"
  },
  {
    "start": 182.6,
    "end": 184.2,
    "text": "一类更像无关级"
  },
  {
    "start": 184.56,
    "end": 187.52,
    "text": "这样新级不会瞒目连到所有历史"
  },
  {
    "start": 187.72,
    "end": 190.04,
    "text": "而是指强化比较可信的关联"
  },
  {
    "start": 190.04,
    "end": 191.4,
    "text": "查询来了以后"
  },
  {
    "start": 191.4,
    "end": 193.52,
    "text": "它怎么决定该用哪种力度"
  },
  {
    "start": 193.52,
    "end": 195.56,
    "text": "这里用的是商路游汽"
  },
  {
    "start": 195.92,
    "end": 196.96,
    "text": "系统分别看"
  },
  {
    "start": 196.96,
    "end": 200.08,
    "text": "查询在Session, Turn, Summary, Keyword"
  },
  {
    "start": 200.08,
    "end": 202.12,
    "text": "四种力度上的相似度分布"
  },
  {
    "start": 202.44,
    "end": 204.36,
    "text": "如果某个力度的分布很集中"
  },
  {
    "start": 204.56,
    "end": 206.96,
    "text": "商低说明匹配更确定"
  },
  {
    "start": 206.96,
    "end": 208.36,
    "text": "就给它更高权重"
  },
  {
    "start": 208.68,
    "end": 209.84,
    "text": "如果分布很散"
  },
  {
    "start": 209.84,
    "end": 211.72,
    "text": "说明不确定就降低权重"
  },
  {
    "start": 211.96,
    "end": 214.48,
    "text": "能不能把这个商掌的更直观一点"
  },
  {
    "start": 214.48,
    "end": 215.8,
    "text": "比如用户问我"
  },
  {
    "start": 216.08,
    "end": 218.2,
    "text": "总共完成了几门再现课程"
  },
  {
    "start": 218.52,
    "end": 223.52,
    "text": "Turn 其可能能精确命中三门Coursera和两门EDX"
  },
  {
    "start": 224.08,
    "end": 226.72,
    "text": "而Session集会带出很多学习计划"
  },
  {
    "start": 226.76,
    "end": 227.8,
    "text": "和职业建议"
  },
  {
    "start": 228.28,
    "end": 229.96,
    "text": "此时稀里度更确定"
  },
  {
    "start": 230.56,
    "end": 231.16,
    "text": "反过来"
  },
  {
    "start": 231.44,
    "end": 234.24,
    "text": "如果用户问我最近主要在规划什么"
  },
  {
    "start": 234.6,
    "end": 237.16,
    "text": "Session或Summary可能更合适"
  },
  {
    "start": 237.16,
    "end": 239.72,
    "text": "评论里提到一些检索选扭"
  },
  {
    "start": 240.12,
    "end": 241.88,
    "text": "比如种子节点和温度"
  },
  {
    "start": 242.28,
    "end": 243.48,
    "text": "论文里怎么理解"
  },
  {
    "start": 243.48,
    "end": 246.04,
    "text": "论文最清楚验证的是两个选扭"
  },
  {
    "start": 246.24,
    "end": 247.88,
    "text": "先选若干Seed Notes"
  },
  {
    "start": 248.32,
    "end": 250.88,
    "text": "在在图上做Personalized Page Rank"
  },
  {
    "start": 251.0,
    "end": 252.4,
    "text": "附陆里Seed Notes"
  },
  {
    "start": 252.8,
    "end": 254.88,
    "text": "在约15附近效果就好"
  },
  {
    "start": 255.28,
    "end": 258.04,
    "text": "商温度参数在约0.2附近教文"
  },
  {
    "start": 258.56,
    "end": 260.04,
    "text": "重点不是固定数值"
  },
  {
    "start": 260.4,
    "end": 262.0,
    "text": "而是让联想可以擴散"
  },
  {
    "start": 262.36,
    "end": 263.88,
    "text": "但不能无边界擴散"
  },
  {
    "start": 263.88,
    "end": 266.36,
    "text": "图传播这一步和普通商量"
  },
  {
    "start": 266.36,
    "end": 268.16,
    "text": "TopK有什么本质区别"
  },
  {
    "start": 268.16,
    "end": 271.32,
    "text": "普通TopK只看谁和问题最像"
  },
  {
    "start": 271.32,
    "end": 274.88,
    "text": "Memgas先用加全相似度选种子节点"
  },
  {
    "start": 275.2,
    "end": 277.12,
    "text": "再用Personalized Page Rank"
  },
  {
    "start": 277.4,
    "end": 279.44,
    "text": "在关联图上传播相关性"
  },
  {
    "start": 279.8,
    "end": 281.72,
    "text": "这样一个关键词被命中后"
  },
  {
    "start": 281.72,
    "end": 283.68,
    "text": "和它稳定相连的Session"
  },
  {
    "start": 283.68,
    "end": 284.68,
    "text": "TurnSummary"
  },
  {
    "start": 284.68,
    "end": 286.16,
    "text": "都有机会被带出来"
  },
  {
    "start": 286.48,
    "end": 287.84,
    "text": "更像联想式回忆"
  },
  {
    "start": 287.84,
    "end": 290.08,
    "text": "有没有一个具体例子能穿起来"
  },
  {
    "start": 290.08,
    "end": 291.16,
    "text": "论文里的例子"
  },
  {
    "start": 291.16,
    "end": 293.64,
    "text": "是用户分别在两次汇化里说"
  },
  {
    "start": 293.64,
    "end": 295.8,
    "text": "完成了Summary Curser课程"
  },
  {
    "start": 295.8,
    "end": 297.8,
    "text": "和两门IDX课程"
  },
  {
    "start": 297.8,
    "end": 299.32,
    "text": "问题问总数时"
  },
  {
    "start": 299.52,
    "end": 302.16,
    "text": "只减锁到第一段汇化会达Summary"
  },
  {
    "start": 302.16,
    "end": 303.96,
    "text": "完整减锁才是五门"
  },
  {
    "start": 303.96,
    "end": 305.84,
    "text": "Memgas的多例度关联"
  },
  {
    "start": 305.84,
    "end": 308.08,
    "text": "能通过共同主题和关键词"
  },
  {
    "start": 308.08,
    "end": 309.8,
    "text": "把两段汇化一起找回来"
  },
  {
    "start": 309.8,
    "end": 313.0,
    "text": "图传播会不会也把不散关内容一起带出来"
  },
  {
    "start": 313.0,
    "end": 314.32,
    "text": "会有这个风险"
  },
  {
    "start": 314.52,
    "end": 317.0,
    "text": "所以它最后还有LLM过濾"
  },
  {
    "start": 317.48,
    "end": 320.48,
    "text": "系统把TopK后选记忆和查询"
  },
  {
    "start": 320.48,
    "end": 322.2,
    "text": "一起交给LLMN"
  },
  {
    "start": 322.2,
    "end": 323.68,
    "text": "让它去掉重复"
  },
  {
    "start": 323.68,
    "end": 325.52,
    "text": "无关或造生内容"
  },
  {
    "start": 325.52,
    "end": 328.52,
    "text": "只把最关键上下门交给回答模型"
  },
  {
    "start": 328.52,
    "end": 329.4,
    "text": "也就是说"
  },
  {
    "start": 329.4,
    "end": 331.72,
    "text": "图负责扩展照回过濾"
  },
  {
    "start": 331.72,
    "end": 333.12,
    "text": "负责收窄上下门"
  },
  {
    "start": 333.12,
    "end": 334.84,
    "text": "实验覆盖勾广吗"
  },
  {
    "start": 334.84,
    "end": 337.64,
    "text": "论文用了四个长期记忆基准"
  },
  {
    "start": 337.64,
    "end": 338.48,
    "text": "Locombo"
  },
  {
    "start": 338.48,
    "end": 339.88,
    "text": "LongMemEveils"
  },
  {
    "start": 339.88,
    "end": 341.24,
    "text": "LongMemEveils"
  },
  {
    "start": 341.24,
    "end": 343.8,
    "text": "M和LongMTBench Plus"
  },
  {
    "start": 344.16,
    "end": 347.4,
    "text": "问答评估看GPT4O as Judge"
  },
  {
    "start": 347.4,
    "end": 349.0,
    "text": "FEArroach"
  },
  {
    "start": 349.0,
    "end": 350.28,
    "text": "BairdScore懂"
  },
  {
    "start": 350.28,
    "end": 353.68,
    "text": "检索评估看Recal和NDCG"
  },
  {
    "start": 353.68,
    "end": 355.48,
    "text": "机线包括FullHistory"
  },
  {
    "start": 355.48,
    "end": 356.24,
    "text": "Contriver"
  },
  {
    "start": 356.24,
    "end": 356.96,
    "text": "Cicom"
  },
  {
    "start": 356.96,
    "end": 357.96,
    "text": "HipoRAG"
  },
  {
    "start": 357.96,
    "end": 358.28,
    "text": "R"
  },
  {
    "start": 358.28,
    "end": 358.92,
    "text": "Raptor"
  },
  {
    "start": 358.92,
    "end": 359.68,
    "text": "Amem懂"
  },
  {
    "start": 359.68,
    "end": 361.16,
    "text": "给几个代表数字"
  },
  {
    "start": 361.16,
    "end": 362.48,
    "text": "不要念完整表"
  },
  {
    "start": 362.48,
    "end": 364.12,
    "text": "在LongMemEveils"
  },
  {
    "start": 364.12,
    "end": 365.44,
    "text": "S问答上"
  },
  {
    "start": 365.44,
    "end": 368.68,
    "text": "MemGuess的FE是20.38"
  },
  {
    "start": 368.68,
    "end": 370.96,
    "text": "Contriver是13.78"
  },
  {
    "start": 370.96,
    "end": 372.2,
    "text": "HipoRAG"
  },
  {
    "start": 372.2,
    "end": 373.76,
    "text": "R是14.73"
  },
  {
    "start": 374.04,
    "end": 375.92,
    "text": "在同一数据级检索上"
  },
  {
    "start": 375.92,
    "end": 379.6,
    "text": "MemGuess的Recal S3是78.51"
  },
  {
    "start": 379.6,
    "end": 381.8,
    "text": "高于Contriver的71.06"
  },
  {
    "start": 381.8,
    "end": 384.12,
    "text": "和HipoRAG2的75.53"
  },
  {
    "start": 384.12,
    "end": 386.08,
    "text": "其他数据级上也是这个趋势吗"
  },
  {
    "start": 386.08,
    "end": 388.76,
    "text": "整体式的LongMemEveM上"
  },
  {
    "start": 388.76,
    "end": 392.2,
    "text": "MemGuess的FE是16.85"
  },
  {
    "start": 392.2,
    "end": 394.92,
    "text": "高于Contriver的11.88"
  },
  {
    "start": 394.92,
    "end": 397.32,
    "text": "LongMTBench Plus上"
  },
  {
    "start": 397.32,
    "end": 400.4,
    "text": "MemGuess的FE是41.49"
  },
  {
    "start": 400.4,
    "end": 403.4,
    "text": "高于FullHistory的36.07"
  },
  {
    "start": 403.68,
    "end": 405.2,
    "text": "Locomot检索上"
  },
  {
    "start": 405.2,
    "end": 409.08,
    "text": "MemGuess的Recal S10达到81.82"
  },
  {
    "start": 409.08,
    "end": 411.8,
    "text": "也高于Contriver和HipoRAG2"
  },
  {
    "start": 411.8,
    "end": 413.72,
    "text": "怎么知道不是某一个模块"
  },
  {
    "start": 413.72,
    "end": 414.64,
    "text": "偶然带来的"
  },
  {
    "start": 414.64,
    "end": 416.72,
    "text": "销融实验比较直接"
  },
  {
    "start": 416.72,
    "end": 418.88,
    "text": "在LongMemEveils上"
  },
  {
    "start": 418.88,
    "end": 423.24,
    "text": "完整MemGuess的FE是20.38"
  },
  {
    "start": 423.24,
    "end": 425.12,
    "text": "去掉全部核心组件后"
  },
  {
    "start": 425.12,
    "end": 426.92,
    "text": "降到13.78"
  },
  {
    "start": 426.92,
    "end": 430.04,
    "text": "Recal S3也从78.51"
  },
  {
    "start": 430.04,
    "end": 432.08,
    "text": "降到71.06"
  },
  {
    "start": 432.08,
    "end": 434.56,
    "text": "单独去掉GMMPP2"
  },
  {
    "start": 434.56,
    "end": 436.52,
    "text": "记忆关联或路游汽"
  },
  {
    "start": 436.52,
    "end": 437.88,
    "text": "表现都会下降"
  },
  {
    "start": 437.88,
    "end": 439.88,
    "text": "波剑几层记忆和图"
  },
  {
    "start": 439.88,
    "end": 440.92,
    "text": "会不会太重"
  },
  {
    "start": 440.92,
    "end": 443.44,
    "text": "论文的结论是成本可控"
  },
  {
    "start": 443.44,
    "end": 445.4,
    "text": "LongMemEveils上"
  },
  {
    "start": 445.4,
    "end": 447.64,
    "text": "MemGuess购件记忆处理"
  },
  {
    "start": 447.64,
    "end": 450.48,
    "text": "约52.9MInputTocons"
  },
  {
    "start": 450.48,
    "end": 452.36,
    "text": "接近原始余料规模"
  },
  {
    "start": 452.36,
    "end": 454.84,
    "text": "Summery和Kewer的带来的额外"
  },
  {
    "start": 454.84,
    "end": 456.72,
    "text": "Rum約27MB"
  },
  {
    "start": 456.72,
    "end": 459.32,
    "text": "大约是原始记忆的10%"
  },
  {
    "start": 459.32,
    "end": 460.8,
    "text": "销容里核心模块"
  },
  {
    "start": 460.8,
    "end": 462.76,
    "text": "已入的减锁延迟也很小"
  },
  {
    "start": 462.76,
    "end": 464.04,
    "text": "它和知识图谱"
  },
  {
    "start": 464.04,
    "end": 466.52,
    "text": "Rag或技能图有什么不同"
  },
  {
    "start": 466.52,
    "end": 467.52,
    "text": "知识图谱"
  },
  {
    "start": 467.52,
    "end": 470.08,
    "text": "Rag常围绕实体关系"
  },
  {
    "start": 470.08,
    "end": 472.48,
    "text": "技能图常围绕执行依赖"
  },
  {
    "start": 472.48,
    "end": 475.2,
    "text": "MemGuess的图是记忆关联图"
  },
  {
    "start": 475.2,
    "end": 477.8,
    "text": "节点背后有不同力度的对话记忆"
  },
  {
    "start": 477.8,
    "end": 479.36,
    "text": "它不负责规划动作"
  },
  {
    "start": 479.36,
    "end": 481.2,
    "text": "而是负责在长期对话历史里"
  },
  {
    "start": 481.2,
    "end": 482.24,
    "text": "找到既有细节"
  },
  {
    "start": 482.24,
    "end": 483.52,
    "text": "又有上下轮的证据"
  },
  {
    "start": 483.52,
    "end": 485.48,
    "text": "这套方法在真实产品里"
  },
  {
    "start": 485.48,
    "end": 486.68,
    "text": "最容易卡在哪里"
  },
  {
    "start": 486.68,
    "end": 487.36,
    "text": "第一"
  },
  {
    "start": 487.44,
    "end": 490.32,
    "text": "摘药和关键词由LLM生成"
  },
  {
    "start": 490.32,
    "end": 491.24,
    "text": "情绪化"
  },
  {
    "start": 491.24,
    "end": 493.8,
    "text": "也含意图或非试试碎片"
  },
  {
    "start": 493.8,
    "end": 495.32,
    "text": "可能提取不稳"
  },
  {
    "start": 495.32,
    "end": 496.24,
    "text": "第二"
  },
  {
    "start": 496.24,
    "end": 497.28,
    "text": "相似度高"
  },
  {
    "start": 497.28,
    "end": 499.28,
    "text": "不等于与以上应该关联"
  },
  {
    "start": 499.28,
    "end": 501.72,
    "text": "图可能产生错误连响"
  },
  {
    "start": 501.72,
    "end": 502.24,
    "text": "第三"
  },
  {
    "start": 502.24,
    "end": 503.76,
    "text": "记忆持续增长后"
  },
  {
    "start": 503.76,
    "end": 505.8,
    "text": "还需要隐私全现一望"
  },
  {
    "start": 505.8,
    "end": 508.24,
    "text": "冲突更新和实施成本控制"
  },
  {
    "start": 508.24,
    "end": 510.08,
    "text": "如果用一句话总结"
  },
  {
    "start": 510.08,
    "end": 511.44,
    "text": "它真正推进了什么"
  },
  {
    "start": 511.44,
    "end": 512.48,
    "text": "MemGuess"
  },
  {
    "start": 512.48,
    "end": 515.04,
    "text": "推进的是长期记忆系统的结构化"
  },
  {
    "start": 515.04,
    "end": 516.28,
    "text": "不要把对话历史"
  },
  {
    "start": 516.28,
    "end": 518.44,
    "text": "当上一堆等待减锁的文文快"
  },
  {
    "start": 518.44,
    "end": 520.32,
    "text": "而要把它拆成不同力度"
  },
  {
    "start": 520.32,
    "end": 521.72,
    "text": "建立可信关联"
  },
  {
    "start": 521.72,
    "end": 523.76,
    "text": "在案问题选择和传播"
  },
  {
    "start": 523.76,
    "end": 525.48,
    "text": "对对话A证子来说"
  },
  {
    "start": 525.48,
    "end": 526.92,
    "text": "会记住还不够"
  },
  {
    "start": 526.92,
    "end": 529.16,
    "text": "关键是会在正确力度上想起来"
  }
]