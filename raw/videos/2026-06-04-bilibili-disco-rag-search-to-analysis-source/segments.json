[
  {
    "start": 0.21,
    "end": 1.29,
    "text": "哈喽大家好"
  },
  {
    "start": 1.29,
    "end": 3.49,
    "text": "今天咱们来聊一个挺有意思的技术"
  },
  {
    "start": 3.49,
    "end": 5.37,
    "text": "叫Disco ARG"
  },
  {
    "start": 5.37,
    "end": 8.85,
    "text": "专门解决咱们做ARG的时候那种搜到的东西"
  },
  {
    "start": 8.85,
    "end": 12.05,
    "text": "结果模型回答还是驴唇不对马嘴的难题"
  },
  {
    "start": 12.05,
    "end": 14.33,
    "text": "对 我之前就遇到过这种情况"
  },
  {
    "start": 14.33,
    "end": 16.41,
    "text": "明明检索结果里有正确的文档"
  },
  {
    "start": 16.41,
    "end": 18.33,
    "text": "但是生成的答案还是错的离谱"
  },
  {
    "start": 18.33,
    "end": 20.45,
    "text": "我一直以为是检索环节出了问题"
  },
  {
    "start": 20.45,
    "end": 21.77,
    "text": "难道不是吗"
  },
  {
    "start": 21.77,
    "end": 24.65,
    "text": "诶 这就是传统RAG的第一个误区"
  },
  {
    "start": 24.65,
    "end": 27.93,
    "text": "很多时候问题根本不在搜 而在读"
  },
  {
    "start": 27.93,
    "end": 29.57,
    "text": "咱们之前的RAG系统"
  },
  {
    "start": 29.69,
    "end": 32.69,
    "text": "就像把一堆散装零件直接扔给模型"
  },
  {
    "start": 32.69,
    "end": 36.05,
    "text": "段落里哪句是核心结论 哪句是前提条件"
  },
  {
    "start": 36.05,
    "end": 38.57,
    "text": "段落之间是互相支持还是互相打脸"
  },
  {
    "start": 38.57,
    "end": 40.77,
    "text": "这些信息全被抹平了"
  },
  {
    "start": 40.77,
    "end": 42.45,
    "text": "这么一说我好像有点明白了"
  },
  {
    "start": 42.45,
    "end": 45.21,
    "text": "就比如你给模型两篇关于维生素D的文献"
  },
  {
    "start": 45.21,
    "end": 46.93,
    "text": "一篇说冬季补充维生素D"
  },
  {
    "start": 46.93,
    "end": 49.25,
    "text": "能让流感发明率降12%"
  },
  {
    "start": 49.25,
    "end": 51.61,
    "text": "另一篇说大规模试验没发现关联"
  },
  {
    "start": 51.61,
    "end": 53.85,
    "text": "模型可能直接就输出维生素D有效了"
  },
  {
    "start": 53.85,
    "end": 55.81,
    "text": "根本没注意到第一篇的限定条件"
  },
  {
    "start": 55.81,
    "end": 58.45,
    "text": "也没发现两天文献其实是冲突的"
  },
  {
    "start": 59.01,
    "end": 60.25,
    "text": "你这个例子觉得特别准"
  },
  {
    "start": 60.25,
    "end": 63.01,
    "text": "这就是传统RAG的两个致命盲区"
  },
  {
    "start": 63.01,
    "end": 65.45,
    "text": "第一个是段落内部看不到主次"
  },
  {
    "start": 65.45,
    "end": 67.13,
    "text": "模型分不清哪句是重点"
  },
  {
    "start": 67.13,
    "end": 68.69,
    "text": "哪句是补充说明"
  },
  {
    "start": 68.69,
    "end": 70.93,
    "text": "第二个是段落之间看不到关联"
  },
  {
    "start": 70.93,
    "end": 74.13,
    "text": "不知道两段文献是互相支持还是互相反驳"
  },
  {
    "start": 74.13,
    "end": 76.61,
    "text": "那之前咱们不也试过很多优化方法吗"
  },
  {
    "start": 76.61,
    "end": 78.65,
    "text": "比如重新排序检索结果"
  },
  {
    "start": 78.65,
    "end": 80.05,
    "text": "改写用户查询"
  },
  {
    "start": 80.05,
    "end": 81.41,
    "text": "压缩容易断落"
  },
  {
    "start": 81.41,
    "end": 82.97,
    "text": "多轮迭代检索"
  },
  {
    "start": 82.97,
    "end": 84.77,
    "text": "这些方法没用吗"
  },
  {
    "start": 84.77,
    "end": 86.17,
    "text": "这些方法确实有用"
  },
  {
    "start": 86.25,
    "end": 88.81,
    "text": "但他们优化的始终是搜这个环境"
  },
  {
    "start": 88.81,
    "end": 92.33,
    "text": "大家默认只要把更好的内容送到模型面前"
  },
  {
    "start": 92.33,
    "end": 94.57,
    "text": "模型自然就能给出好的案"
  },
  {
    "start": 94.57,
    "end": 96.73,
    "text": "但很多时候内容已经够好了"
  },
  {
    "start": 96.73,
    "end": 98.81,
    "text": "问题出在模型拿到这些内容之后"
  },
  {
    "start": 98.81,
    "end": 100.37,
    "text": "不知道怎么组织"
  },
  {
    "start": 100.37,
    "end": 102.29,
    "text": "就像给了厨师一堆好食材"
  },
  {
    "start": 102.29,
    "end": 103.97,
    "text": "但是厨师不会摆盘"
  },
  {
    "start": 103.97,
    "end": 106.37,
    "text": "最后做出来的菜还是不好看"
  },
  {
    "start": 106.37,
    "end": 108.89,
    "text": "那Disco RAG是怎么解决这个问题的呢"
  },
  {
    "start": 108.89,
    "end": 110.85,
    "text": "它的核心思路是什么"
  },
  {
    "start": 110.85,
    "end": 114.57,
    "text": "Scoff ARG的核心思路就是从搜转向读"
  },
  {
    "start": 114.57,
    "end": 117.09,
    "text": "不再只关注怎么把好的内容找出来"
  },
  {
    "start": 117.09,
    "end": 120.13,
    "text": "而是关注怎么让模型真正读懂这些内容"
  },
  {
    "start": 120.13,
    "end": 121.97,
    "text": "它的解决方案分成了三步"
  },
  {
    "start": 121.97,
    "end": 125.97,
    "text": "每一步都在帮模型构建对文本的结构化理解"
  },
  {
    "start": 125.97,
    "end": 128.61,
    "text": "能具体说说这三步都是什么吗"
  },
  {
    "start": 128.61,
    "end": 131.33,
    "text": "第一步是给每个断落画一棵论证树"
  },
  {
    "start": 131.33,
    "end": 135.13,
    "text": "利用ALM将断落拆解为最小语异单元"
  },
  {
    "start": 135.13,
    "end": 138.49,
    "text": "标记每个单元是核心内容还是辅助说明"
  },
  {
    "start": 138.49,
    "end": 140.33,
    "text": "识别单元之间的关系类型"
  },
  {
    "start": 140.33,
    "end": 142.97,
    "text": "比如英国 对比 展开等等"
  },
  {
    "start": 143.01,
    "end": 144.77,
    "text": "这样模型就能清楚的知道断落"
  },
  {
    "start": 144.77,
    "end": 147.49,
    "text": "里每个部分的作用和逻辑关系了"
  },
  {
    "start": 147.49,
    "end": 150.53,
    "text": "哦 相当于把断落拆成了一个个小模块"
  },
  {
    "start": 150.53,
    "end": 153.01,
    "text": "然后告诉模型这些模块之间是怎么联系的"
  },
  {
    "start": 153.01,
    "end": 154.73,
    "text": "对吧 那第二步呢"
  },
  {
    "start": 154.73,
    "end": 157.93,
    "text": "第二步是给所有断落之一张关系网"
  },
  {
    "start": 157.93,
    "end": 161.17,
    "text": "对检索回来的全部断落做两两配对分析"
  },
  {
    "start": 161.17,
    "end": 165.45,
    "text": "预测他们之间是支持反驳补充还是无关"
  },
  {
    "start": 165.45,
    "end": 167.01,
    "text": "最终形成一张有像图"
  },
  {
    "start": 167.01,
    "end": 169.89,
    "text": "这样模型就能知道不同断落之间的逻辑关系"
  },
  {
    "start": 169.89,
    "end": 172.93,
    "text": "不会再把互相矛盾的内容混在一起用了"
  },
  {
    "start": 172.97,
    "end": 174.37,
    "text": "这个思路挺有意思的"
  },
  {
    "start": 174.37,
    "end": 177.41,
    "text": "相当于让模型先搞清楚所有资料之间的关系"
  },
  {
    "start": 177.41,
    "end": 178.49,
    "text": "再开始写答案"
  },
  {
    "start": 178.49,
    "end": 180.05,
    "text": "那第三步呢"
  },
  {
    "start": 180.05,
    "end": 182.77,
    "text": "第三步是先列提纲 再写答案"
  },
  {
    "start": 182.77,
    "end": 186.33,
    "text": "综合用户提问 原始断落 论证数和关系网"
  },
  {
    "start": 186.33,
    "end": 188.05,
    "text": "自动生成写作提纲"
  },
  {
    "start": 188.05,
    "end": 190.93,
    "text": "然后以提纲为指导 产出最终回答"
  },
  {
    "start": 190.93,
    "end": 193.53,
    "text": "这样模型就不会动一句稀句的乱说"
  },
  {
    "start": 193.53,
    "end": 196.77,
    "text": "而是按照清晰的逻辑结构来组织答案"
  },
  {
    "start": 196.77,
    "end": 198.93,
    "text": "听起来这三步环环相扣"
  },
  {
    "start": 198.93,
    "end": 202.25,
    "text": "从单断落的结构分析到多断落的关系书里"
  },
  {
    "start": 202.29,
    "end": 203.93,
    "text": "再到最终的答案生成"
  },
  {
    "start": 203.93,
    "end": 207.29,
    "text": "每一步都在帮模型更好的理解和组织信息"
  },
  {
    "start": 207.29,
    "end": 208.45,
    "text": "那实验结构怎么样呢"
  },
  {
    "start": 209.57,
    "end": 210.73,
    "text": "实验结构非常亮眼"
  },
  {
    "start": 210.73,
    "end": 214.17,
    "text": "在三个权威极准上都取得了不错的成绩"
  },
  {
    "start": 214.17,
    "end": 215.97,
    "text": "第一个是长文档推理"
  },
  {
    "start": 215.97,
    "end": 218.85,
    "text": "文档越长 Disco ARG 的优势越大"
  },
  {
    "start": 218.85,
    "end": 220.57,
    "text": "在25万Tokies 党位"
  },
  {
    "start": 220.57,
    "end": 222.49,
    "text": "普通 ARG 几乎完全失效"
  },
  {
    "start": 222.49,
    "end": 225.33,
    "text": "而 Disco ARG 依然能给出有效回答"
  },
  {
    "start": 225.33,
    "end": 226.89,
    "text": "第二个是奇异问答"
  },
  {
    "start": 226.89,
    "end": 229.65,
    "text": "在核心指标上均刷新了最佳记录"
  },
  {
    "start": 229.65,
    "end": 231.29,
    "text": "第三个是科学摘要"
  },
  {
    "start": 231.33,
    "end": 233.85,
    "text": "四项评测指标中拿下三项第一"
  },
  {
    "start": 233.85,
    "end": 235.49,
    "text": "事实一致性排名第二"
  },
  {
    "start": 236.25,
    "end": 238.77,
    "text": "这个长文档推理的结构挺让人惊喜的"
  },
  {
    "start": 238.77,
    "end": 242.21,
    "text": "毕竟传统 ARG 在处理长文档的时候确实容易出问题"
  },
  {
    "start": 242.21,
    "end": 243.69,
    "text": "那有没有验证实验"
  },
  {
    "start": 243.69,
    "end": 246.69,
    "text": "证明这三个模块都是必要的呢"
  },
  {
    "start": 246.69,
    "end": 250.01,
    "text": "当然有 团队做了三个模块的 Ablation 实验"
  },
  {
    "start": 250.01,
    "end": 253.45,
    "text": "分别去掉论证书 关系网 提纲步骤后"
  },
  {
    "start": 253.45,
    "end": 255.41,
    "text": "性能都会明显下滑"
  },
  {
    "start": 255.41,
    "end": 256.69,
    "text": "而且他们还发现"
  },
  {
    "start": 256.69,
    "end": 259.85,
    "text": "光加规划没用 必须加结构"
  },
  {
    "start": 259.85,
    "end": 263.77,
    "text": "给普通 ARG 加通用规划步骤提升很有限"
  },
  {
    "start": 263.77,
    "end": 267.69,
    "text": "另外 Disco ARG 面对噪声和力度变化时"
  },
  {
    "start": 267.69,
    "end": 269.89,
    "text": "依然表现得很稳健"
  },
  {
    "start": 269.89,
    "end": 271.57,
    "text": "那实际部署起来成本高吗"
  },
  {
    "start": 271.57,
    "end": 273.17,
    "text": "毕竟要做这么多结构分析"
  },
  {
    "start": 273.17,
    "end": 275.05,
    "text": "会不会需要很大的算力"
  },
  {
    "start": 275.05,
    "end": 276.61,
    "text": "这点团队也考虑到了"
  },
  {
    "start": 276.61,
    "end": 278.93,
    "text": "他们提出了一个混合部署策略"
  },
  {
    "start": 278.93,
    "end": 282.17,
    "text": "用小模型做分析 大模型做生成"
  },
  {
    "start": 282.17,
    "end": 283.01,
    "text": "具体来说"
  },
  {
    "start": 283.01,
    "end": 286.97,
    "text": "就是用 Lama 3.18B 负责所有结构分析模块"
  },
  {
    "start": 286.97,
    "end": 290.89,
    "text": "只在最后的生成环节调用 Lama 3.370B"
  },
  {
    "start": 290.89,
    "end": 292.93,
    "text": "这样一来既能保证性能"
  },
  {
    "start": 292.93,
    "end": 294.93,
    "text": "又能降低算力成本"
  },
  {
    "start": 294.93,
    "end": 296.25,
    "text": "这个策略挺聪明的"
  },
  {
    "start": 296.25,
    "end": 298.25,
    "text": "结构分析不需要特别大的模型"
  },
  {
    "start": 298.25,
    "end": 299.61,
    "text": "用小模型就能搞定"
  },
  {
    "start": 299.61,
    "end": 301.77,
    "text": "大模型只负责最终的答案生成"
  },
  {
    "start": 301.77,
    "end": 304.01,
    "text": "那全部用小模型跑 Disco ARG"
  },
  {
    "start": 304.01,
    "end": 305.77,
    "text": "效果怎么样呢"
  },
  {
    "start": 305.77,
    "end": 308.69,
    "text": "全部用 8B 小模型跑 Disco ARG"
  },
  {
    "start": 308.69,
    "end": 311.85,
    "text": "效果也远超用 70B 跑普通 ARG"
  },
  {
    "start": 311.85,
    "end": 314.53,
    "text": "这说明结构分析带来的性能提升"
  },
  {
    "start": 314.53,
    "end": 317.49,
    "text": "比单纯增大模型参数更有效"
  },
  {
    "start": 317.49,
    "end": 319.45,
    "text": "而且不训练的 Disco ARG"
  },
  {
    "start": 319.45,
    "end": 322.65,
    "text": "已经超过了经过微调的普通 ARG"
  },
  {
    "start": 322.65,
    "end": 325.45,
    "text": "当微调与偏章结构结合使用时"
  },
  {
    "start": 325.45,
    "end": 327.41,
    "text": "效果还能进一步提升"
  },
  {
    "start": 327.41,
    "end": 331.29,
    "text": "结构信息和微调带来的收益是互补的"
  },
  {
    "start": 331.29,
    "end": 332.25,
    "text": "这一点很重要"
  },
  {
    "start": 332.25,
    "end": 335.37,
    "text": "毕竟不是每个团队都有能力做大规模的微调"
  },
  {
    "start": 335.37,
    "end": 338.37,
    "text": "那 Disco ARG 的深层意义是什么呢"
  },
  {
    "start": 338.37,
    "end": 340.69,
    "text": "我觉得 Disco ARG 的深层意义在于"
  },
  {
    "start": 340.69,
    "end": 342.29,
    "text": "它让我们重新认识到"
  },
  {
    "start": 342.29,
    "end": 346.05,
    "text": "自然语言文本不是一堆句子的简单堆器"
  },
  {
    "start": 346.05,
    "end": 347.97,
    "text": "它有自己的逻辑骨架"
  },
  {
    "start": 347.97,
    "end": 351.77,
    "text": "有主次 有因果 有转折 有呼应"
  },
  {
    "start": 351.77,
    "end": 354.25,
    "text": "传统 ARG 把这些骨架都扔掉了"
  },
  {
    "start": 354.25,
    "end": 356.01,
    "text": "只给模型为了一堆肉"
  },
  {
    "start": 356.01,
    "end": 358.77,
    "text": "而 Disco ARG 把这个骨架还给了模型"
  },
  {
    "start": 358.77,
    "end": 363.33,
    "text": "让模型对信息的理解和组织能力产生了质的变化"
  },
  {
    "start": 363.33,
    "end": 364.09,
    "text": "没错"
  },
  {
    "start": 364.09,
    "end": 366.29,
    "text": "这个思路不仅是用于 ARG 场景"
  },
  {
    "start": 366.29,
    "end": 368.65,
    "text": "也可能为更广泛的多文档推理"
  },
  {
    "start": 368.65,
    "end": 371.29,
    "text": "常文本理解等任务提供新的启发"
  },
  {
    "start": 371.29,
    "end": 373.93,
    "text": "那它的实际应用价值又是什么呢"
  },
  {
    "start": 373.93,
    "end": 375.53,
    "text": "实际应用价值也很大"
  },
  {
    "start": 375.53,
    "end": 377.73,
    "text": "为正在做 ARG 系统落地的团队"
  },
  {
    "start": 377.73,
    "end": 381.17,
    "text": "提供了一个轻量及差及用的增强方案"
  },
  {
    "start": 381.17,
    "end": 383.09,
    "text": "不需要训练 不需要改模型"
  },
  {
    "start": 383.09,
    "end": 385.61,
    "text": "就能让 ARG 的回答质量大幅提升"
  },
  {
    "start": 385.61,
    "end": 387.81,
    "text": "尤其在常文档和噪声场景下"
  },
  {
    "start": 387.81,
    "end": 389.33,
    "text": "效果尤为明显"
  },
  {
    "start": 389.33,
    "end": 391.29,
    "text": "很多团队在做 ARG 的时候"
  },
  {
    "start": 391.29,
    "end": 393.73,
    "text": "可能已经把检索环节优化到极致了"
  },
  {
    "start": 393.73,
    "end": 395.37,
    "text": "但回答质量还是上不去"
  },
  {
    "start": 395.37,
    "end": 397.61,
    "text": "这时候就可以试试 Disco ARG"
  },
  {
    "start": 397.61,
    "end": 400.37,
    "text": "从独的环节入手提升效果"
  },
  {
    "start": 400.37,
    "end": 402.85,
    "text": "确实 很多时候我们都把注意力放在了"
  },
  {
    "start": 402.85,
    "end": 406.25,
    "text": "怎么找上 而忽略了怎么读的问题"
  },
  {
    "start": 406.25,
    "end": 407.81,
    "text": "Disco ARG 提醒我们"
  },
  {
    "start": 407.81,
    "end": 409.61,
    "text": "模型拿到了正确的资料"
  },
  {
    "start": 409.61,
    "end": 413.17,
    "text": "不代表它能正确的理解和使用这些资料"
  },
  {
    "start": 413.17,
    "end": 416.53,
    "text": "对 这也是我觉得 Disco ARG 最有价值的地方"
  },
  {
    "start": 416.53,
    "end": 419.73,
    "text": "它从一个全新的角度解决了 ARG 的痛点"
  },
  {
    "start": 419.73,
    "end": 422.09,
    "text": "之前的优化都是在量上做文章"
  },
  {
    "start": 422.09,
    "end": 425.13,
    "text": "比如找更多的资料 找更相关的资料"
  },
  {
    "start": 425.13,
    "end": 427.29,
    "text": "而 Disco ARG 是在质上做文章"
  },
  {
    "start": 427.29,
    "end": 429.89,
    "text": "让模型真正读懂这些资料"
  },
  {
    "start": 429.89,
    "end": 433.13,
    "text": "那你觉得 Disco ARG 未来的发展方向会是什么呢"
  },
  {
    "start": 433.13,
    "end": 435.05,
    "text": "我觉得未来可能会有更多的研究"
  },
  {
    "start": 435.05,
    "end": 437.09,
    "text": "关注文本的结构化理解"
  },
  {
    "start": 437.09,
    "end": 438.93,
    "text": "不仅仅是在 ARG 场景"
  },
  {
    "start": 438.93,
    "end": 441.09,
    "text": "在其他自然语言处理任务中"
  },
  {
    "start": 441.09,
    "end": 444.33,
    "text": "比如文本摘要 机器翻译 问答系统等"
  },
  {
    "start": 444.33,
    "end": 446.97,
    "text": "结构化信息都可能发挥重要作用"
  },
  {
    "start": 446.97,
    "end": 449.13,
    "text": "而且随着大模型的不断发展"
  },
  {
    "start": 449.13,
    "end": 452.65,
    "text": "模型对结构化信息的理解能力也会越来越强"
  },
  {
    "start": 452.65,
    "end": 456.33,
    "text": "Disco ARG 的思路可能会被更广泛的应用"
  },
  {
    "start": 456.33,
    "end": 459.41,
    "text": "没错 我也觉得结构化信息是未来自然语言处理的"
  },
  {
    "start": 459.41,
    "end": 460.61,
    "text": "一个重要方向"
  },
  {
    "start": 460.61,
    "end": 463.13,
    "text": "今天咱们聊了这么多关于 Disco ARG 的内容"
  },
  {
    "start": 463.13,
    "end": 465.89,
    "text": "从它解决的问题 到它的技术方案"
  },
  {
    "start": 465.89,
    "end": 467.93,
    "text": "再到它的实验结果和应用价值"
  },
  {
    "start": 467.93,
    "end": 470.81,
    "text": "相信大家对这个技术有了更深入的了解"
  },
  {
    "start": 470.81,
    "end": 474.65,
    "text": "希望今天的内容能给正在做 ARG 系统的朋友们一些启发"
  },
  {
    "start": 474.65,
    "end": 477.97,
    "text": "如果你的 ARG 系统也收到了读不懂的问题"
  },
  {
    "start": 477.97,
    "end": 480.05,
    "text": "不妨试试 Disco ARG 的思路"
  },
  {
    "start": 480.05,
    "end": 483.17,
    "text": "从结构化理解入手 提升回答质量"
  },
  {
    "start": 483.17,
    "end": 485.01,
    "text": "好了 今天的播客就到这里"
  },
  {
    "start": 485.01,
    "end": 487.25,
    "text": "感谢大家的收听 咱们下次再见"
  }
]