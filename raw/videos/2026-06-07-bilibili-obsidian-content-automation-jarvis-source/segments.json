[
  {
    "start": 0.0,
    "end": 2.96,
    "text": "我知道你已經用上了Obsidian配好了Cloud Code"
  },
  {
    "start": 2.96,
    "end": 5.84,
    "text": "但卡帕西只教你怎麼抓取網頁建立Wiki"
  },
  {
    "start": 5.84,
    "end": 8.2,
    "text": "真正有價值的是你能夠篩選理解"
  },
  {
    "start": 8.2,
    "end": 9.8,
    "text": "調用轉化多少信息"
  },
  {
    "start": 9.8,
    "end": 10.56,
    "text": "換句話說"
  },
  {
    "start": 10.56,
    "end": 12.92,
    "text": "是你的AI能在多大程度上理解你"
  },
  {
    "start": 12.92,
    "end": 13.64,
    "text": "超越你"
  },
  {
    "start": 13.64,
    "end": 15.84,
    "text": "網上的教程都是教你怎麼玩插件"
  },
  {
    "start": 15.84,
    "end": 17.2,
    "text": "把Obsidian變好看"
  },
  {
    "start": 17.2,
    "end": 18.88,
    "text": "而不是變成一套徹底懂你"
  },
  {
    "start": 18.88,
    "end": 20.72,
    "text": "並且持續進化的假類似"
  },
  {
    "start": 20.72,
    "end": 21.8,
    "text": "在過去的一個月"
  },
  {
    "start": 21.8,
    "end": 23.6,
    "text": "我用Cloud Code在Obsidian裡"
  },
  {
    "start": 23.6,
    "end": 25.48,
    "text": "連續創作了200多張漫畫"
  },
  {
    "start": 25.48,
    "end": 28.36,
    "text": "不僅完美解決了AI生徒一致性的問題"
  },
  {
    "start": 28.4,
    "end": 30.28,
    "text": "並且搭建了一套內容創作"
  },
  {
    "start": 30.28,
    "end": 32.96,
    "text": "從排版到發布的全自動化工作流"
  },
  {
    "start": 32.96,
    "end": 35.2,
    "text": "故事的開始就只是一份PDF"
  },
  {
    "start": 35.2,
    "end": 35.76,
    "text": "現在"
  },
  {
    "start": 35.76,
    "end": 37.68,
    "text": "不管我對任意的AI直接說"
  },
  {
    "start": 37.68,
    "end": 38.68,
    "text": "開始創作"
  },
  {
    "start": 38.68,
    "end": 40.88,
    "text": "它就能完全蓋得到我之前的工作"
  },
  {
    "start": 40.88,
    "end": 43.24,
    "text": "並且創作出我需要風格的畫面"
  },
  {
    "start": 43.24,
    "end": 44.2,
    "text": "所以本期視頻"
  },
  {
    "start": 44.2,
    "end": 46.8,
    "text": "我將通過開源我AI創作的全流程"
  },
  {
    "start": 46.8,
    "end": 48.76,
    "text": "徹底教會你怎麼訓練AI"
  },
  {
    "start": 48.76,
    "end": 50.2,
    "text": "不管你是自媒體博主"
  },
  {
    "start": 50.2,
    "end": 51.8,
    "text": "做品牌營銷的市場人"
  },
  {
    "start": 51.8,
    "end": 53.24,
    "text": "或者寫論文內研究生"
  },
  {
    "start": 53.24,
    "end": 56.32,
    "text": "如果你的工作需要重複的收集理解信息"
  },
  {
    "start": 56.32,
    "end": 57.36,
    "text": "加產出內容"
  },
  {
    "start": 57.36,
    "end": 59.52,
    "text": "卻依然每天對著空白文檔發呆"
  },
  {
    "start": 59.52,
    "end": 60.88,
    "text": "寫作排版配圖"
  },
  {
    "start": 60.88,
    "end": 62.28,
    "text": "每次都要從零開始"
  },
  {
    "start": 62.28,
    "end": 63.28,
    "text": "那麼我今天的內容"
  },
  {
    "start": 63.28,
    "end": 65.0,
    "text": "一定會給你非常大的啟發"
  },
  {
    "start": 65.0,
    "end": 65.8,
    "text": "最重要的是"
  },
  {
    "start": 65.8,
    "end": 67.96,
    "text": "這套系統還會跟著你一起進化"
  },
  {
    "start": 67.96,
    "end": 68.88,
    "text": "視頻配到文檔"
  },
  {
    "start": 68.88,
    "end": 70.84,
    "text": "就是用這套流程製作發布的"
  },
  {
    "start": 70.84,
    "end": 71.56,
    "text": "相信我"
  },
  {
    "start": 71.56,
    "end": 73.28,
    "text": "這個視頻你已經找很久了"
  },
  {
    "start": 73.28,
    "end": 74.4,
    "text": "點好收藏 關注讚"
  },
  {
    "start": 74.4,
    "end": 75.44,
    "text": "咱們開始上課"
  },
  {
    "start": 75.44,
    "end": 77.6,
    "text": "首先Gatehub搜索保育Skill"
  },
  {
    "start": 77.6,
    "end": 79.32,
    "text": "直接無腦下載這個倉庫"
  },
  {
    "start": 79.32,
    "end": 81.6,
    "text": "裡面包含20多種視覺風格"
  },
  {
    "start": 81.6,
    "end": 82.68,
    "text": "涵蓋了信息圖"
  },
  {
    "start": 82.68,
    "end": 84.56,
    "text": "PPT以及漫畫製作"
  },
  {
    "start": 84.56,
    "end": 85.52,
    "text": "可以一鍵保存"
  },
  {
    "start": 85.52,
    "end": 86.4,
    "text": "網頁推特"
  },
  {
    "start": 86.4,
    "end": 87.96,
    "text": "給你的文章自動配圖"
  },
  {
    "start": 87.96,
    "end": 89.04,
    "text": "今天我們的視頻中"
  },
  {
    "start": 89.04,
    "end": 90.08,
    "text": "也會多次使用"
  },
  {
    "start": 90.08,
    "end": 92.08,
    "text": "當然下載工具只是第一步"
  },
  {
    "start": 92.08,
    "end": 93.52,
    "text": "如果只是建立個人Wiki"
  },
  {
    "start": 93.52,
    "end": 94.96,
    "text": "卡帕西的方式很優雅"
  },
  {
    "start": 94.96,
    "end": 96.56,
    "text": "我在Obsidian畫漫畫的方式"
  },
  {
    "start": 96.56,
    "end": 98.04,
    "text": "其實和這套邏輯一模一樣"
  },
  {
    "start": 98.04,
    "end": 99.8,
    "text": "但我想教你的更瘋狂"
  },
  {
    "start": 99.8,
    "end": 101.0,
    "text": "看這個文件夾"
  },
  {
    "start": 101.0,
    "end": 102.8,
    "text": "現在AI已經可以自主調用"
  },
  {
    "start": 102.8,
    "end": 104.0,
    "text": "裡面所有的資源"
  },
  {
    "start": 104.0,
    "end": 105.6,
    "text": "但是最開始就只有一本"
  },
  {
    "start": 105.6,
    "end": 107.28,
    "text": "這樣的小禮飛刀援助"
  },
  {
    "start": 107.28,
    "end": 109.24,
    "text": "首先我讓它調用保育Skill"
  },
  {
    "start": 109.24,
    "end": 111.76,
    "text": "直接根據援助的第一回創作漫畫"
  },
  {
    "start": 111.76,
    "end": 113.28,
    "text": "我沒有給它任何的提示詞"
  },
  {
    "start": 113.28,
    "end": 115.24,
    "text": "它就憑感覺創作了15張"
  },
  {
    "start": 115.32,
    "end": 117.64,
    "text": "你看出看其實還是挺驚豔的"
  },
  {
    "start": 117.64,
    "end": 118.76,
    "text": "但是如果你仔細看"
  },
  {
    "start": 118.76,
    "end": 120.68,
    "text": "就會發現有非常多的bug"
  },
  {
    "start": 120.68,
    "end": 122.64,
    "text": "比如說這兩張圖出現的配角"
  },
  {
    "start": 122.64,
    "end": 123.8,
    "text": "完全就是兩個人"
  },
  {
    "start": 123.8,
    "end": 126.08,
    "text": "就連男主李循環和阿飛的形象"
  },
  {
    "start": 126.08,
    "end": 127.36,
    "text": "也都是變來變去的"
  },
  {
    "start": 127.36,
    "end": 128.92,
    "text": "並且你看整體的配色"
  },
  {
    "start": 128.92,
    "end": 129.84,
    "text": "飽和度很高"
  },
  {
    "start": 129.84,
    "end": 132.16,
    "text": "它就像是給小孩哥看的熱血動漫"
  },
  {
    "start": 132.16,
    "end": 134.16,
    "text": "肯定是達不到交付級的效果"
  },
  {
    "start": 134.16,
    "end": 136.28,
    "text": "所以接下來在正式創作的第一步"
  },
  {
    "start": 136.28,
    "end": 137.72,
    "text": "我要先鎖定人物"
  },
  {
    "start": 137.72,
    "end": 140.36,
    "text": "我讓它根據自己對古龍小說的理解"
  },
  {
    "start": 140.36,
    "end": 142.52,
    "text": "以及一些相關文學作品的描述"
  },
  {
    "start": 142.52,
    "end": 144.08,
    "text": "幫我創作主角的形象"
  },
  {
    "start": 144.08,
    "end": 147.2,
    "text": "我的要求是必須符合中國古典武俠的形象"
  },
  {
    "start": 147.2,
    "end": 149.36,
    "text": "並且需要使用國風水墨的比數"
  },
  {
    "start": 149.36,
    "end": 151.16,
    "text": "需要充滿古龍江湖的味道"
  },
  {
    "start": 151.16,
    "end": 152.76,
    "text": "而且尤其需要注意的是"
  },
  {
    "start": 152.76,
    "end": 154.48,
    "text": "李循環雖然經常咳嗽"
  },
  {
    "start": 154.48,
    "end": 156.28,
    "text": "但畢竟展示的是一代大俠"
  },
  {
    "start": 156.28,
    "end": 157.68,
    "text": "所以不能過分的病態"
  },
  {
    "start": 157.68,
    "end": 159.12,
    "text": "並且我同時上傳了電影"
  },
  {
    "start": 159.12,
    "end": 160.76,
    "text": "《多情情》的《無形劍》的截圖"
  },
  {
    "start": 160.76,
    "end": 162.2,
    "text": "也就是《狄龍》和《耳朵》聲"
  },
  {
    "start": 162.2,
    "end": 163.44,
    "text": "飾演的角色裝造"
  },
  {
    "start": 163.44,
    "end": 164.48,
    "text": "直接給大家看"
  },
  {
    "start": 164.48,
    "end": 165.96,
    "text": "人物形象我要求他們"
  },
  {
    "start": 165.96,
    "end": 168.24,
    "text": "單獨創建的人物形象的無念甲"
  },
  {
    "start": 168.24,
    "end": 169.8,
    "text": "我要求大家每次在創作前"
  },
  {
    "start": 169.8,
    "end": 171.4,
    "text": "必須都先來到這裡報導"
  },
  {
    "start": 171.4,
    "end": 173.84,
    "text": "尋找並且使用我指定的主角形象"
  },
  {
    "start": 173.84,
    "end": 176.12,
    "text": "然後你看這就是他為阿菲和李循環"
  },
  {
    "start": 176.12,
    "end": 177.28,
    "text": "創作的人物概述"
  },
  {
    "start": 177.28,
    "end": 179.04,
    "text": "包含了人物的主要配色"
  },
  {
    "start": 179.04,
    "end": 180.8,
    "text": "服飾武器性格等等"
  },
  {
    "start": 180.8,
    "end": 182.24,
    "text": "當然在實際的創作中"
  },
  {
    "start": 182.24,
    "end": 183.32,
    "text": "我改了好幾百次"
  },
  {
    "start": 183.32,
    "end": 186.0,
    "text": "才最終定下來這兩百的人物形象"
  },
  {
    "start": 186.0,
    "end": 187.32,
    "text": "然後是第二步"
  },
  {
    "start": 187.32,
    "end": 188.2,
    "text": "劇情分解"
  },
  {
    "start": 188.2,
    "end": 189.96,
    "text": "接著我讓AI根據原著"
  },
  {
    "start": 189.96,
    "end": 192.0,
    "text": "單獨提取某一章回的內容"
  },
  {
    "start": 192.0,
    "end": 194.04,
    "text": "順便創建劇情分解文件"
  },
  {
    "start": 194.04,
    "end": 195.64,
    "text": "必須要包含原著的頁馬"
  },
  {
    "start": 195.64,
    "end": 197.56,
    "text": "章節概述和出場的人物"
  },
  {
    "start": 197.56,
    "end": 199.04,
    "text": "方便我在創作的功能中"
  },
  {
    "start": 199.04,
    "end": 200.0,
    "text": "不斷的跳轉"
  },
  {
    "start": 200.0,
    "end": 200.76,
    "text": "其實查看"
  },
  {
    "start": 200.76,
    "end": 203.8,
    "text": "那下面就是根據劇情創作的"
  },
  {
    "start": 203.8,
    "end": 204.64,
    "text": "場景描述"
  },
  {
    "start": 204.64,
    "end": 205.92,
    "text": "包含地點人物"
  },
  {
    "start": 205.92,
    "end": 207.92,
    "text": "關鍵對話和分鏡建議"
  },
  {
    "start": 207.92,
    "end": 210.08,
    "text": "當然之前Makdown文件的內容形式"
  },
  {
    "start": 210.08,
    "end": 211.44,
    "text": "也都是我和AI反覆"
  },
  {
    "start": 211.44,
    "end": 213.6,
    "text": "典範別帶了很多板材定下來的"
  },
  {
    "start": 213.6,
    "end": 215.28,
    "text": "所以你看在整個文件牙裡面"
  },
  {
    "start": 215.28,
    "end": 216.72,
    "text": "還有一個Redmi的文件"
  },
  {
    "start": 216.72,
    "end": 218.36,
    "text": "以及人物追蹤所以"
  },
  {
    "start": 218.36,
    "end": 220.92,
    "text": "這相當於是整個文件牙的使用說明書"
  },
  {
    "start": 220.92,
    "end": 221.96,
    "text": "規定了接下來"
  },
  {
    "start": 221.96,
    "end": 223.2,
    "text": "比如我在創作第六回"
  },
  {
    "start": 223.2,
    "end": 225.4,
    "text": "甚至第九十回時的劇情分解文件"
  },
  {
    "start": 225.4,
    "end": 226.12,
    "text": "應該怎麼寫"
  },
  {
    "start": 226.12,
    "end": 227.24,
    "text": "必須要包含哪些結構"
  },
  {
    "start": 227.24,
    "end": 228.72,
    "text": "以及人物的存活狀態"
  },
  {
    "start": 228.72,
    "end": 230.68,
    "text": "以後我就不需要重複的跟AI說"
  },
  {
    "start": 230.8,
    "end": 232.44,
    "text": "它完全可以按讀所計"
  },
  {
    "start": 232.44,
    "end": 233.92,
    "text": "那我接下來就是第三步"
  },
  {
    "start": 233.92,
    "end": 235.12,
    "text": "管理文件結構"
  },
  {
    "start": 235.12,
    "end": 236.84,
    "text": "我要求將所有創作的漫畫"
  },
  {
    "start": 236.84,
    "end": 239.48,
    "text": "都保存在創作中的這個大文件牙中"
  },
  {
    "start": 239.48,
    "end": 241.76,
    "text": "字幕都能按照漫畫創作"
  },
  {
    "start": 241.76,
    "end": 243.6,
    "text": "和人物形象進行分類"
  },
  {
    "start": 243.6,
    "end": 245.0,
    "text": "一旦有新的角色出場"
  },
  {
    "start": 245.0,
    "end": 246.52,
    "text": "必須先在人物形象裡面"
  },
  {
    "start": 246.52,
    "end": 247.76,
    "text": "創作角色圖"
  },
  {
    "start": 247.76,
    "end": 249.76,
    "text": "然後人物的狀態"
  },
  {
    "start": 249.76,
    "end": 251.56,
    "text": "如果角色在某一張回退場"
  },
  {
    "start": 251.56,
    "end": 253.88,
    "text": "必須同步到剛才的那一份人物之中"
  },
  {
    "start": 253.88,
    "end": 255.76,
    "text": "所以確保文件中的所有鏈接"
  },
  {
    "start": 255.76,
    "end": 257.92,
    "text": "都是點擊可以直接跳轉的方面"
  },
  {
    "start": 257.92,
    "end": 258.92,
    "text": "我隨時查閱"
  },
  {
    "start": 258.92,
    "end": 260.52,
    "text": "你看這不就是卡拉希說的"
  },
  {
    "start": 261.44,
    "end": 263.4,
    "text": "OK 現在我們有了劇情分解"
  },
  {
    "start": 263.4,
    "end": 264.2,
    "text": "人物形象"
  },
  {
    "start": 264.2,
    "end": 266.32,
    "text": "漫畫設計書就可以開始創作了"
  },
  {
    "start": 266.32,
    "end": 268.32,
    "text": "來看一下這是我最終選用的"
  },
  {
    "start": 268.32,
    "end": 269.72,
    "text": "第一回的全部漫畫"
  },
  {
    "start": 269.72,
    "end": 271.88,
    "text": "人物完全使用了我指定的形象"
  },
  {
    "start": 271.88,
    "end": 273.28,
    "text": "相比最初的Demo"
  },
  {
    "start": 273.28,
    "end": 274.24,
    "text": "畫面編排"
  },
  {
    "start": 274.24,
    "end": 276.48,
    "text": "留白異境都明顯高級了許多"
  },
  {
    "start": 276.48,
    "end": 277.8,
    "text": "你用初步具有了"
  },
  {
    "start": 277.8,
    "end": 279.2,
    "text": "5.5俠漫畫的味道"
  },
  {
    "start": 279.2,
    "end": 280.68,
    "text": "但是我必須要說清楚"
  },
  {
    "start": 280.68,
    "end": 282.08,
    "text": "絕對不是從一開始"
  },
  {
    "start": 282.08,
    "end": 284.24,
    "text": "每張漫畫就都能夠達到這個效果"
  },
  {
    "start": 284.24,
    "end": 285.76,
    "text": "即便我們花了很多精力"
  },
  {
    "start": 285.76,
    "end": 288.04,
    "text": "投入給AI相對完善的工作指紋"
  },
  {
    "start": 288.04,
    "end": 289.08,
    "text": "第一回的漫畫呢"
  },
  {
    "start": 289.08,
    "end": 290.88,
    "text": "我最終選擇了42張"
  },
  {
    "start": 290.88,
    "end": 292.2,
    "text": "中間因為各種問題"
  },
  {
    "start": 292.2,
    "end": 293.64,
    "text": "比如說畫風共和室"
  },
  {
    "start": 293.64,
    "end": 294.24,
    "text": "台詞"
  },
  {
    "start": 294.24,
    "end": 294.76,
    "text": "不對應"
  },
  {
    "start": 294.76,
    "end": 296.04,
    "text": "人物形象錯亂等等"
  },
  {
    "start": 296.04,
    "end": 297.88,
    "text": "重新修改產生的二創廢片"
  },
  {
    "start": 297.88,
    "end": 299.12,
    "text": "更是高達60多張"
  },
  {
    "start": 299.12,
    "end": 300.04,
    "text": "過程很痛苦"
  },
  {
    "start": 300.04,
    "end": 301.2,
    "text": "所以說重點來了"
  },
  {
    "start": 301.2,
    "end": 302.16,
    "text": "創作過程中呢"
  },
  {
    "start": 302.16,
    "end": 304.32,
    "text": "我當然會不斷的給AI提要求"
  },
  {
    "start": 304.32,
    "end": 305.16,
    "text": "針對畫面"
  },
  {
    "start": 305.16,
    "end": 305.96,
    "text": "風格比處"
  },
  {
    "start": 305.96,
    "end": 307.08,
    "text": "人物等各種細節"
  },
  {
    "start": 307.08,
    "end": 307.96,
    "text": "不斷的調整"
  },
  {
    "start": 307.96,
    "end": 308.92,
    "text": "比如我要求"
  },
  {
    "start": 308.92,
    "end": 310.52,
    "text": "以循環的神態必須保持"
  },
  {
    "start": 310.52,
    "end": 311.36,
    "text": "儲便不禁"
  },
  {
    "start": 311.36,
    "end": 312.28,
    "text": "阿飛的表情呢"
  },
  {
    "start": 312.28,
    "end": 314.0,
    "text": "必須要保持少年的冷靜"
  },
  {
    "start": 314.0,
    "end": 315.24,
    "text": "台詞必須要遵循"
  },
  {
    "start": 315.24,
    "end": 316.92,
    "text": "原住1比1的進行還原"
  },
  {
    "start": 316.92,
    "end": 317.92,
    "text": "禁止度轉等等"
  },
  {
    "start": 319.08,
    "end": 320.32,
    "text": "AI都會更加懂我一點"
  },
  {
    "start": 320.32,
    "end": 321.76,
    "text": "等第一回全部完成後"
  },
  {
    "start": 321.76,
    "end": 322.72,
    "text": "我會告訴AI"
  },
  {
    "start": 322.72,
    "end": 324.6,
    "text": "拿幾頁漫畫的設計比處"
  },
  {
    "start": 324.6,
    "end": 326.2,
    "text": "拿幾頁是我特別喜歡的"
  },
  {
    "start": 326.2,
    "end": 327.88,
    "text": "哪些是以後禁止出現的"
  },
  {
    "start": 327.88,
    "end": 328.92,
    "text": "基於這些反饋呢"
  },
  {
    "start": 328.92,
    "end": 331.36,
    "text": "幫我創建標準畫風參考文件"
  },
  {
    "start": 331.36,
    "end": 333.12,
    "text": "和作品風格指導全集"
  },
  {
    "start": 333.12,
    "end": 334.68,
    "text": "用來指導後續的操作"
  },
  {
    "start": 334.68,
    "end": 335.92,
    "text": "你看這些文件"
  },
  {
    "start": 335.92,
    "end": 337.44,
    "text": "詳細記錄了我喜歡的"
  },
  {
    "start": 337.44,
    "end": 338.36,
    "text": "風格元素"
  },
  {
    "start": 338.36,
    "end": 339.56,
    "text": "漫畫芬蘭等等"
  },
  {
    "start": 339.56,
    "end": 341.88,
    "text": "這都是AI需要不斷學習的對象"
  },
  {
    "start": 341.88,
    "end": 343.16,
    "text": "如果說第一回漫畫的"
  },
  {
    "start": 343.16,
    "end": 344.68,
    "text": "達標率是50%"
  },
  {
    "start": 344.68,
    "end": 346.8,
    "text": "那麼第二回就有可能是70%"
  },
  {
    "start": 346.8,
    "end": 347.84,
    "text": "在整個過程中"
  },
  {
    "start": 347.88,
    "end": 349.56,
    "text": "我們其實創作了很多份"
  },
  {
    "start": 349.56,
    "end": 351.04,
    "text": "給AI看的參考指南"
  },
  {
    "start": 351.04,
    "end": 352.04,
    "text": "但是文件太多"
  },
  {
    "start": 352.04,
    "end": 353.72,
    "text": "也就意味著太長的剩下的"
  },
  {
    "start": 353.72,
    "end": 355.24,
    "text": "同樣會造成AI的幻覺"
  },
  {
    "start": 355.24,
    "end": 357.04,
    "text": "而且我不可能每次都給AI說"
  },
  {
    "start": 357.04,
    "end": 359.04,
    "text": "你去看這三四個文件學習"
  },
  {
    "start": 359.04,
    "end": 360.36,
    "text": "萬一它漏掉了怎麼辦"
  },
  {
    "start": 360.36,
    "end": 361.24,
    "text": "所以說第四步"
  },
  {
    "start": 361.24,
    "end": 362.2,
    "text": "很關鍵的來了"
  },
  {
    "start": 362.2,
    "end": 363.72,
    "text": "我讓AI全面回顧"
  },
  {
    "start": 363.72,
    "end": 366.2,
    "text": "我創作過程中的所有環節和要求"
  },
  {
    "start": 366.2,
    "end": 367.88,
    "text": "把所有需要引用的文件"
  },
  {
    "start": 367.88,
    "end": 369.2,
    "text": "全部設置為雙鍊"
  },
  {
    "start": 369.2,
    "end": 370.92,
    "text": "然後在整個下文件夾中"
  },
  {
    "start": 370.92,
    "end": 373.28,
    "text": "單獨創建一份工作人的說明書"
  },
  {
    "start": 373.28,
    "end": 374.12,
    "text": "也就是這個"
  },
  {
    "start": 374.12,
    "end": 376.04,
    "text": "不管到哪裡打開這個項目"
  },
  {
    "start": 376.08,
    "end": 378.36,
    "text": "所有AI都必須要先閱讀這份文件"
  },
  {
    "start": 378.36,
    "end": 379.36,
    "text": "才能夠幹活"
  },
  {
    "start": 379.36,
    "end": 380.08,
    "text": "你看這裡面"
  },
  {
    "start": 380.08,
    "end": 382.52,
    "text": "嚴格記錄了我所有的重要指示"
  },
  {
    "start": 382.52,
    "end": 384.68,
    "text": "並且它會隨著漫畫的更新而更新"
  },
  {
    "start": 384.68,
    "end": 386.92,
    "text": "這個就是整個項目的中央大腦"
  },
  {
    "start": 386.92,
    "end": 387.8,
    "text": "然後第五步"
  },
  {
    "start": 387.8,
    "end": 389.36,
    "text": "針對畫面和人物"
  },
  {
    "start": 389.36,
    "end": 391.8,
    "text": "我把自己的要求添加進寶玉Skills"
  },
  {
    "start": 391.8,
    "end": 394.72,
    "text": "創建了專屬小禮飛刀的飛刀Skills"
  },
  {
    "start": 394.72,
    "end": 395.92,
    "text": "現在只要我說"
  },
  {
    "start": 395.92,
    "end": 397.24,
    "text": "創作小禮飛刀漫畫"
  },
  {
    "start": 397.24,
    "end": 398.84,
    "text": "那它就會自動觸發"
  },
  {
    "start": 398.84,
    "end": 401.4,
    "text": "它會先閱讀這份工作流出名書"
  },
  {
    "start": 401.4,
    "end": 403.48,
    "text": "塗過我們漫畫創作的所有步驟"
  },
  {
    "start": 403.48,
    "end": 404.64,
    "text": "塗過我的項目進度"
  },
  {
    "start": 404.64,
    "end": 405.52,
    "text": "按照需要"
  },
  {
    "start": 405.56,
    "end": 407.04,
    "text": "依次創作劇情分解"
  },
  {
    "start": 407.04,
    "end": 408.8,
    "text": "人物形象以及最後的漫畫"
  },
  {
    "start": 408.8,
    "end": 409.88,
    "text": "哪怕換了臺電腦"
  },
  {
    "start": 409.88,
    "end": 412.4,
    "text": "只要我拷貝了這個項目和飛刀Skills"
  },
  {
    "start": 412.4,
    "end": 413.0,
    "text": "不管到哪"
  },
  {
    "start": 413.0,
    "end": 414.44,
    "text": "AI立馬就能幹活"
  },
  {
    "start": 414.44,
    "end": 415.76,
    "text": "而且我再也不需要擔心"
  },
  {
    "start": 415.76,
    "end": 417.08,
    "text": "風格移至性的問題"
  },
  {
    "start": 417.08,
    "end": 418.0,
    "text": "你像第四回"
  },
  {
    "start": 418.0,
    "end": 418.92,
    "text": "完整的漫畫"
  },
  {
    "start": 418.92,
    "end": 420.72,
    "text": "我最終選用了38張"
  },
  {
    "start": 420.72,
    "end": 422.6,
    "text": "但是廢片只有十幾張"
  },
  {
    "start": 422.6,
    "end": 424.76,
    "text": "花費從30刀降低到了10刀"
  },
  {
    "start": 424.76,
    "end": 426.16,
    "text": "這就是自我進化"
  },
  {
    "start": 426.16,
    "end": 427.88,
    "text": "其實你構建任何的工作流"
  },
  {
    "start": 427.88,
    "end": 430.16,
    "text": "都可以參考我這套訓練AI的思路"
  },
  {
    "start": 430.16,
    "end": 432.04,
    "text": "認真打磨本地MARK檔文件"
  },
  {
    "start": 432.04,
    "end": 435.04,
    "text": "讓AI清晰的知道每個項目的職能和權限"
  },
  {
    "start": 435.04,
    "end": 436.12,
    "text": "你的工作進度"
  },
  {
    "start": 436.12,
    "end": 438.32,
    "text": "漫畫創作需要設計分頁"
  },
  {
    "start": 438.32,
    "end": 439.12,
    "text": "畫面編排"
  },
  {
    "start": 439.12,
    "end": 440.52,
    "text": "多人物的臺詞組合"
  },
  {
    "start": 440.52,
    "end": 442.6,
    "text": "創作文案其實要簡單的多"
  },
  {
    "start": 442.6,
    "end": 443.28,
    "text": "我們都知道"
  },
  {
    "start": 443.28,
    "end": 444.72,
    "text": "AI的幻覺沒法避免"
  },
  {
    "start": 444.72,
    "end": 446.12,
    "text": "並且對話的次數越多"
  },
  {
    "start": 446.12,
    "end": 447.92,
    "text": "出現幻覺的概率就越高"
  },
  {
    "start": 447.92,
    "end": 450.76,
    "text": "這時候使用Obscdian的優勢就體現出來了"
  },
  {
    "start": 450.76,
    "end": 452.92,
    "text": "所以精心打磨自己的本地知識庫"
  },
  {
    "start": 452.92,
    "end": 453.96,
    "text": "真的非常重要"
  },
  {
    "start": 453.96,
    "end": 456.04,
    "text": "像我就會把自己大部分的物料"
  },
  {
    "start": 456.04,
    "end": 457.44,
    "text": "寫作、書籍、思考"
  },
  {
    "start": 457.44,
    "end": 459.2,
    "text": "都存放在不同的文件夾下面"
  },
  {
    "start": 459.2,
    "end": 461.44,
    "text": "每一個都包含單獨的MARK檔文件"
  },
  {
    "start": 461.44,
    "end": 462.56,
    "text": "並且我會告訴AI"
  },
  {
    "start": 462.56,
    "end": 464.2,
    "text": "每個文件夾是用來做什麼"
  },
  {
    "start": 464.24,
    "end": 465.84,
    "text": "哪些是可以互相調用的"
  },
  {
    "start": 465.84,
    "end": 466.88,
    "text": "遇到可能會需要"
  },
  {
    "start": 466.88,
    "end": 468.6,
    "text": "重複輸入提示詞的流程"
  },
  {
    "start": 468.6,
    "end": 470.0,
    "text": "我就會新建一個sql"
  },
  {
    "start": 470.0,
    "end": 472.28,
    "text": "只要你深刻理解我上面分享的思路"
  },
  {
    "start": 472.28,
    "end": 473.48,
    "text": "其實你也就明白了"
  },
  {
    "start": 473.48,
    "end": 474.52,
    "text": "最近爆火的"
  },
  {
    "start": 474.52,
    "end": 476.36,
    "text": "艾瑪士Agent的底層邏輯"
  },
  {
    "start": 476.36,
    "end": 478.56,
    "text": "這樣你的知識庫就不再是死的Viki"
  },
  {
    "start": 478.56,
    "end": 479.76,
    "text": "而是一套活的系統"
  },
  {
    "start": 479.76,
    "end": 480.04,
    "text": "好"
  },
  {
    "start": 480.04,
    "end": 481.32,
    "text": "那麼現在問題來了"
  },
  {
    "start": 481.32,
    "end": 483.8,
    "text": "將來你的本地文件肯定是越來越多"
  },
  {
    "start": 483.8,
    "end": 485.76,
    "text": "萬一AI誤刪了重要文件"
  },
  {
    "start": 485.76,
    "end": 487.04,
    "text": "或者說改動不滿意"
  },
  {
    "start": 487.04,
    "end": 488.92,
    "text": "你想要回退上一個版本怎麼辦"
  },
  {
    "start": 488.92,
    "end": 490.16,
    "text": "我前期創作過程中"
  },
  {
    "start": 490.16,
    "end": 491.56,
    "text": "經常出現這樣的問題"
  },
  {
    "start": 491.56,
    "end": 494.16,
    "text": "比如說AI創作了一張我很滿意的動畫"
  },
  {
    "start": 494.2,
    "end": 496.36,
    "text": "它的色彩人物分鏡都很完美"
  },
  {
    "start": 496.36,
    "end": 497.92,
    "text": "但就是台詞沒有對應上"
  },
  {
    "start": 497.92,
    "end": 499.24,
    "text": "即便我嚴肅要用它"
  },
  {
    "start": 499.24,
    "end": 500.8,
    "text": "務必只能修改台詞"
  },
  {
    "start": 500.8,
    "end": 502.08,
    "text": "結果它依然降止"
  },
  {
    "start": 502.08,
    "end": 503.16,
    "text": "覆蓋了整個文件"
  },
  {
    "start": 503.16,
    "end": 504.88,
    "text": "就算我讓它返回上一版本"
  },
  {
    "start": 504.88,
    "end": 505.68,
    "text": "AI能做的"
  },
  {
    "start": 505.68,
    "end": 508.28,
    "text": "也就只能是參考腳本代碼重新抽卡"
  },
  {
    "start": 508.28,
    "end": 510.04,
    "text": "你一定得不到原來想要的出稿"
  },
  {
    "start": 510.04,
    "end": 510.68,
    "text": "所以接下來"
  },
  {
    "start": 510.68,
    "end": 513.08,
    "text": "你料學會使用Gate進行版本控制"
  },
  {
    "start": 513.08,
    "end": 514.32,
    "text": "這是你的安全網"
  },
  {
    "start": 514.32,
    "end": 515.76,
    "text": "首先按到設置"
  },
  {
    "start": 515.76,
    "end": 517.12,
    "text": "第三方插件"
  },
  {
    "start": 517.12,
    "end": 519.6,
    "text": "插件市場蘇索安裝Gate"
  },
  {
    "start": 519.6,
    "end": 521.36,
    "text": "這裡直接安裝並啟用"
  },
  {
    "start": 521.36,
    "end": 523.36,
    "text": "如果你的Word還不是一個Gate倉庫"
  },
  {
    "start": 523.36,
    "end": 524.92,
    "text": "需要先進行初始化"
  },
  {
    "start": 524.92,
    "end": 526.08,
    "text": "你需要打開中端"
  },
  {
    "start": 526.08,
    "end": 528.76,
    "text": "中端也可以在插件市場里面安裝"
  },
  {
    "start": 528.76,
    "end": 530.72,
    "text": "完成之後點擊這裡"
  },
  {
    "start": 530.72,
    "end": 534.2,
    "text": "選擇整合式就能直接在Obsidian中打開"
  },
  {
    "start": 534.2,
    "end": 536.4,
    "text": "你要輸入Gate與Nit"
  },
  {
    "start": 536.4,
    "end": 538.08,
    "text": "對倉庫進行初始化"
  },
  {
    "start": 538.08,
    "end": 539.88,
    "text": "然後你需要去Gatehub中"
  },
  {
    "start": 539.88,
    "end": 542.0,
    "text": "新建一個私人的倉庫"
  },
  {
    "start": 542.0,
    "end": 544.12,
    "text": "等地數據一定要選擇不公開"
  },
  {
    "start": 544.12,
    "end": 546.36,
    "text": "這裡面就是你Obsidian的遠程備份"
  },
  {
    "start": 546.36,
    "end": 548.56,
    "text": "一旦發生錯誤可以隨時回退"
  },
  {
    "start": 548.56,
    "end": 551.2,
    "text": "現在你需要把本地的Obsidian倉庫"
  },
  {
    "start": 551.2,
    "end": 552.72,
    "text": "和Gatehub連接起來"
  },
  {
    "start": 552.8,
    "end": 555.2,
    "text": "直接把我給你的這段提示詞發給AI"
  },
  {
    "start": 555.2,
    "end": 559.0,
    "text": "連接成功後回到Obsidian設置里的Gate插件"
  },
  {
    "start": 559.0,
    "end": 561.12,
    "text": "將這裡的時間設置為10分鐘"
  },
  {
    "start": 561.12,
    "end": 562.88,
    "text": "或者你覺得合適的時間"
  },
  {
    "start": 562.88,
    "end": 564.92,
    "text": "日常使用你不需要做任何事情"
  },
  {
    "start": 564.92,
    "end": 568.16,
    "text": "每隔幾分鐘插件就會自動提交推送到Gatehub"
  },
  {
    "start": 568.16,
    "end": 570.64,
    "text": "相當於你的知識庫有了一個時時的備份"
  },
  {
    "start": 570.64,
    "end": 571.88,
    "text": "加完整的歷史"
  },
  {
    "start": 571.88,
    "end": 573.96,
    "text": "AIP量處理文件的能力越強"
  },
  {
    "start": 573.96,
    "end": 575.96,
    "text": "你就越需要版本控制AtoD"
  },
  {
    "start": 575.96,
    "end": 577.68,
    "text": "所以說這可以說是必選項"
  },
  {
    "start": 577.68,
    "end": 581.56,
    "text": "我也非常推薦你在中端中提前安裝好Gatehub的CLI"
  },
  {
    "start": 581.6,
    "end": 583.36,
    "text": "這樣整體安裝會更加簡單"
  },
  {
    "start": 583.36,
    "end": 584.64,
    "text": "如果你還是有問題"
  },
  {
    "start": 584.64,
    "end": 586.44,
    "text": "就直接把我的文檔發給AI"
  },
  {
    "start": 586.44,
    "end": 588.72,
    "text": "讓它幫你根據Gate版本控制內容"
  },
  {
    "start": 588.72,
    "end": 589.96,
    "text": "直接幫你配置好"
  },
  {
    "start": 589.96,
    "end": 590.48,
    "text": "好的"
  },
  {
    "start": 590.48,
    "end": 591.68,
    "text": "現在你已經知道了"
  },
  {
    "start": 591.68,
    "end": 593.2,
    "text": "怎麼管理本地信息"
  },
  {
    "start": 593.2,
    "end": 594.64,
    "text": "也已經會用Cloud Code"
  },
  {
    "start": 594.64,
    "end": 596.64,
    "text": "加Obsidian協助產出內容"
  },
  {
    "start": 596.64,
    "end": 599.4,
    "text": "接下來你特別需要給你的文章添加插圖"
  },
  {
    "start": 599.4,
    "end": 601.24,
    "text": "並且把它放置在合適的位置"
  },
  {
    "start": 601.24,
    "end": 604.6,
    "text": "這時候我們就需要調用保育Skill中的另一項技能"
  },
  {
    "start": 604.6,
    "end": 606.56,
    "text": "自動創作並且插入配圖"
  },
  {
    "start": 606.56,
    "end": 609.36,
    "text": "你看這篇文章就是我本期內容的文案"
  },
  {
    "start": 609.36,
    "end": 611.36,
    "text": "錄製的時候我還沒有整理文道"
  },
  {
    "start": 611.4,
    "end": 613.12,
    "text": "現在直接演示給你們看"
  },
  {
    "start": 613.12,
    "end": 614.56,
    "text": "調用保育Skill"
  },
  {
    "start": 614.56,
    "end": 618.16,
    "text": "首先將這篇文章整理為適合公眾號發布的版本"
  },
  {
    "start": 618.16,
    "end": 620.48,
    "text": "注意添加合適的標題和分段"
  },
  {
    "start": 620.48,
    "end": 621.28,
    "text": "注意排版"
  },
  {
    "start": 621.28,
    "end": 623.0,
    "text": "配色需要簡潔清爽"
  },
  {
    "start": 623.0,
    "end": 625.6,
    "text": "並且我需要你在合適的位置添加插圖"
  },
  {
    "start": 625.6,
    "end": 627.68,
    "text": "請注意不要覆蓋當前的文件"
  },
  {
    "start": 627.68,
    "end": 630.16,
    "text": "我需要你在文件牙中重新創建"
  },
  {
    "start": 632.6,
    "end": 636.24,
    "text": "你看這裡它會讓我們選擇配圖的風格和數量"
  },
  {
    "start": 636.24,
    "end": 639.16,
    "text": "我這裡面選一下選全場頂圖"
  },
  {
    "start": 639.2,
    "end": 642.28,
    "text": "插圖的密度選擇均衡"
  },
  {
    "start": 642.28,
    "end": 645.48,
    "text": "然後視覺風格有四種你可以選"
  },
  {
    "start": 645.48,
    "end": 647.16,
    "text": "我們隨便選一個"
  },
  {
    "start": 647.16,
    "end": 648.44,
    "text": "然後提交"
  },
  {
    "start": 648.44,
    "end": 652.4,
    "text": "注意這裡生塗它需要調動NanoBudana的API-K"
  },
  {
    "start": 652.4,
    "end": 655.52,
    "text": "免費額度不高的話可能會產生一點點的費用"
  },
  {
    "start": 655.52,
    "end": 657.28,
    "text": "不過這些費用是可以接受的"
  },
  {
    "start": 657.28,
    "end": 659.72,
    "text": "然後我們繼續給大家一首歌的時間"
  },
  {
    "start": 660.28,
    "end": 661.24,
    "text": "來看一下效果"
  },
  {
    "start": 661.24,
    "end": 664.8,
    "text": "好你看它先幫我們進行了一篇新文章的葛飾化"
  },
  {
    "start": 664.8,
    "end": 666.92,
    "text": "增加了完善的原數據和結構"
  },
  {
    "start": 667.0,
    "end": 669.44,
    "text": "然後對插圖的位置進行了規劃"
  },
  {
    "start": 669.44,
    "end": 672.2,
    "text": "自己寫了六個生成插圖的提示詞"
  },
  {
    "start": 672.2,
    "end": 674.08,
    "text": "然後進行圖片生成"
  },
  {
    "start": 674.08,
    "end": 675.96,
    "text": "然後它現在已經生成了六張插圖"
  },
  {
    "start": 675.96,
    "end": 678.12,
    "text": "並且插入到一篇新的文章中"
  },
  {
    "start": 678.12,
    "end": 679.36,
    "text": "插圖的位置在這裡"
  },
  {
    "start": 679.36,
    "end": 682.04,
    "text": "我們先來點開看一下六張圖片"
  },
  {
    "start": 682.04,
    "end": 686.6,
    "text": "這篇它我是沒想到它自己創造了阿菲克比玄花的人物"
  },
  {
    "start": 686.6,
    "end": 689.4,
    "text": "然後這邊都是根據我文章的一些"
  },
  {
    "start": 689.4,
    "end": 692.28,
    "text": "新聞的一些要求去進行的圖片創作"
  },
  {
    "start": 692.28,
    "end": 694.36,
    "text": "你看圖片其實還是挺好看的"
  },
  {
    "start": 694.36,
    "end": 696.52,
    "text": "然後我們看一下這邊新生的文章"
  },
  {
    "start": 696.52,
    "end": 697.92,
    "text": "就在這個文件夾裡面"
  },
  {
    "start": 697.92,
    "end": 702.6,
    "text": "來看一下感覺一下它的位置和內容是不是都還挺合適的"
  },
  {
    "start": 702.6,
    "end": 704.76,
    "text": "要知道從天排版插圖"
  },
  {
    "start": 704.76,
    "end": 707.2,
    "text": "真的是件非常費力不討好的工作"
  },
  {
    "start": 707.2,
    "end": 709.56,
    "text": "但現在只需要一個skills就能直接搞定"
  },
  {
    "start": 709.56,
    "end": 711.28,
    "text": "這樣的內容形式和聲透質量"
  },
  {
    "start": 711.28,
    "end": 713.08,
    "text": "對於我而言是完全夠用的"
  },
  {
    "start": 713.08,
    "end": 716.76,
    "text": "如果你平常刷推特就會發現有非常多優質的文章"
  },
  {
    "start": 716.76,
    "end": 719.2,
    "text": "也都是採用類似的排版和配合法案"
  },
  {
    "start": 719.2,
    "end": 721.24,
    "text": "可能我們都使用了相同的skills"
  },
  {
    "start": 721.24,
    "end": 722.16,
    "text": "另外說一下"
  },
  {
    "start": 722.16,
    "end": 725.76,
    "text": "保佑skills是可以直接幫你一鍵發布公眾號和推特的"
  },
  {
    "start": 725.76,
    "end": 728.48,
    "text": "全部的功能你們都可以自己按照體驗一下"
  },
  {
    "start": 728.48,
    "end": 731.32,
    "text": "OK現在我們終於來到最終的發布環節"
  },
  {
    "start": 731.32,
    "end": 734.16,
    "text": "雖然我剛提到保佑skills是可以直接完成"
  },
  {
    "start": 734.16,
    "end": 737.12,
    "text": "但是我還是想再給你推薦一個更加經驗的工具"
  },
  {
    "start": 737.12,
    "end": 738.48,
    "text": "這是一款開源的插件"
  },
  {
    "start": 738.48,
    "end": 741.76,
    "text": "可以在OPC店中直接實現手機畫面實施預覽"
  },
  {
    "start": 741.76,
    "end": 743.36,
    "text": "效果就是這樣"
  },
  {
    "start": 743.36,
    "end": 745.28,
    "text": "你看我這邊公眾號的文章"
  },
  {
    "start": 745.28,
    "end": 748.08,
    "text": "直接在右邊的插件中就可以同步"
  },
  {
    "start": 748.08,
    "end": 751.96,
    "text": "而且這個排版直接就是之後發送到你手機預覽的一個效果"
  },
  {
    "start": 751.96,
    "end": 753.92,
    "text": "點擊這裡可以修改主題色"
  },
  {
    "start": 753.92,
    "end": 755.64,
    "text": "主題色就是這些標題的顏色"
  },
  {
    "start": 755.64,
    "end": 757.36,
    "text": "比如說我現在設計成橙色"
  },
  {
    "start": 757.36,
    "end": 759.24,
    "text": "你看這裡立馬就發生了變化"
  },
  {
    "start": 759.24,
    "end": 760.96,
    "text": "包括這個2.24的標題"
  },
  {
    "start": 760.96,
    "end": 764.24,
    "text": "這邊字題推薦的是16px的"
  },
  {
    "start": 764.24,
    "end": 767.32,
    "text": "我一般會使用14ps也就是這個小號"
  },
  {
    "start": 767.32,
    "end": 770.84,
    "text": "然後這邊頁面兩側600都可以自己調整"
  },
  {
    "start": 770.84,
    "end": 773.04,
    "text": "比方說我隨意點擊一篇別的文章"
  },
  {
    "start": 773.04,
    "end": 776.96,
    "text": "你看這邊都是可以直接顯示發布之後的效果"
  },
  {
    "start": 776.96,
    "end": 780.08,
    "text": "也就是說以後你只需要在OPC店裡面專注創作"
  },
  {
    "start": 780.08,
    "end": 782.08,
    "text": "修改、排版、預覽這些小事"
  },
  {
    "start": 782.08,
    "end": 783.08,
    "text": "你順手就幹了"
  },
  {
    "start": 783.08,
    "end": 785.68,
    "text": "而且完全不需要登入平臺在24邊際了"
  },
  {
    "start": 785.68,
    "end": 789.84,
    "text": "更覺得是這些圖片素材也不需要專門的網頁登入上傳"
  },
  {
    "start": 789.84,
    "end": 791.96,
    "text": "這些塗窗鏈接是可以直接保存的"
  },
  {
    "start": 791.96,
    "end": 795.08,
    "text": "我之前發布漫畫的圖文需要一張一張的上傳排文"
  },
  {
    "start": 795.08,
    "end": 796.28,
    "text": "單獨設計文字合適"
  },
  {
    "start": 796.28,
    "end": 799.04,
    "text": "現在直接全部都在OPC店中興建一個MACDOWN"
  },
  {
    "start": 799.04,
    "end": 800.08,
    "text": "就是直接完成了"
  },
  {
    "start": 800.08,
    "end": 801.88,
    "text": "真正實現所見及所得"
  },
  {
    "start": 801.88,
    "end": 804.24,
    "text": "我第一次使用的時候確實有被驚豔到"
  },
  {
    "start": 804.24,
    "end": 805.8,
    "text": "創作效率直接起飛"
  },
  {
    "start": 805.8,
    "end": 806.92,
    "text": "安裝步驟很簡單"
  },
  {
    "start": 806.92,
    "end": 808.92,
    "text": "你在視頻裡跟我走一遍就OK了"
  },
  {
    "start": 808.92,
    "end": 811.12,
    "text": "首先我們還是來到這個插件市場"
  },
  {
    "start": 812.12,
    "end": 815.12,
    "text": "在這裡搜索DRAT插件"
  },
  {
    "start": 815.12,
    "end": 816.6,
    "text": "先把這個安裝上"
  },
  {
    "start": 816.6,
    "end": 818.6,
    "text": "安裝上之後能來到這裡"
  },
  {
    "start": 818.6,
    "end": 820.2,
    "text": "點擊這裡的ADPLUGIN"
  },
  {
    "start": 820.2,
    "end": 822.6,
    "text": "然後把倉庫的地址放在這裡"
  },
  {
    "start": 822.6,
    "end": 824.2,
    "text": "然後直接點擊添加"
  },
  {
    "start": 824.2,
    "end": 825.8,
    "text": "就可以直接幫你安裝好"
  },
  {
    "start": 825.8,
    "end": 828.2,
    "text": "未來有新的更新也可以直接點擊這裡"
  },
  {
    "start": 828.2,
    "end": 831.32,
    "text": "安裝好的插件就會直接在這裡面顯示"
  },
  {
    "start": 831.32,
    "end": 834.2,
    "text": "然後你可以直接在這裡面添加自己的微信帳號"
  },
  {
    "start": 834.2,
    "end": 837.12,
    "text": "輸入APPID還有開發者命要就可以了"
  },
  {
    "start": 837.12,
    "end": 838.56,
    "text": "點擊保存就OK"
  },
  {
    "start": 838.56,
    "end": 840.56,
    "text": "同步了之後點擊這裡的發送"
  },
  {
    "start": 840.56,
    "end": 843.56,
    "text": "就可以直接上傳到微信公眾平台的草稿箱"
  },
  {
    "start": 843.56,
    "end": 846.04,
    "text": "在這裡也可以直接上傳封面和摘要"
  },
  {
    "start": 846.04,
    "end": 847.24,
    "text": "我真的太喜歡這種"
  },
  {
    "start": 847.24,
    "end": 850.76,
    "text": "一個本地智庫可以遠程鏈接其他平台的交互方式"
  },
  {
    "start": 850.76,
    "end": 852.96,
    "text": "只要你使用過就知道有多簡养時間"
  },
  {
    "start": 852.96,
    "end": 855.36,
    "text": "但如果你要發送的是飛書鏈接呢"
  },
  {
    "start": 855.36,
    "end": 858.16,
    "text": "這個時候如果你的中端同山莊了Obsidian"
  },
  {
    "start": 858.16,
    "end": 859.64,
    "text": "和飛書的CLI"
  },
  {
    "start": 859.64,
    "end": 861.56,
    "text": "那麼你完全可以通過Cloud Code"
  },
  {
    "start": 861.56,
    "end": 864.16,
    "text": "直接從中端操作這兩個位置的文件"
  },
  {
    "start": 864.16,
    "end": 867.24,
    "text": "我們直接在Obsidian裡面打開中端"
  },
  {
    "start": 867.24,
    "end": 870.84,
    "text": "比方我直接在這裡跟大家說"
  },
  {
    "start": 870.84,
    "end": 873.24,
    "text": "幫我把這份文件發送到飛書"
  },
  {
    "start": 873.24,
    "end": 875.04,
    "text": "並且給我一個可以分享的鏈接"
  },
  {
    "start": 875.04,
    "end": 879.04,
    "text": "然後把這篇文件的錄進給複製過來"
  },
  {
    "start": 879.04,
    "end": 882.04,
    "text": "套完創工作之後"
  },
  {
    "start": 882.04,
    "end": 885.04,
    "text": "我們點擊這裡的鏈接是可以直接打開飛書的"
  },
  {
    "start": 885.04,
    "end": 887.84,
    "text": "你看這個可能就是我稍後發給你們的文檔"
  },
  {
    "start": 887.84,
    "end": 890.84,
    "text": "在全部的創造功能中我甚至都沒有打開飛書"
  },
  {
    "start": 890.84,
    "end": 893.64,
    "text": "這文檔我稍微改動一下就可以直接使用了"
  },
  {
    "start": 893.64,
    "end": 896.04,
    "text": "是不是真的很節省時間"
  },
  {
    "start": 896.04,
    "end": 898.04,
    "text": "我之前視頻的文檔和資源"
  },
  {
    "start": 898.04,
    "end": 900.24,
    "text": "也都是通過這種方式去製作的"
  },
  {
    "start": 900.24,
    "end": 903.04,
    "text": "好的我們現在已經完整的走完了一整套"
  },
  {
    "start": 903.04,
    "end": 906.04,
    "text": "從創作排版發布的內容創作全流程"
  },
  {
    "start": 906.04,
    "end": 909.04,
    "text": "我有自信看到這裡你一定有非常大的收穫"
  },
  {
    "start": 909.04,
    "end": 912.24,
    "text": "從此你的本體知識庫可不僅僅是收集資源的地方"
  },
  {
    "start": 912.24,
    "end": 913.44,
    "text": "它是你的第二大腦"
  },
  {
    "start": 913.44,
    "end": 915.44,
    "text": "更是會持續進化的假賠司"
  },
  {
    "start": 915.44,
    "end": 916.64,
    "text": "回顧卡巴西的方法"
  },
  {
    "start": 916.64,
    "end": 919.04,
    "text": "它教我們構建的是一個靜態的知識庫"
  },
  {
    "start": 919.04,
    "end": 920.44,
    "text": "收集鏈接簡索"
  },
  {
    "start": 920.44,
    "end": 923.24,
    "text": "但我今天教你的是一套動態智能系統"
  },
  {
    "start": 923.24,
    "end": 924.64,
    "text": "理解創造進化"
  },
  {
    "start": 924.64,
    "end": 926.24,
    "text": "使用工具只是第一步"
  },
  {
    "start": 926.24,
    "end": 929.84,
    "text": "真正的價值是把模糊的需求變成可執行的流程"
  },
  {
    "start": 929.84,
    "end": 932.24,
    "text": "每次對話過程都在訓練AI更等你"
  },
  {
    "start": 932.24,
    "end": 934.04,
    "text": "然後大膽是錯隨時回退"
  },
  {
    "start": 934.04,
    "end": 937.04,
    "text": "相信之後的你不是直接問AI怎麼寫文案"
  },
  {
    "start": 937.04,
    "end": 938.84,
    "text": "而是主動構建這套系統"
  },
  {
    "start": 938.84,
    "end": 940.24,
    "text": "讓AI懂你的風格"
  },
  {
    "start": 940.24,
    "end": 941.44,
    "text": "你的標準你的審美"
  },
  {
    "start": 941.44,
    "end": 942.84,
    "text": "讓它陪著你一起進化"
  },
  {
    "start": 942.84,
    "end": 945.04,
    "text": "等你的文章排版無需手動調整"
  },
  {
    "start": 945.04,
    "end": 946.84,
    "text": "等你的工作流可以自動運轉"
  },
  {
    "start": 946.84,
    "end": 949.44,
    "text": "你就會明白什麼叫做真正的假賠司"
  },
  {
    "start": 949.44,
    "end": 951.64,
    "text": "好的以上就是本期的全部內容"
  },
  {
    "start": 951.64,
    "end": 953.04,
    "text": "這裡我先賣一個關子"
  },
  {
    "start": 953.04,
    "end": 955.44,
    "text": "本期的標題是Obsidian從1到2"
  },
  {
    "start": 955.44,
    "end": 958.44,
    "text": "下期內容我將開源一套真正會自我進化"
  },
  {
    "start": 958.44,
    "end": 960.64,
    "text": "而且越用越強的第二大檔系統"
  },
  {
    "start": 960.64,
    "end": 962.84,
    "text": "涵蓋閱讀寫作表達幾大百塊"
  },
  {
    "start": 962.84,
    "end": 965.04,
    "text": "並且手把手告訴你打減4米"
  },
  {
    "start": 965.04,
    "end": 966.44,
    "text": "在居身智能爆發前"
  },
  {
    "start": 966.44,
    "end": 967.44,
    "text": "HER的初始形態"
  },
  {
    "start": 967.44,
    "end": 970.44,
    "text": "真的可能就是你本地的Obsidian加AI的形式"
  },
  {
    "start": 970.44,
    "end": 972.44,
    "text": "我將帶你把Obsidian的使用能力"
  },
  {
    "start": 972.44,
    "end": 973.84,
    "text": "從2突破正無窮"
  },
  {
    "start": 973.84,
    "end": 974.44,
    "text": "說實話"
  },
  {
    "start": 974.44,
    "end": 976.44,
    "text": "這套系統我自己也等了兩年"
  },
  {
    "start": 976.44,
    "end": 977.44,
    "text": "歡迎持續關注"
  },
  {
    "start": 977.44,
    "end": 978.44,
    "text": "也請一鍵三連"
  },
  {
    "start": 978.44,
    "end": 980.24,
    "text": "這將對我有非常大的幫助"
  }
]