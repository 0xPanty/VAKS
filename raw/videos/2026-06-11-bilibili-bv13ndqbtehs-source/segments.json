[
  {
    "start": 0.0,
    "end": 2.0,
    "text": "哈喽大家好我是褪衣承轩"
  },
  {
    "start": 2.0,
    "end": 4.3,
    "text": "有时候根据不同的工作场景"
  },
  {
    "start": 4.3,
    "end": 6.3,
    "text": "我们可能需要在Opacity里面"
  },
  {
    "start": 6.3,
    "end": 7.8,
    "text": "使用不同的布局"
  },
  {
    "start": 7.8,
    "end": 9.9,
    "text": "来展示不同的Workplace"
  },
  {
    "start": 9.9,
    "end": 11.5,
    "text": "也就是工作空间"
  },
  {
    "start": 11.5,
    "end": 13.4,
    "text": "这就好像没有几个房间"
  },
  {
    "start": 13.4,
    "end": 15.1,
    "text": "每个房间的功能不同"
  },
  {
    "start": 15.1,
    "end": 17.8,
    "text": "它的家具的摆放位置也不同"
  },
  {
    "start": 17.8,
    "end": 19.2,
    "text": "这我就来介绍一下"
  },
  {
    "start": 19.2,
    "end": 21.4,
    "text": "如何利用Opacity自带的插件"
  },
  {
    "start": 21.4,
    "end": 24.0,
    "text": "来管理工作空间的布局"
  },
  {
    "start": 24.0,
    "end": 25.6,
    "text": "这里我为我的知识库"
  },
  {
    "start": 25.6,
    "end": 29.6,
    "text": "创建了一个首页的工作空间的布局"
  },
  {
    "start": 29.6,
    "end": 31.5,
    "text": "首先我打开了"
  },
  {
    "start": 31.5,
    "end": 33.0,
    "text": "之前我做的"
  },
  {
    "start": 33.0,
    "end": 36.5,
    "text": "有着主页功能的Home这个画布文件"
  },
  {
    "start": 36.5,
    "end": 39.0,
    "text": "然后我又打开了右边蓝"
  },
  {
    "start": 39.0,
    "end": 41.7,
    "text": "讲一些常用的空间"
  },
  {
    "start": 41.7,
    "end": 43.0,
    "text": "拓拽到其中"
  },
  {
    "start": 43.0,
    "end": 44.9,
    "text": "由这里我先打开了日历"
  },
  {
    "start": 44.9,
    "end": 48.0,
    "text": "然后拓拽了我自制的番茄中"
  },
  {
    "start": 48.0,
    "end": 49.0,
    "text": "这个空间"
  },
  {
    "start": 49.0,
    "end": 50.8,
    "text": "为了更加酷炫一点"
  },
  {
    "start": 50.8,
    "end": 55.1,
    "text": "还可以把GraphView这个图形化的试图"
  },
  {
    "start": 55.1,
    "end": 57.1,
    "text": "也拓拽进右边蓝"
  },
  {
    "start": 57.1,
    "end": 59.1,
    "text": "经过一些细微调节之后"
  },
  {
    "start": 59.2,
    "end": 61.1,
    "text": "我们就可以固定"
  },
  {
    "start": 61.1,
    "end": 65.5,
    "text": "去保存这个工作空间的布局了"
  },
  {
    "start": 65.5,
    "end": 68.7,
    "text": "这里我点击的是左边蓝"
  },
  {
    "start": 68.7,
    "end": 71.6,
    "text": "代表着Manage Workspace"
  },
  {
    "start": 71.6,
    "end": 73.4,
    "text": "这个插件的图标"
  },
  {
    "start": 73.4,
    "end": 75.9,
    "text": "点击之后它会弹出一个对话框"
  },
  {
    "start": 75.9,
    "end": 79.1,
    "text": "让我们输入要保存的"
  },
  {
    "start": 79.1,
    "end": 81.6,
    "text": "工作空间的布局名称"
  },
  {
    "start": 81.6,
    "end": 83.3,
    "text": "这里我起名叫做Home"
  },
  {
    "start": 83.3,
    "end": 86.2,
    "text": "这样在这个列表当中"
  },
  {
    "start": 86.2,
    "end": 90.6,
    "text": "就添加了我自定义的Home这个布局"
  },
  {
    "start": 90.6,
    "end": 93.2,
    "text": "这样如果我们之后改变了"
  },
  {
    "start": 93.2,
    "end": 95.8,
    "text": "当前的界面的布局"
  },
  {
    "start": 95.8,
    "end": 99.0,
    "text": "或者是打开的文件之后"
  },
  {
    "start": 99.0,
    "end": 101.3,
    "text": "如果想快速的恢复"
  },
  {
    "start": 101.3,
    "end": 104.4,
    "text": "刚才设置的首页的布局的话"
  },
  {
    "start": 104.4,
    "end": 108.3,
    "text": "我还可以再按一下左边蓝里面的"
  },
  {
    "start": 108.3,
    "end": 110.5,
    "text": "这个插件的图标"
  },
  {
    "start": 110.5,
    "end": 113.6,
    "text": "然后弹出这个管理界面之后"
  },
  {
    "start": 113.6,
    "end": 117.2,
    "text": "点击对应的布局的Loud按键"
  },
  {
    "start": 117.2,
    "end": 121.2,
    "text": "这样它就会重新开启我们之前保存的布局"
  },
  {
    "start": 121.2,
    "end": 123.6,
    "text": "另外我们也可以在拼号设置页面的"
  },
  {
    "start": 123.6,
    "end": 125.2,
    "text": "HotKiss当中"
  },
  {
    "start": 125.2,
    "end": 128.4,
    "text": "为这个插件可用的命令设置快捷键"
  },
  {
    "start": 128.4,
    "end": 132.8,
    "text": "例如这里我为加载工作空间的布局"
  },
  {
    "start": 132.8,
    "end": 135.16,
    "text": "这个功能就设置了一个"
  },
  {
    "start": 135.16,
    "end": 138.1,
    "text": "Ctrl加Io的快捷方式"
  },
  {
    "start": 138.1,
    "end": 142.4,
    "text": "这样如果我想恢复到首页的布局的话"
  },
  {
    "start": 142.4,
    "end": 146.3,
    "text": "就直接可以按下Ctrl加Io"
  },
  {
    "start": 146.3,
    "end": 150.3,
    "text": "然后觉得弹出的可选择的列表当中"
  },
  {
    "start": 150.3,
    "end": 154.4,
    "text": "去选中我想要恢复的布局就可以了"
  },
  {
    "start": 154.4,
    "end": 156.5,
    "text": "如果你在你的知识库当中"
  },
  {
    "start": 156.5,
    "end": 159.4,
    "text": "左边蓝没有这个插件的图标的话"
  },
  {
    "start": 159.4,
    "end": 161.4,
    "text": "我们可以进入到"
  },
  {
    "start": 161.4,
    "end": 164.9,
    "text": "拼号设置的Cole Plugins当中"
  },
  {
    "start": 164.9,
    "end": 167.5,
    "text": "在它内置的插件"
  },
  {
    "start": 167.5,
    "end": 171.6,
    "text": "最后就有一个叫做Work Places的插件"
  },
  {
    "start": 171.6,
    "end": 173.2,
    "text": "我们只要把它开启"
  },
  {
    "start": 173.2,
    "end": 175.2,
    "text": "在左边蓝就可以出现"
  },
  {
    "start": 175.2,
    "end": 177.8,
    "text": "我们这次使用的插件的图标了"
  },
  {
    "start": 177.8,
    "end": 178.4,
    "text": "好了"
  },
  {
    "start": 178.4,
    "end": 179.8,
    "text": "这次就分享到这里"
  },
  {
    "start": 179.8,
    "end": 181.2,
    "text": "我们下次见"
  }
]