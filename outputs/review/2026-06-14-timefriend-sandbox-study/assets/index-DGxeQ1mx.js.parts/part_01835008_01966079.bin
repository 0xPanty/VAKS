Task:"关联任务",doubleClickEdit:"双击编辑记录",imageAlt:"图片 {index}",noRecords:"暂无记录",noTag:"无标签"},calendar:{year:"{year}年",prevYear:"上一年",nextYear:"下一年",oldestYear:"已经是最早的年份",latestYear:"已经是最新的年份",close:"关闭",records:"{count}条",activeDays:"{count}天",weekdays:["一","二","三","四","五","六","日"],futureTooltip:"{date}: 未来日期",recordsTooltip:"{date}: {count}条记录"},tagCloud:{title:"标签词云 ({count}个标签)",noData:"暂无标签数据"},chart:{tagCountTimes:"{count}次"},save:{success:"成功保存 {count} 条记录！",successWithImages:"成功保存 {count} 条记录，包含 {images} 张图片！",failed:"保存失败，请重试",timeout:"请求超时：记录内容过长，服务器处理超时。请精简内容或分成多条记录。",tooLarge:"请求体过大：单次提交的数据量超过限制。请减少内容或分批保存。",validationFailed:"数据验证失败：请检查输入内容格式。",timeConflict:"该时间段已经录入，请不要重复录入",cannotSave:"无法保存",failedWithCode:"保存失败（错误代码 {code}）：{msg}",networkTimeout:"请求超时：网络响应缓慢或记录内容过长。请检查网络连接或精简内容。",failedWithMsg:"保存失败：{msg}",unknownError:"未知错误"},duration:{minutes:"{n}分钟",hours:"{n}小时",hoursMinutes:"{h}小时{m}分钟"},dateLabel:{today:"今日",yesterday:"昨天",recordedToToday:"记录到今天 ({date})",recordedToYesterday:"记录到昨天 ({date})",recordedTo:"记录到 {date}"},edit:{invalidDate:"日期格式无效",endAfterStart:"结束时间必须晚于开始时间",autoLearnTags:"自动学习新标签: {tags}",updateSuccessWithTags:"记录更新成功，并学习了 {count} 个新标签！",updateSuccess:"记录更新成功！",deleteConfirm:`确定要删除这条记录吗？

